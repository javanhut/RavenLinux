#!/bin/sh
# /etc/raven/first-boot-setup
# First boot user setup for RavenLinux
#
# This script runs on first boot to:
# - Allow changing the default root password
# - Create new user accounts with sudo access
# - Add users to appropriate groups

FIRST_BOOT_FLAG="/etc/.raven-first-boot-done"

# Only run if first boot flag doesn't exist
if [ -f "$FIRST_BOOT_FLAG" ]; then
    exit 0
fi

# Colors for output.
#
# The escape has to be a real ESC byte, not the three characters \ 0 3 3.
# This script is #!/bin/sh, /bin/sh is bash, and bash's echo does not expand
# backslash escapes without -e -- so with '\033[0;34m' in single quotes the
# very first screen a new RavenLinux user ever sees printed
#
#     \033[0;34m========================================
#
# literally, banner and all. printf expands the escape once, here, and every
# echo below then carries a real control sequence.
#
# $'...' would do the same but is a bashism, and this script says sh.
ESC=$(printf '\033')
RED="${ESC}[0;31m"
GREEN="${ESC}[0;32m"
YELLOW="${ESC}[1;33m"
BLUE="${ESC}[0;34m"
NC="${ESC}[0m"

clear
echo ""
echo "${BLUE}========================================"
echo "  RavenLinux First Boot Setup"
echo "========================================${NC}"
echo ""
echo "Welcome to RavenLinux!"
echo ""
echo "${YELLOW}Default credentials:${NC}"
echo "  Username: ${GREEN}root${NC}"
echo "  Password: ${GREEN}raven${NC}"
echo ""
echo "For security, you should change the root password."
echo ""

# Ask to change root password
printf "Change root password now? [Y/n]: "
read -r change_root
case "$change_root" in
    [Nn]*)
        echo "${YELLOW}Keeping default root password.${NC}"
        echo "You can change it later with: passwd root"
        ;;
    *)
        echo ""
        echo "Enter new password for root:"
        if passwd root; then
            echo "${GREEN}Root password changed successfully.${NC}"
        else
            echo "${RED}Failed to change root password.${NC}"
        fi
        ;;
esac

echo ""

# Ask to create a new user
printf "Create a new user account? [y/N]: "
read -r create_user
case "$create_user" in
    [Yy]*)
        printf "Enter username: "
        read -r new_username

        if [ -z "$new_username" ]; then
            echo "${RED}No username provided, skipping user creation.${NC}"
        elif id "$new_username" >/dev/null 2>&1; then
            echo "${RED}User '$new_username' already exists.${NC}"
        else
            # Default shell: ravenshell, matching what raven-install gives the
            # account it creates and what /etc/shells calls the default. This
            # used to prefer bash, so which shell you got depended on whether
            # your account came from the installer or from this script.
            default_shell="/bin/sh"
            for candidate in /usr/bin/ravenshell /bin/ravenshell /bin/bash; do
                if [ -x "$candidate" ]; then
                    default_shell="$candidate"
                    break
                fi
            done

            # Groups a desktop session needs to reach hardware, matching
            # grant_sudo in raven-install. `render` is the one that matters and
            # was missing: udev gives /dev/dri/renderD* to that group at 0660,
            # so without it no GPU-accelerated Wayland client can open the node.
            #
            # useradd -G fails outright on a group that does not exist, and it
            # is added here one at a time after the account exists so a missing
            # group costs that group rather than the whole user. The stderr
            # redirect is gone with it: it hid the reason useradd failed and
            # left only "Failed to create user", which is the message you least
            # want to debug on first boot.
            if useradd -m -s "$default_shell" "$new_username"; then
                for grp in wheel audio video input render seat; do
                    getent group "$grp" >/dev/null 2>&1 || continue
                    usermod -aG "$grp" "$new_username" 2>/dev/null || true
                done
                echo "${GREEN}User '$new_username' created.${NC}"
                echo ""
                echo "Set password for $new_username:"
                if passwd "$new_username"; then
                    echo ""
                    echo "${GREEN}User '$new_username' created successfully!${NC}"
                    echo "  - Home directory: /home/$new_username"
                    echo "  - Shell: $default_shell"
                    echo "  - Groups: wheel, audio, video, input, render, seat"
                    echo "  - This user can use ${BLUE}sudo${NC} to run commands as root."
                else
                    echo "${RED}Failed to set password for '$new_username'.${NC}"
                fi
            else
                echo "${RED}Failed to create user '$new_username'.${NC}"
            fi
        fi
        ;;
    *)
        echo "Skipping user creation."
        ;;
esac

# Create flag file to prevent running again
touch "$FIRST_BOOT_FLAG"

echo ""
echo "${BLUE}========================================"
echo "  First boot setup complete!"
echo "========================================${NC}"
echo ""
echo "You can always:"
echo "  - Change passwords with: ${GREEN}passwd [username]${NC}"
echo "  - Create users with:     ${GREEN}useradd -m -G wheel [username]${NC}"
echo "  - Modify groups with:    ${GREEN}usermod -aG [group] [username]${NC}"
echo ""
echo "Press Enter to continue..."
read -r _
