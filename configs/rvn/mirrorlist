#
# /etc/pacman.d/mirrorlist -- package mirrors for rvn
#
# One entry, and deliberately so. This is a geo-routed CDN run by the Arch
# project itself, which resolves to something close to the machine wherever it
# boots. A ranked list of specific country mirrors is the right thing on a
# machine that stays put, and the wrong thing to bake into an image that gets
# installed somewhere else -- the top entries would be the fastest mirrors for
# the build host and nobody else.
#
# Replace or extend this on an installed system; rvn re-reads it every run.
#
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
