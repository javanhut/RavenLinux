#!/bin/bash
# =============================================================================
# raven-install -- install RavenLinux from the live image onto a disk
# =============================================================================
#
# Ships in the sysroot at /usr/sbin/raven-install, so it is present both on the
# live ISO and on an installed system.
#
# What it does, in order:
#
#   1. preflight   -- root, UEFI, required tools, a usable source tree
#   2. wizard      -- disk, hostname, users, passwords, timezone, locale, swap
#   3. confirm     -- prints the plan, requires a typed YES
#   4. partition   -- GPT: ESP + optional swap + root, via sfdisk; on btrfs
#                     the root is then divided into subvolumes (see
#                     BTRFS_SUBVOLS)
#   5. copy        -- the squashfs (preferred) or the running root, onto the disk
#   6. configure   -- fstab, users, hostname, timezone, locale, init handoff
#   7. bootloader  -- RavenBoot on the ESP, at both \EFI\raven and the fallback
#
# Steps 2 and 3 are the only ones that need a person. Everything else is the
# engine, and the engine is reachable without a terminal: --probe reports what
# a front-end needs to ask about, --answers supplies the answers a wizard would
# have collected, and --progress-fd streams the same status lines this prints
# as one record per line. raven-installer-ui (installer-ui/ in the source tree)
# is a front-end built on exactly those three options -- it does not partition,
# copy or configure anything itself, so there is one implementation of the
# disk-destroying half and two ways to drive it. See PROTOCOL below.
#
# The bootloader is installed to \EFI\BOOT\BOOTX64.EFI as well as
# \EFI\raven\raven-boot.efi. The fallback path is what makes this boot on
# firmware that will not take an NVRAM entry from us -- which is most laptop
# firmware, ASUS included. --efi-nvram additionally registers a named entry.
#
# Secure Boot is off by default because RavenBoot ships unsigned, and no
# signature Microsoft has heard of can be put on it. --secure-boot is the way
# out of that: it signs RavenBoot, the kernel and the fallback loader with a
# key set belonging to this machine, and -- only when the firmware is in setup
# mode, and only when asked -- enrols that key set as the machine's own
# Platform Key. See docs/secure-boot.md, and read it before using it: every
# step here is reversible, and the ways to make an unbootable machine out of
# them all involve doing half of one.
#
# This is deliberately a shell script rather than a compiled binary. It shells
# out to sfdisk/mkfs/blkid for everything that matters anyway, and being a
# script means it can be read and patched on the live system, over SSH, on the
# machine that is refusing to install -- which is exactly when you need to.

set -uo pipefail

# =============================================================================
# Constants
# =============================================================================

RAVEN_INSTALL_VERSION="1.0"

# The wire format --probe and --progress-fd speak. Bumped when a record changes
# meaning; a front-end that reads a version it does not know should refuse to
# drive the installer rather than guess.
RAVEN_INSTALL_PROTOCOL="1"

# Where the firmware's variables are. A constant rather than a literal for the
# same reason every other path here is one: the Secure Boot state read from it
# decides whether this installer offers to write a Platform Key, and a check
# that can only be exercised on the machine it is running on is a check nobody
# exercises. The tests point it at a directory of fixtures.
EFIVARS_DIR="/sys/firmware/efi/efivars"

ESP_SIZE_DEFAULT="512M"
ESP_LABEL="RAVEN_ESP"      # FAT labels are capped at 11 characters
ROOT_LABEL="RAVEN_ROOT"
SWAP_LABEL="RAVEN_SWAP"
HOME_LABEL="RAVEN_HOME"

# The device-mapper names the LUKS containers are opened under, here and in the
# initramfs. They are a hard-coded pair rather than anything derived, because
# they have to be agreed on by two programs that never meet: this installer
# writes them into the kernel command line as `cryptdevice=UUID=...:ravenroot`,
# and the initramfs opens the container under exactly that name and then mounts
# /dev/mapper/ravenroot. Deriving them from the hostname or the disk would put
# a second thing in the boot path that can disagree with itself, and the
# failure is an unbootable machine with a correct-looking boot.cfg.
CRYPT_ROOT_NAME="ravenroot"
CRYPT_SWAP_NAME="ravenswap"

# The btrfs subvolume layout, used when --fs btrfs is chosen. Each entry is
# <subvolume>:<mountpoint>; @ is the root and the rest are mounted inside it.
#
# WHAT THIS LIST IS ACTUALLY DECIDING, because it is the part everybody gets
# wrong: a btrfs snapshot stops at a subvolume boundary. Snapshotting @ copies
# every file that lives in @ and does not descend into a subvolume mounted
# inside it. So the question "which directories are subvolumes" is the same
# question as "what does a rollback rewind", and it is answered here, once, at
# install time -- not later by whichever snapshot tool someone installs, which
# by then can only work with the layout it finds.
#
# @ and @home need no argument. The other three are the ones that do:
#
#   @log (/var/log) -- a rollback happens because something went wrong, and
#     the log of what went wrong is the first thing anybody wants afterwards.
#     If /var/log were inside @, rolling back would restore the log to how it
#     looked before the problem, which destroys the evidence at precisely the
#     moment it is needed. It also stops every snapshot pinning a copy of the
#     logs that were current when it was taken -- on a machine keeping a week
#     of them, that is the largest single thing in the pool and it is a week
#     of duplicated text.
#
#   @cache (/var/cache) -- rvn's download directory, and reconstructible by
#     definition: every file in it came off a mirror and can come off it
#     again. A rollback that rewound it would throw away downloads that are
#     still perfectly good, and a snapshot that included it would store a
#     second copy of packages that are already installed. Neither costs
#     correctness; both cost gigabytes.
#
#   @snapshots (/.snapshots) -- where the snapshots themselves live, and this
#     one is a requirement rather than an economy. A snapshot directory inside
#     @ would mean every snapshot contained all the earlier ones, growing
#     quadratically, and the first rollback would restore a @ whose
#     /.snapshots is a stale copy of the snapshot index -- so the tool that
#     took the snapshots would come back to a view of its own storage that
#     disagrees with what is on the disk.
#
# /var/tmp is deliberately NOT a subvolume here. It is on the root filesystem
# on purpose (see the /tmp note in write_fstab for why), it is small, and a
# rollback rewinding it is harmless -- nothing is supposed to survive in it
# across the reboot a rollback implies anyway.
BTRFS_SUBVOLS=(
    "@:/"
    "@home:/home"
    "@snapshots:/.snapshots"
    "@log:/var/log"
    "@cache:/var/cache"
)

# What each of those is for, in one clause, for the plan confirm() prints
# before anybody types YES.
#
# Kept as a second array rather than a third colon-separated field in the one
# above, because that table is parsed by two functions and this is read only
# by a person -- and because the reason a directory is a subvolume is exactly
# the thing that gets lost when it becomes a flag in a data structure. If a
# subvolume is added above and not described here the plan simply prints its
# name, which is the failure that does the least harm.
declare -A BTRFS_SUBVOL_NOTES=(
    ["@"]="the system; this is what a rollback replaces"
    ["@home"]="your files; snapshotted on their own, not with the system"
    ["@snapshots"]="where the snapshots themselves are kept"
    ["@log"]="NOT rolled back, so the logs that say why survive it"
    ["@cache"]="NOT rolled back, so the package cache survives it"
)

# Where we do our work. Under /run so it is a tmpfs and never lands on disk.
WORK="/run/raven-install"
TARGET="${WORK}/target"
SRCMNT="${WORK}/source"
# The top-level subvolume of a new btrfs root, mounted just long enough to
# create the subvolumes above on it. It is named here rather than inside
# create_btrfs_layout() because cleanup() has to be able to unmount it after a
# failure: a btrfs filesystem still mounted here keeps its LUKS container busy,
# and close_crypt_devices() cannot close a busy container.
BTRFS_TOP="${WORK}/btrfs-top"

# =============================================================================
# Output
# =============================================================================

if [[ -t 1 ]]; then
    RED=$'\033[1;31m'; GREEN=$'\033[1;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[1;34m'; WHITE=$'\033[1;37m'; CYAN=$'\033[1;36m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; WHITE=""; CYAN=""; NC=""
fi

# -----------------------------------------------------------------------------
# The progress stream
# -----------------------------------------------------------------------------
# PROTOCOL, version ${RAVEN_INSTALL_PROTOCOL}
#
# With --progress-fd N every status line below is written a second time to file
# descriptor N, as one record per line: a verb, a space, and the rest of the
# line. No colour, no escapes, no continuation lines.
#
#   phase <id> <text>   a phase started; <id> is one of the ids in main()
#   ok    <text>        a thing succeeded
#   warn  <text>        a thing is wrong but not fatal
#   fail  <text>        a thing failed; a `done` with a non-zero code follows
#   info  <text>        neither, just news
#   pct   <id> <0-100>  progress *within* phase <id>
#   dirty <0|1>         whether the target disk has been written to yet
#   done  <exit-code>   the last record, always written, exactly once
#
# One `info` record is a fixed string rather than prose, and is the only one:
#
#   info  secure-boot: <none|skipped|signed|enrolled|failed>
#
# written once by setup_secure_boot(), at the end of that phase. It is here
# because a front-end's closing page has to choose between telling somebody to
# turn Secure Boot ON and telling them to leave it off, and that choice has to
# come from what happened rather than from what was asked for: getting it from
# the answer means a machine whose enrolment failed is told to switch on a
# check it cannot pass, and the place that fails has no error message. It rides
# on `info` rather than on a verb of its own so that a front-end written
# against protocol 1 keeps working -- an unknown verb is a record dropped, an
# unrecognised info line is a line shown.
#
# The verbs are a summary, deliberately. The full human log still goes to
# stdout, escapes stripped when stdout is not a terminal, and a front-end is
# expected to show that as the detail behind these records rather than to
# reconstruct it from them -- which is what keeps the two in parity when a
# message here grows a second explanatory line.
PROGRESS_FD=""
PHASE=""

emit() {
    [[ -n "$PROGRESS_FD" ]] || return 0
    # Never let a closed or broken progress pipe take the install down: the
    # front-end may have died, and a half-partitioned disk is a far worse
    # outcome than an unwatched install that finishes.
    printf '%s %s\n' "$1" "${2-}" >&"$PROGRESS_FD" 2>/dev/null || true
}

ok()   { echo "  [  ${GREEN}OK${NC}  ] $*"; emit ok "$*"; }
warn() { echo "  [${YELLOW}WARN${NC} ] $*"; emit warn "$*"; }
fail() { echo "  [${RED}FAIL${NC} ] $*"; emit fail "$*"; }
info() { echo "  [ ${BLUE}**${NC}  ] $*"; emit info "$*"; }
step() { echo; echo "${WHITE}>>>${NC} $*"; emit step "$*"; }

# A step that also names the phase it opens. Everything main() calls uses this
# rather than step(), so a front-end can map progress onto a fixed list of
# phases instead of matching on prose that is free to change.
phase() {
    PHASE="$1"; shift
    echo; echo "${WHITE}>>>${NC} $*"
    emit phase "${PHASE} $*"
}

# Progress inside the current phase, 0-100.
pct() { emit pct "${PHASE} $1"; }

# Print the reason and leave. The EXIT trap owns the "aborted" banner and the
# unmounting, so this must not do either -- doing them here printed the banner
# twice, once with the disk state and once without.
die() {
    echo
    fail "$*"
    exit 1
}

# Every check --probe reports on is written once, as a `die` in the real
# preflight, and read twice. In probe mode nothing is fatal -- a machine with
# no UEFI is a fact the front-end has to *show* someone, and a probe that
# exited on it would have nothing to show them -- so the same call records the
# reason and returns non-zero, and its caller returns instead of exiting.
#
# This is why probe and install cannot disagree about whether a machine is
# installable: they are not two checks with the same intent, they are one call.
PROBE_ERRORS=()

soft_die() {
    if (( OPT_PROBE )); then
        PROBE_ERRORS+=("$*")
        return 1
    fi
    die "$@"
}

banner() {
    cat <<BANNER
${CYAN}
   ██████╗  █████╗ ██╗   ██╗███████╗███╗   ██╗
   ██╔══██╗██╔══██╗██║   ██║██╔════╝████╗  ██║
   ██████╔╝███████║██║   ██║█████╗  ██╔██╗ ██║
   ██╔══██╗██╔══██║╚██╗ ██╔╝██╔══╝  ██║╚██╗██║
   ██║  ██║██║  ██║ ╚████╔╝ ███████╗██║ ╚████║
   ╚═╝  ╚═╝╚═╝  ╚═╝  ╚═══╝  ╚══════╝╚═╝  ╚═══╝${NC}
   ${WHITE}Installer${NC} v${RAVEN_INSTALL_VERSION}

BANNER
}

# =============================================================================
# Options
# =============================================================================

OPT_DISK=""
# wipe: erase the disk and lay out a fresh GPT. alongside: keep what is on it,
# take space from one partition or from a hole already there, and reuse the ESP
# the other OS boots from. wipe stays the default -- it is what an installer
# does when nobody says otherwise, and it is the one that cannot be asked to
# resize a filesystem it did not create.
OPT_MODE="wipe"
# manual: the person has laid the disk out themselves -- which partitions to
# delete, which to create where, and which existing ones to use for what. See
# "Manual partitioning" below for the three lists and what each entry means.
OPT_MANUAL_DELETE=""
OPT_MANUAL_NEW=""
OPT_MANUAL_USE=""
OPT_SHRINK_PART=""     # which partition alongside mode takes space from
OPT_ALONGSIDE_SIZE=""  # how much to take, or empty for "about half of what is free"
OPT_FS="ext4"
OPT_ENCRYPT=0        # --encrypt; the answers file's `encrypt` key feeds the same variable
OPT_SWAP=""          # "", "none", or a size like 8G
OPT_ESP_SIZE="${ESP_SIZE_DEFAULT}"
OPT_NVRAM=0
NVRAM_DECLINED=0     # 1 when an answers file said efi_nvram=0 outright
OPT_DRY_RUN=0
OPT_YES=0
OPT_PROFILE=""
# Optional applications to install, comma-separated ids from OPTIONAL_DIR. The
# flag says whether anything answered the question, so an interactive run asks
# only when neither --optional nor the answers file did -- and "" is then an
# answer ("none of them"), not a question left open.
OPT_OPTIONAL=""
OPT_OPTIONAL_SET=0
OPT_POSTINSTALL=""   # now | later | auto; empty until the answers file or the default fills it
OPT_ANSWERS=""
OPT_NONINTERACTIVE=0
OPT_PROBE=0
# skip | sign | enroll. See setup_secure_boot() for what each one does and for
# the argument that they are three choices rather than a switch: "sign" is
# entirely reversible and changes nothing about how the machine boots today,
# "enroll" is the step that hands the firmware a new Platform Key, and keeping
# them apart is what lets somebody sign now, confirm the machine still boots,
# and enrol afterwards from the installed system with one command.
OPT_SECUREBOOT="skip"

usage() {
    cat <<USAGE
Usage: raven-install [options]

Installs RavenLinux onto a disk. Interactive by default; the options below
pre-answer individual questions rather than replacing the wizard.

Options:
  --disk DEVICE      Target disk (e.g. /dev/nvme0n1). Prompted for if omitted.
  --alongside        Keep what is on the disk. RavenLinux goes into free space,
                     or into space taken from a partition named with --shrink,
                     and boots from the EFI System Partition that is already
                     there. Nothing else on the disk is formatted or moved.
  --shrink PART      The partition --alongside takes space from (e.g.
                     /dev/nvme0n1p3). Its filesystem is shrunk first, then its
                     partition; ext2/3/4 and NTFS only, and it must not be
                     mounted. Omit it to use unallocated space that is already
                     on the disk.
  --size SIZE        How much space to give RavenLinux, e.g. 120G. With
                     --shrink and no --size, about half of what the partition
                     can spare.
  --manual           Lay the disk out yourself, with the three options below.
                     Nothing is erased that you did not name, and nothing is
                     written until the plan has been checked and confirmed.
  --delete LIST      Manual: partitions to delete, comma-separated.
  --new LIST         Manual: partitions to create, ';'-separated, each
                     START:SECTORS:ROLE in the disk's own sectors (see
                     --probe's disk.sector_size). ROLE is root, home, swap or
                     esp. Every one must sit in free space, after --delete.
  --use LIST         Manual: existing partitions to use, ';'-separated, each
                     PART:ROLE:ACTION. ACTION is keep or format; root is
                     always formatted, and keep is for an ESP (shared with
                     another OS), a /home whose data should survive, or a swap.
  --wipe             Erase the disk. The default, so this is only worth typing
                     to say so out loud in a script.
  --fs TYPE          Root filesystem: ext4 (default) or xfs or btrfs, if the
                     matching mkfs is present. btrfs additionally lays out
                     subvolumes -- @ as the root, @home, @snapshots, and
                     @log and @cache kept outside the snapshots so a
                     rollback does not rewind /var/log or the package
                     cache -- and needs the btrfs binary as well as
                     mkfs.btrfs. ext4 stays the default: it has no
                     snapshots, and it also has no copy-on-write
                     fragmentation, no balance to think about and thirty
                     years of recovery tools.
  --swap SIZE        Swap partition size (e.g. 8G), or "none" for no swap.
  --encrypt          Encrypt the disk: LUKS2 with argon2id over the root
                     partition, and over the swap partition as well, both
                     opened by one passphrase typed at every boot. Off by
                     default. The passphrase is asked for by the wizard or
                     given as the answers file's encrypt_password; there is
                     deliberately no option to pass it on the command line,
                     where it would be visible in ps(1) to everyone on the
                     machine. Nothing recovers a forgotten passphrase.
  --esp-size SIZE    EFI System Partition size. Default ${ESP_SIZE_DEFAULT}.
  --efi-nvram        Also register a "RavenLinux" UEFI NVRAM boot entry with
                     efibootmgr. Off by default when the disk is erased (the
                     fallback path boots without it); on by default next to
                     another OS -- on the same disk or another one -- whose own
                     entry would otherwise keep booting first.
  --secure-boot MODE What to do about Secure Boot. "skip" (the default) leaves
                     the firmware exactly as it is; the machine boots with
                     Secure Boot off, which is what RavenBoot needs today.
                     "sign" creates a key set for this machine with sbctl and
                     signs RavenBoot, the fallback loader and the kernel with
                     it -- a signature an EFI binary carries is ignored by
                     firmware that is not checking, so this changes nothing
                     about the next boot and can be undone by deleting the
                     keys. "enroll" does all of that and then, ONLY if the
                     firmware is in setup mode, enrols the key set as the
                     Platform Key alongside Microsoft's certificates, so that
                     Secure Boot can be switched on in the firmware afterwards
                     and this machine still boots -- and so does Windows, and
                     so do the option ROMs on the cards in it. Enrolment is
                     refused outright unless the firmware is in setup mode,
                     because that is the only state in which it does not need
                     the firmware's permission. See docs/secure-boot.md.
  --profile NAME     Post-install package template: minimal (default), desktop,
                     or developer.
  --optional LIST    Optional applications to install, comma-separated (e.g.
                     tutorial,oracle), or "none". They ride on the install
                     media but are not part of the system; only the ones named
                     here are copied onto the disk. --probe lists them.
  --postinstall MODE When the profile's packages are installed. "now" runs
                     raven-postinstall inside the new system before the
                     installer finishes, over the live session's network;
                     "later" leaves it to the postinstall service, which runs
                     at first boot once there is a network; "auto" (the
                     default) does it now when the live session has a network
                     and asks first when the wizard is interactive.
  --dry-run          Run every check and print the plan, then stop before the
                     first write. Nothing is partitioned, formatted, or copied.
  -y, --yes          Skip the final typed confirmation. THIS DESTROYS THE DISK
                     WITH NO FURTHER PROMPT.
  -h, --help         This message.

Driving it from a front-end (see PROTOCOL near the top of this file):

  --probe            Report what a front-end needs in order to ask the
                     questions this wizard asks -- the preflight results, the
                     disks and what is on them, the source tree it found, the
                     timezones, the profiles -- as key=value lines on stdout,
                     and exit. Nothing is written and nothing is fatal: a
                     failed check is reported as a value, not an exit code.
  --answers FILE     Read the wizard's answers from FILE instead of asking.
                     One key=value per line, '#' comments, no quoting and no
                     substitution -- the value is the rest of the line, so a
                     password may contain anything but a newline. Keys are the
                     ones --probe names in answers.key. FILE holds passwords in
                     the clear, so put it on a tmpfs at mode 0600 and unlink it
                     afterwards; the installer refuses one that is readable by
                     anyone else.
  --non-interactive  Never read stdin. Requires --answers, implies --yes, and
                     turns a missing or invalid answer into an error instead of
                     a prompt. The final "reboot now?" is skipped.
  --progress-fd N    Also write each status line to file descriptor N, as the
                     one-record-per-line protocol documented above.

The target disk is erased completely unless --alongside is given, in which case
only the space this takes is written to and every other partition is left
exactly as it was. RavenBoot finds the other OS on the shared ESP by itself and
puts it in the boot menu; there is nothing to configure for that.

  raven-install --disk /dev/nvme0n1 --alongside --shrink /dev/nvme0n1p3 --size 120G

Shrinking NTFS needs Windows shut down properly first -- not hibernated, and
not with Fast Startup on, both of which leave the filesystem dirty and make
ntfsresize refuse. "shutdown /s /t 0" from a Windows command prompt does it.
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --disk)      OPT_DISK="${2:-}"; shift 2 ;;
        --alongside) OPT_MODE="alongside"; shift ;;
        --wipe)      OPT_MODE="wipe"; shift ;;
        --manual)    OPT_MODE="manual"; shift ;;
        --delete)    OPT_MANUAL_DELETE="${2:-}"; OPT_MODE="manual"; shift 2 ;;
        --new)       OPT_MANUAL_NEW="${2:-}"; OPT_MODE="manual"; shift 2 ;;
        --use)       OPT_MANUAL_USE="${2:-}"; OPT_MODE="manual"; shift 2 ;;
        --shrink)    OPT_SHRINK_PART="${2:-}"; OPT_MODE="alongside"; shift 2 ;;
        --size)      OPT_ALONGSIDE_SIZE="${2:-}"; shift 2 ;;
        --fs)        OPT_FS="${2:-}"; shift 2 ;;
        --swap)      OPT_SWAP="${2:-}"; shift 2 ;;
        --encrypt)   OPT_ENCRYPT=1; shift ;;
        --esp-size)  OPT_ESP_SIZE="${2:-}"; shift 2 ;;
        --efi-nvram) OPT_NVRAM=1; shift ;;
        --secure-boot) OPT_SECUREBOOT="${2:-}"; shift 2 ;;
        --profile)   OPT_PROFILE="${2:-}"; shift 2 ;;
        --postinstall) OPT_POSTINSTALL="${2:-}"; shift 2 ;;
        --optional)  OPT_OPTIONAL="${2:-}"; OPT_OPTIONAL_SET=1; shift 2 ;;
        --dry-run)   OPT_DRY_RUN=1; shift ;;
        -y|--yes)    OPT_YES=1; shift ;;
        --answers)   OPT_ANSWERS="${2:-}"; shift 2 ;;
        --non-interactive) OPT_NONINTERACTIVE=1; OPT_YES=1; shift ;;
        --progress-fd) PROGRESS_FD="${2:-}"; shift 2 ;;
        --probe)     OPT_PROBE=1; shift ;;
        -h|--help)   usage; exit 0 ;;
        *)           echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -n "$PROGRESS_FD" ]]; then
    [[ "$PROGRESS_FD" =~ ^[0-9]+$ ]] || { echo "--progress-fd takes a number" >&2; exit 2; }
    # Written to before the trap that would report the failure is installed, so
    # a bad descriptor is caught here rather than silently swallowed by emit's
    # own error suppression for the whole run.
    # In a subshell: a bad redirection is reported by the shell itself, before
    # the command's own 2>/dev/null can catch it, so the test has to happen
    # somewhere whose stderr is already redirected.
    if ! ( : >&"$PROGRESS_FD" ) 2>/dev/null; then
        echo "--progress-fd ${PROGRESS_FD} is not open for writing" >&2
        exit 2
    fi
fi

if (( OPT_NONINTERACTIVE )) && [[ -z "$OPT_ANSWERS" ]]; then
    echo "--non-interactive requires --answers FILE" >&2
    exit 2
fi

# Checked here rather than at the point of use, because the point of use is
# after the disk has been erased. A misspelt mode is a typo in a script, and
# the two ways of getting it wrong that matter are "enrol" for "enroll" and
# "none" for "skip" -- both of which would otherwise fall through to whatever
# the case statement's default happened to be.
case "$OPT_SECUREBOOT" in
    skip|sign|enroll) ;;
    *) echo "--secure-boot takes skip, sign or enroll, not '${OPT_SECUREBOOT}'" >&2; exit 2 ;;
esac

# =============================================================================
# Cleanup
# =============================================================================

# Set once the installer has started writing to the disk, so a failure after
# that point can say so rather than implying the disk is untouched.
DISK_DIRTY=0

# "1" when the firmware reports Secure Boot on, "" when off or unreadable.
SECUREBOOT_STATE=""
# "1" when the firmware reports itself in setup mode -- no Platform Key is
# enrolled, so anything may write one without the firmware's permission. This
# is the only state in which raven-install will enrol keys, and it is a
# separate fact from SECUREBOOT_STATE: a machine can be out of setup mode with
# Secure Boot switched off (keys enrolled, enforcement disabled), which looks
# identical from Linux until you try to write PK and the firmware refuses.
SECUREBOOT_SETUP=""
# Set by setup_secure_boot() so finish() can say what actually happened rather
# than what was asked for: "" nothing was attempted, "signed", "enrolled", or
# "failed".
SECUREBOOT_RESULT=""

cleanup() {
    # Unmount in reverse depth order so nested mounts come off first.
    for m in "${TARGET}/boot/efi" "${TARGET}/dev" "${TARGET}/proc" "${TARGET}/sys" \
             "${TARGET}" "${BTRFS_TOP}" "${SRCMNT}"; do
        mountpoint -q "$m" 2>/dev/null && umount -R "$m" 2>/dev/null
    done
    # After the unmounts, because a container with a mounted filesystem on it
    # will not close. An install that failed part way through leaves the
    # target's LUKS containers open otherwise, and the next run's luksFormat
    # then fails on a busy device -- having already written a new header over
    # the old one.
    close_crypt_devices
    return 0
}

on_error() {
    local rc=$?
    [[ $rc -eq 0 ]] && return 0
    echo
    fail "Installation aborted."
    emit dirty "$DISK_DIRTY"
    emit done "$rc"
    if [[ $DISK_DIRTY -eq 1 && "$OPT_MODE" == "manual" ]]; then
        echo "  ${YELLOW}The disk has been modified: RavenLinux is not installed.${NC}"
        echo "  Only the partitions named in the plan were deleted, created or"
        echo "  formatted; every other one was left as it was. Re-run raven-install."
    elif [[ $DISK_DIRTY -eq 1 && "$OPT_MODE" == "alongside" ]]; then
        echo "  ${YELLOW}The disk has been modified: RavenLinux is not installed.${NC}"
        echo "  The other operating system on this disk was not formatted and"
        echo "  should still boot. Re-run raven-install to try again."
    elif [[ $DISK_DIRTY -eq 1 ]]; then
        echo "  ${YELLOW}The target disk has already been modified and is not bootable.${NC}"
        echo "  Re-run raven-install to start over."
    else
        echo "  No changes were made to any disk."
    fi
    cleanup
    exit $rc
}
trap on_error EXIT
trap 'die "Interrupted."' INT TERM

# =============================================================================
# Preflight
# =============================================================================

have() { command -v "$1" >/dev/null 2>&1; }

# Where the compressed archive inside an initramfs image actually starts.
#
# It is not always byte zero, and assuming it was is what made every install
# warn that a perfectly good image could not boot from a disk. build-initramfs.sh's
# prepend_microcode() concatenates an *uncompressed* newc cpio carrying the CPU
# microcode in front of the compressed image, because that is the only way the
# kernel's early microcode loader can be fed: it reads the head of the initrd
# before anything is decompressed. So an image built since that change begins
# with the cpio magic 070701 and the zstd frame begins some tens of kilobytes
# in, and anything that dispatches on the first four bytes sees a cpio, falls
# through to plain cat, and never looks inside the compressed part at all.
#
# This walks the leading archive member by member -- newc's header is 110 ASCII
# characters, of which the two that matter here are the file size at offset 54
# and the name size at offset 94, both eight hex digits -- and returns the
# offset of whatever follows it. Every field is validated because this parses a
# file the installer was handed rather than one it wrote, and every way of
# failing prints 0, which puts the caller back on exactly the behaviour it had
# before this function existed: read the file whole and let the magic decide.
#
# 0 is also the right answer, and the fast one, for the two images that have no
# leading cpio at all -- one built before the microcode change, and one from
# another distribution -- because the very first header read does not match and
# the walk stops there.
initrd_payload_offset() {
    local img="$1"
    local size off=0 hdr name namesize filesize chunk zeros member=0

    size="$(stat -c%s "$img" 2>/dev/null)"
    [[ "$size" =~ ^[0-9]+$ ]] || { printf '0\n'; return 0; }

    # A microcode archive has six members (three directories, two blobs and the
    # trailer), so a bound of 64 is generous for the thing this is here to skip
    # and still refuses to walk a whole uncompressed initramfs one head(1) at a
    # time. Hitting the bound is not an error, it just means "not a short
    # prefix", which is answered with 0 like every other unexpected shape.
    while (( member < 64 )); do
        member=$(( member + 1 ))
        hdr="$(head -c $(( off + 110 )) "$img" 2>/dev/null | tail -c 110 | tr -d '\0')"
        # The magic is checked before the length because at the end of the walk
        # this read lands on the compressed payload, whose bytes are binary: the
        # tr and the command substitution together eat NULs and trailing
        # newlines out of it, so its length means nothing there and only the
        # magic can be trusted. (The tr is also what keeps bash from printing
        # "ignored null byte in input" to the installer's stderr on that last
        # read; a real 110-byte newc header is ASCII and passes through it
        # unchanged.)
        [[ "${hdr:0:6}" == "070701" ]] || { printf '%s\n' "$off"; return 0; }
        [[ ${#hdr} -eq 110 ]] || break
        [[ "${hdr:54:8}" =~ ^[0-9a-fA-F]{8}$ ]] || break
        [[ "${hdr:94:8}" =~ ^[0-9a-fA-F]{8}$ ]] || break
        filesize=$(( 16#${hdr:54:8} ))
        namesize=$(( 16#${hdr:94:8} ))
        (( namesize > 1 && namesize <= 4096 )) || break
        # namesize counts the name's terminating NUL, and the read stops one
        # byte short of it so that no NUL ever reaches the command substitution.
        name="$(head -c $(( off + 109 + namesize )) "$img" 2>/dev/null | tail -c $(( namesize - 1 )) | tr -d '\0')"
        # Name and data each start on a four-byte boundary; the kernel's
        # unpacker requires the same of the next archive, which is why the
        # builder checks the microcode archive's size is a multiple of four.
        off=$(( ( off + 110 + namesize + 3 ) / 4 * 4 ))
        off=$(( ( off + filesize + 3 ) / 4 * 4 ))
        (( off > 0 && off < size )) || break
        [[ "$name" == "TRAILER!!!" ]] || continue

        # cpio pads its output to a 512-byte block, so the trailer is followed
        # by NULs that are part of no archive. Read the next block as hex and
        # count the leading zero characters: two per padding byte, and an odd
        # count when the first real byte is itself below 0x10 (0x07, as it
        # happens, when a second cpio archive follows), hence the truncating
        # divide.
        chunk="$(od -An -j "$off" -N512 -tx1 -v "$img" 2>/dev/null | tr -d ' \n')"
        [[ -n "$chunk" ]] || break
        zeros="${chunk%%[!0]*}"
        off=$(( off + ${#zeros} / 2 ))
        (( off < size )) || break
    done

    printf '0\n'
    return 0
}

# The four magic bytes at $2 (default 0) of $1, as lower-case hex.
initrd_payload_magic() {
    local img="$1" off="${2:-0}"
    od -An -j "$off" -N4 -tx1 -v "$img" 2>/dev/null | tr -d ' \n'
}

# The image from its payload offset onwards, for feeding to a decompressor.
initrd_payload_bytes() {
    local img="$1" off="${2:-0}"
    if (( off > 0 )); then
        tail -c "+$(( off + 1 ))" "$img" 2>/dev/null
    else
        cat "$img" 2>/dev/null
    fi
}

# Stream an initramfs decompressed, whichever way it was packed. The image is
# zstd since the build switched from gzip -9; older images are gzip, and xz
# is the other format the kernel is built to read. Decided by the magic
# bytes, not the file name, because the name is initramfs.img either way --
# and by the magic bytes at the payload offset, not at byte zero, because of
# the microcode archive described above. $2 is that offset when the caller has
# already worked it out; otherwise it is worked out here.
initrd_cat() {
    local img="$1" off="${2:-}" magic
    [[ -n "$off" ]] || off="$(initrd_payload_offset "$img")"
    magic="$(initrd_payload_magic "$img" "$off")"
    case "$magic" in
        28b52ffd) have zstd && initrd_payload_bytes "$img" "$off" | zstd -dc 2>/dev/null ;;
        1f8b*)    have zcat && initrd_payload_bytes "$img" "$off" | zcat -f 2>/dev/null ;;
        fd377a58) have xz && initrd_payload_bytes "$img" "$off" | xz -dc 2>/dev/null ;;
        *)        cat "$img" 2>/dev/null ;;
    esac
}

# yes, no, or unknown: whether the initramfs handles root= on the kernel
# command line. "unknown" when the format cannot be read here, so a missing
# tool never turns into a false warning about the image.
initrd_root_support() {
    local img="$1" off magic
    off="$(initrd_payload_offset "$img")"
    magic="$(initrd_payload_magic "$img" "$off")"
    case "$magic" in
        28b52ffd) have zstd || { echo unknown; return; } ;;
        1f8b*)    have zcat || { echo unknown; return; } ;;
        fd377a58) have xz || { echo unknown; return; } ;;
    esac
    # The subshell exists to turn pipefail off for this one pipeline, and it is
    # not cosmetic: grep -q stops at the first match and closes the pipe, the
    # decompressor upstream dies of SIGPIPE, and under the `set -o pipefail` at
    # the top of this file the pipeline then reports 141 -- a failure -- for an
    # image in which grep found exactly what it was looking for. That is a
    # second, independent way this function said "no" about a good image.
    if ( set +o pipefail; initrd_cat "$img" "$off" | grep -aq 'raven_root_from_cmdline' ); then
        echo yes
    else
        echo no
    fi
}

# Can this image encrypt a disk, and what will it cost?
#
# Called from two places for one reason: --encrypt and the answers file are
# known at preflight, but the wizard's own question is asked much later, and
# the answer "cryptsetup is not here" must land before confirm() rather than
# in the middle of format_partitions -- which runs after the disk has been
# repartitioned, where the same discovery is a machine with its old system
# erased and no new one able to start.
# Read one EFI global variable's first data byte, as a decimal number.
#
# An efivarfs file is a 4-byte attribute word followed by the variable's data,
# so the byte that matters is at offset 4. The name is globbed rather than
# spelled out with its GUID because every variable here is an EFI global
# (8be4df61-93ca-11d2-aa0d-00e098032b8c) and a firmware that spells that GUID
# differently in its file names is a firmware whose Secure Boot state we are
# better off reporting as unknown than guessing at.
#
# Prints nothing and returns 1 when the variable does not exist, which is the
# ordinary case on a BIOS machine and on plenty of UEFI firmware that simply
# does not implement Secure Boot. "Unknown" and "off" are told apart because
# only one of them is a machine that could be asked to enrol keys.
efi_global_var_byte() {
    local name="$1" f
    [[ -d "$EFIVARS_DIR" ]] || return 1
    have od || return 1
    # A glob rather than ls|head: ls of a missing pattern prints an error the
    # caller's redirection has to swallow, and the loop below reads the first
    # match and stops without a subshell.
    local byte
    for f in "${EFIVARS_DIR}/${name}"-*; do
        [[ -r "$f" ]] || continue
        byte="$(od -An -tu1 -j4 -N1 "$f" 2>/dev/null | tr -d ' \n')"
        # A file that exists but reads empty -- a firmware bug, or a variable
        # with no data -- is "unknown", not "0". The difference decides whether
        # this installer would offer to write a Platform Key.
        [[ "$byte" =~ ^[0-9]+$ ]] || return 1
        printf '%s\n' "$byte"
        return 0
    done
    return 1
}

# Fill SECUREBOOT_STATE and SECUREBOOT_SETUP from the firmware.
#
# Both are read, and read separately, because the three states they describe
# want three different things said to the person installing:
#
#   SecureBoot=1                 enforcing. RavenBoot will not load. The fix is
#                                in the firmware and nowhere else.
#   SecureBoot=0, SetupMode=1    no Platform Key. Keys can be enrolled from
#                                here, without a firmware password, without a
#                                reboot, and without asking anything's
#                                permission. This is the window --secure-boot
#                                enroll exists for and it is not the default
#                                state of a machine: somebody has cleared the
#                                keys.
#   SecureBoot=0, SetupMode=0    disabled but still owned by its vendor keys.
#                                Signing is possible; enrolling is not, until
#                                the keys are cleared in the firmware.
read_secureboot_state() {
    SECUREBOOT_STATE="$(efi_global_var_byte SecureBoot || true)"
    SECUREBOOT_SETUP="$(efi_global_var_byte SetupMode || true)"
    # A firmware that reports Secure Boot on and setup mode on at the same time
    # is reporting something that cannot be true -- setup mode means no PK, and
    # enforcement without a PK is not a state the specification has. Believe
    # the enforcement bit, because that is the one that decides whether the
    # next boot works, and drop the claim that keys can be written.
    if [[ "$SECUREBOOT_STATE" == "1" && "$SECUREBOOT_SETUP" == "1" ]]; then
        SECUREBOOT_SETUP="0"
    fi
    return 0
}

# Does the INSTALLED system have sbctl? Not the live one -- see
# setup_secure_boot() for why the live image's copy would be the wrong tool
# even when it is present.
secureboot_tool() {
    [[ -n "${TARGET:-}" && -x "${TARGET}/usr/bin/sbctl" ]]
}

# Is it going to? Asked by the wizard, which runs long before the target
# exists, so this is a prediction and it is made from the two things that can
# put sbctl on the new disk: the tree being copied already has it, or the
# package profile names it and the packages are going in during this install
# rather than at first boot.
#
# Prints a word saying which, so the caller can say something true rather than
# "maybe": "image", "profile", or nothing at all.
secureboot_tool_expected() {
    if [[ -n "${SRC_ROOT:-}" && -x "${SRC_ROOT%/}/usr/bin/sbctl" ]]; then
        echo image
        return 0
    fi
    if (( ${POSTINSTALL_NOW:-0} )) && [[ -n "${INSTALL_PROFILE:-}" ]] \
       && profile_names_sbctl "${INSTALL_PROFILE}"; then
        echo profile
        return 0
    fi
    return 1
}

# Does this package profile's list name sbctl? Read from the list rather than
# hardcoded here, so adding sbctl to a profile is one edit in one file.
profile_names_sbctl() {
    local profile="$1" list
    for list in "${SRC_ROOT:+${SRC_ROOT%/}}/etc/raven/install-profiles/${profile}.packages" \
                "/etc/raven/install-profiles/${profile}.packages"; do
        [[ -r "$list" ]] || continue
        # A whole line, so a longer name that merely contains it (sbctl-git)
        # and the comment block above the entry are both not matches.
        grep -qxE '[[:space:]]*sbctl[[:space:]]*' "$list" && return 0
        return 1
    done
    return 1
}

# The preflight report. Split from the reading above so --probe can have the
# facts without the prose, and so the prose is in one place rather than
# repeated in three.
report_secureboot_state() {
    if [[ "$SECUREBOOT_STATE" == "1" ]]; then
        warn "Secure Boot is ENABLED"
        echo "        RavenBoot is unsigned, so the installed system will not boot"
        echo "        until either you disable Secure Boot in the firmware setup, or"
        echo "        you enrol this machine's own keys and sign RavenBoot with them."
        echo
        echo "        To disable it -- the short way, and what everything here assumes:"
        echo "          On ASUS ROG: F2 at power-on, Advanced Mode (F7),"
        echo "          Security > Secure Boot > Secure Boot Control > Disabled."
        echo
        echo "        To keep it on with your own keys -- the long way, and it cannot"
        echo "        be started from Linux because the firmware will not let anything"
        echo "        write a Platform Key while one is already enrolled:"
        echo "          1. In the same Secure Boot menu, find Key Management and"
        echo "             choose 'Clear Secure Boot Keys' (it is sometimes called"
        echo "             'Delete all Secure Boot variables', or 'Erase all secure"
        echo "             boot settings'). That puts the firmware in SETUP MODE."
        echo "          2. Leave Secure Boot itself OFF for now, save and exit."
        echo "          3. Boot this installer again. It will see setup mode and"
        echo "             offer to enrol keys and sign the bootloader."
        echo "          4. Only once the installed system boots, go back in and turn"
        echo "             Secure Boot on."
        echo "        docs/secure-boot.md has the whole of this, including how to put"
        echo "        the vendor's keys back if you change your mind."
    elif [[ "$SECUREBOOT_SETUP" == "1" ]]; then
        ok "Secure Boot is off, and the firmware is in SETUP MODE"
        echo "        No Platform Key is enrolled, so this installer can enrol one"
        echo "        and sign RavenBoot and the kernel with it -- which is what"
        echo "        --secure-boot enroll does. Nothing happens unless you ask."
    elif [[ "$SECUREBOOT_SETUP" == "0" ]]; then
        ok "Secure Boot is off (the firmware still holds its vendor keys)"
    else
        ok "Secure Boot is not reported by this firmware"
    fi
    return 0
}

# One line for the plan confirm() prints. Says what will be done AND what the
# firmware currently is, because those are two different facts and the pairing
# is the whole story: "sign" on a machine whose firmware is enforcing is a
# machine that still will not boot, and somebody reading the plan should be
# able to see that without knowing the rules.
secure_boot_plan_line() {
    local state="off"
    [[ "$SECUREBOOT_STATE" == "1" ]] && state="ON in firmware"
    [[ "$SECUREBOOT_SETUP" == "1" ]] && state="off, firmware in setup mode"
    [[ -z "$SECUREBOOT_STATE" && -z "$SECUREBOOT_SETUP" ]] && state="not reported by this firmware"

    case "$OPT_SECUREBOOT" in
        sign)
            printf 'sign RavenBoot, the fallback loader and the kernel (%s)\n' "$state"
            printf '                   No key is enrolled and nothing about the next boot changes.'
            ;;
        enroll)
            printf 'enrol this machine'"'"'s own keys, and sign with them (%s)\n' "$state"
            printf '                   Microsoft'"'"'s certificates are enrolled too, so Windows and\n'
            printf '                   option ROMs keep working. Undo: sbctl reset, or the\n'
            printf '                   firmware'"'"'s "restore factory keys". Modules are not signed.'
            ;;
        *)
            printf 'not touched (%s)' "$state"
            ;;
    esac
}

check_encryption_support() {
    have cryptsetup || soft_die "cryptsetup is not on this image; the disk cannot be encrypted.
       It comes from the cryptsetup package and would be copied into the
       sysroot by stage2. Rebuild the image, or install without encryption." || return 1
    ok "cryptsetup present ($(cryptsetup --version 2>/dev/null | head -1))"

    # The kernel this image installs is the kernel it is running, so
    # /proc/crypto answers for the installed machine too. AES-NI is a separate
    # Kconfig from the AES the kernel always has, and without it every block
    # read and written on an encrypted root goes through the generic C
    # implementation -- hundreds of MB/s where the accelerated one does
    # several GB/s, which on an NVMe laptop is the difference between
    # encryption being free and being the slowest part of the machine.
    #
    # A warning and not a refusal: the disk is encrypted and correct either
    # way, and someone who wants their laptop encrypted today should not be
    # made to rebuild a kernel first. But it should be said out loud, because
    # the symptom on its own -- "the disk got slow after I reinstalled" --
    # points nowhere near a kernel config option.
    if [[ -r /proc/crypto ]] && ! grep -q 'aesni' /proc/crypto 2>/dev/null; then
        warn "This kernel has no AES-NI driver; encryption will use generic AES."
        echo "        The install is correct either way, but disk throughput on the"
        echo "        encrypted root will be a fraction of this machine's native speed."
        echo "        Fix: CONFIG_CRYPTO_AES_NI_INTEL=y in configs/kernel/config-6.17-raven."
    fi
    return 0
}

# Is the disk being installed to flash?
#
# Read from $DISK -- the whole disk -- rather than from ROOT_DEV, and that
# distinction is the entire reason this is a function instead of a `cat`. On
# an encrypted install ROOT_DEV is /dev/mapper/ravenroot by the time anything
# here runs, and a device-mapper node's queue/rotational is not the underlying
# disk's: dm reports 1 unless every underlying device said 0 and dm was asked
# to work it out, so btrfs's own autodetection can conclude "spinning rust"
# about an NVMe drive behind LUKS. That is exactly the machine the option was
# chosen for, so the answer is taken from the disk the installer was pointed
# at, which cannot lie about what it is.
#
# Unreadable is answered "no", which drops the option and leaves btrfs to
# autodetect -- the behaviour there has always been.
btrfs_target_is_ssd() {
    # DISK is set by choose_disk, which runs before anything that reaches
    # here, but this is under `set -u` and the cost of being wrong about that
    # is the install aborting on a bare-variable expansion in the middle of
    # laying out a filesystem. Unset is answered the same way unreadable is.
    local disk="${DISK:-}"
    [[ -n "$disk" ]] || return 1
    local rot="/sys/block/${disk##*/}/queue/rotational"
    [[ -r "$rot" ]] || return 1
    [[ "$(cat "$rot" 2>/dev/null)" == "0" ]]
}

# The mount options every btrfs subvolume in BTRFS_SUBVOLS gets -- and, at the
# bottom, the obvious fourth one that is deliberately not here.
#
#   noatime         the same decision write_fstab already made for ext4, for
#                   the same reasons; the long note is there. It matters more
#                   on btrfs, not less. An atime update is a metadata write,
#                   and on a copy-on-write filesystem a metadata write
#                   allocates new blocks instead of overwriting old ones -- so
#                   the writes that buy nothing also fragment the tree and pin
#                   blocks that snapshots would otherwise have let go.
#
#   compress=zstd:1 level 1, not btrfs's own default of 3. The trade is ratio
#                   against CPU on the write path, and on NVMe the disk is not
#                   the bottleneck, the compressor is: at level 3 the
#                   compression can take longer than writing the uncompressed
#                   bytes would have. Level 1 still roughly halves a root
#                   filesystem of ELF binaries, text configuration and manual
#                   pages, and is cheap enough not to show up on the write
#                   path. Already-compressed data -- a .zst package, a JPEG --
#                   btrfs detects and stores as-is, so nothing is paid twice.
#
#   ssd             a hint to the allocator to stop trying to keep writes
#                   physically contiguous, which is work that buys nothing on
#                   flash. btrfs sets this itself from queue/rotational, so on
#                   a plain install it only makes the implicit explicit -- see
#                   btrfs_target_is_ssd() for the encrypted case, where the
#                   device btrfs looks at is a mapper node and can get it
#                   wrong.
#
# AND THE ONE THAT IS NOT HERE: discard=async. It is the usual fourth item on
# a list like this, and on RavenLinux it would be duplicated work rather than
# an improvement, because this system already trims on a schedule.
# configs/raven/services/fstrim.toml starts raven-fstrim, which sleeps nearly
# all the time and runs `fstrim -av` at low priority once the stamp file is a
# week old, and its header says in as many words that the root is mounted
# without `discard` on purpose -- inline discards are latency on the write
# path, which is the cost this whole option list is trying to avoid. Adding
# discard=async would report the same freed blocks twice, once by the
# filesystem as they are freed and once a week by the service. One of the two
# has to go, and the service is the one that can be measured, configured from
# /etc/raven/fstrim.conf and switched off; a mount option baked into the fstab
# and the kernel command line of an installed machine is not. So the mount
# option is the one that is not written.
btrfs_common_opts() {
    local opts="noatime,compress=zstd:1"
    btrfs_target_is_ssd && opts="${opts},ssd"
    printf '%s' "$opts"
}

# What rootflags= carries on a btrfs install.
#
# The root's mount options cannot come from /etc/fstab -- raven-init's
# mount_fstab skips the root outright, because the initramfs mounted it
# already -- so the kernel command line is the only channel that can name the
# root's subvolume, and this is that name. Getting it wrong is not subtle: a
# btrfs filesystem mounted with no subvol= gives you the top-level subvolume,
# which is the directory that *contains* @, @home and the rest and has no
# /sbin/init anywhere in it. The initramfs then stops at its "this does not
# look like a RavenLinux root" check and drops to a rescue shell, having
# mounted a perfectly healthy filesystem.
btrfs_root_flags() {
    printf 'subvol=@,%s' "$(btrfs_common_opts)"
}

preflight() {
    phase preflight "Preflight checks"

    [[ "$(id -u)" == "0" ]] || soft_die "raven-install must run as root." || return 1
    ok "Running as root"

    if [[ -d /sys/firmware/efi ]]; then
        ok "Firmware: UEFI"
    else
        fail "Firmware: BIOS/CSM"
        echo
        echo "  RavenBoot is a UEFI bootloader, and raven-install can only install it"
        echo "  on a machine booted in UEFI mode. Two things to check:"
        echo
        echo "    - You may have booted the live USB through the firmware's legacy/CSM"
        echo "      entry. Reboot and pick the UEFI entry for the same stick."
        echo "    - The machine may be UEFI-capable with CSM forced on. Turn CSM off."
        echo
        echo "  Installing to a genuinely BIOS-only machine is not supported yet;"
        echo "  it needs GRUB in the sysroot, which the build does not ship."
        soft_die "UEFI firmware required." || return 1
    fi

    # Secure Boot rejects RavenBoot before it gets a chance to run, and the
    # failure lands at the next boot rather than here -- so say it now.
    read_secureboot_state
    report_secureboot_state

    local missing=()
    local t
    for t in sfdisk blkid lsblk findmnt mount umount mountpoint mkfs.vfat wipefs; do
        have "$t" || missing+=("$t")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        fail "Missing required tools: ${missing[*]}"
        echo
        echo "  These come from util-linux and dosfstools and are copied into the"
        echo "  sysroot by stage2. If you are on an ISO built before they were added"
        echo "  to that list, rebuild with 'imlazy stage2 && imlazy iso'."
        soft_die "Cannot continue without the tools above." || return 1
    fi
    ok "Disk tools present"

    case "${OPT_FS}" in
        ext4|xfs|btrfs) ;;
        *) die "Unsupported root filesystem: ${OPT_FS} (ext4, xfs, btrfs)" ;;
    esac
    have "mkfs.${OPT_FS}" || soft_die "mkfs.${OPT_FS} is not installed; use --fs ext4." || return 1
    if [[ "${OPT_FS}" == "btrfs" ]]; then
        # Two binaries, not one. mkfs.btrfs makes the filesystem; the `btrfs`
        # multicall binary makes the subvolumes the root is actually mounted
        # from. They ship in the same package and are copied into the sysroot
        # one name at a time -- stage2-native.sh:144 lists mkfs.btrfs and does
        # not list btrfs -- so an image can very easily have the first without
        # the second.
        #
        # Checked here, in preflight, rather than where it is used, because
        # where it is used is format_partitions, which runs after the disk has
        # been repartitioned. A missing btrfs discovered there is a machine
        # whose old system has been erased and whose new root filesystem has
        # no @ on it: unbootable, and nothing left to boot instead.
        have btrfs || soft_die "btrfs-progs is not on this image, so the subvolume layout cannot be created.
       mkfs.btrfs alone is not enough: the root is mounted from a subvolume
       called @, and creating it needs the \`btrfs\` binary from the same
       package. Add btrfs to the utils list in scripts/stages/stage2-native.sh
       and rebuild, or install with --fs ext4." || return 1
        ok "btrfs-progs present ($(btrfs --version 2>/dev/null | head -1))"
    fi
    ok "Root filesystem: ${OPT_FS}"

    if [[ -n "${OPT_SWAP}" && "${OPT_SWAP}" != "none" ]]; then
        have mkswap || die "mkswap is not installed; use --swap none."
    fi

    # Encryption's two host requirements, checked here rather than at
    # format_partitions, because format_partitions runs after the disk has
    # been repartitioned. A missing cryptsetup discovered there is a machine
    # with its old system erased and its new one unable to start.
    if (( OPT_ENCRYPT )); then
        check_encryption_support || return 1
    fi

    have chpasswd || warn "chpasswd not found; passwords will have to be set on first boot"

    mkdir -p "${TARGET}" "${SRCMNT}" || soft_die "Cannot create ${WORK}" || return 1
}

# =============================================================================
# Locate the source tree and the boot payload
# =============================================================================

SRC_ROOT=""          # directory whose contents become the installed system
SRC_KIND=""          # "squashfs" or "live-root"
SRC_KERNEL=""
SRC_INITRD=""
SRC_EFI=""

# The live media, wherever the initramfs left it. /run/raven-media is the
# loop-mounted-ISO case (Ventoy and "just copy the .iso onto a stick");
# /mnt/cdrom is the ordinary bind mount of the boot device.
media_dirs() {
    local d
    for d in /run/raven-media /mnt/cdrom /run/archiso/bootmnt; do
        [[ -d "$d" ]] && echo "$d"
    done
}

find_first() {
    local f
    for f in "$@"; do
        [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
    return 1
}

locate_source() {
    phase locate "Locating the system to install"

    # The squashfs is the better source: it is the pristine sysroot, with none
    # of the tmpfs scribbling the live overlay has accumulated since boot, and
    # it is a single filesystem so the copy needs no exclusion list.
    local media squash=""
    for media in $(media_dirs); do
        squash=$(find_first \
            "${media}/raven/filesystem.squashfs" \
            "${media}/live/filesystem.squashfs" \
            "${media}/squashfs.img") && break
        squash=""
    done

    if [[ -n "$squash" ]]; then
        if mount -t squashfs -o ro,loop "$squash" "${SRCMNT}" 2>/dev/null; then
            SRC_ROOT="${SRCMNT}"
            SRC_KIND="squashfs"
            ok "Source: ${squash}"
        else
            warn "Found ${squash} but could not mount it; falling back to the running root"
        fi
    fi

    if [[ -z "$SRC_ROOT" ]]; then
        # Installing from the running system. Works on the live image and on an
        # already-installed one (cloning this machine onto another disk).
        SRC_ROOT="/"
        SRC_KIND="live-root"
        ok "Source: the running system (/)"
    fi

    # The boot payload. On the live image it is on the media; on an installed
    # system it is in /boot; stage4 also stages a copy inside the squashfs so
    # neither of those has to exist.
    local search_dirs=()
    for media in $(media_dirs); do
        search_dirs+=("${media}/boot" "${media}/EFI/raven")
    done
    search_dirs+=("${SRC_ROOT%/}/boot" "${SRC_ROOT%/}/usr/share/raven/boot" "/boot" "/usr/share/raven/boot")

    local d
    for d in "${search_dirs[@]}"; do
        [[ -d "$d" ]] || continue
        [[ -z "$SRC_KERNEL" ]] && SRC_KERNEL=$(find_first "$d/vmlinuz" "$d/vmlinuz-raven" "$d"/vmlinuz-*) || true
        [[ -z "$SRC_INITRD" ]] && SRC_INITRD=$(find_first "$d/initramfs.img" "$d/initrd.img" "$d/initramfs-raven.img") || true
        [[ -z "$SRC_EFI" ]] && SRC_EFI=$(find_first "$d/raven-boot.efi" "$d/BOOTX64.EFI") || true
    done

    # Last resort for the bootloader: the fallback path on the live media's ESP.
    if [[ -z "$SRC_EFI" ]]; then
        for media in $(media_dirs); do
            SRC_EFI=$(find_first "${media}/EFI/BOOT/BOOTX64.EFI") && break
        done
    fi

    [[ -n "$SRC_KERNEL" ]] || soft_die "No kernel found. Looked in: ${search_dirs[*]}" || return 1
    [[ -n "$SRC_INITRD" ]] || soft_die "No initramfs found. Looked in: ${search_dirs[*]}" || return 1
    ok "Kernel:    ${SRC_KERNEL}"
    ok "Initramfs: ${SRC_INITRD}"

    if [[ -n "$SRC_EFI" ]]; then
        ok "Bootloader: ${SRC_EFI}"
    else
        soft_die "No RavenBoot EFI binary found. stage3 builds it to
       build/packages/boot/raven-boot.efi -- if that file is missing on the
       build host, the ISO shipped without it and there is nothing to install." \
            || return 1
    fi

    # An initramfs that predates root= support will mount the squashfs and
    # ignore the disk entirely, which looks like the installer failed when it
    # did not. Cheap to detect: the string only exists in the newer script.
    if [[ "$(initrd_root_support "$SRC_INITRD")" == "no" ]]; then
        warn "This initramfs may not support booting from a disk"
        echo "        It was built before root= handling was added, and will look for"
        echo "        the live squashfs instead of your new root partition."
        echo "        Rebuild with 'imlazy initramfs && imlazy iso' if the install does"
        echo "        not boot."
    fi
}

# =============================================================================
# Disk selection
# =============================================================================

list_disks() {
    lsblk -dn -o NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3 == "disk" { print }'
}

# nvme0n1 -> nvme0n1p1, sda -> sda1, mmcblk0 -> mmcblk0p1
partdev() {
    local disk="$1" n="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then
        echo "${disk}p${n}"
    else
        echo "${disk}${n}"
    fi
}

# Is $1 the disk we booted from? Shared with --probe, which greys the same
# device out in a front-end's list -- so the disk the installer would refuse is
# the disk the front-end never offers, rather than two guesses at the same rule.
is_live_media() {
    local disk="$1" media src_dev
    for media in $(media_dirs); do
        src_dev=$(findmnt -no SOURCE --target "$media" 2>/dev/null | sed 's/\[.*//')
        [[ -n "$src_dev" && "$src_dev" == "$disk"* ]] && return 0
    done
    return 1
}

# =============================================================================
# Disk layout
# =============================================================================
# Everything below reads or reshapes an existing partition table. It exists for
# one feature -- installing alongside another operating system -- and that is
# the only thing in this installer that has to do arithmetic on a disk rather
# than hand sfdisk a description and let it lay the disk out from scratch.
#
# The whole-disk path does not use any of it and is unchanged: it still wipes
# and writes a three-partition GPT, because when you are erasing the disk there
# is nothing to measure.

# 1 MiB, the alignment every partition here starts on. Not a preference: an SSD
# that reports 512-byte logical sectors is almost always writing 4K or larger
# underneath, and a partition starting mid-erase-block makes every write in it
# a read-modify-write for the life of the machine.
ALIGN_BYTES=1048576

# Sizes to bytes and back. sfdisk parses "8G" perfectly well on its own, which
# is why nothing here needed a size parser until now -- "how much can this
# partition give up, and is what is left enough for a root" is arithmetic, and
# it has to happen before anything is handed to sfdisk.
#
# awk rather than bash: "1.5T" is a size a person types, and bash has no
# floating point. Units are binary throughout, which is what sfdisk means by G
# and what a disk's advertised "512 GB" is not -- the difference is 7% and it
# is the difference between a plan that fits and one that does not.
to_bytes() {
    awk -v v="${1:-0}" 'BEGIN {
        gsub(/[ \t]/, "", v)
        if (v == "") { print 0; exit }
        if (match(v, /[KkMmGgTtPp]/)) {
            u = toupper(substr(v, RSTART, 1))
            n = substr(v, 1, RSTART - 1)
        } else { u = ""; n = v }
        if (n !~ /^[0-9]+(\.[0-9]+)?$/) { print 0; exit }
        m = 1
        if      (u == "K") m = 1024
        else if (u == "M") m = 1024 ^ 2
        else if (u == "G") m = 1024 ^ 3
        else if (u == "T") m = 1024 ^ 4
        else if (u == "P") m = 1024 ^ 5
        printf "%.0f\n", n * m
    }'
}

to_human() {
    awk -v b="${1:-0}" 'BEGIN {
        split("B KiB MiB GiB TiB PiB", u, " ")
        i = 1
        while (b >= 1024 && i < 6) { b /= 1024; i++ }
        if (i == 1) printf "%d %s\n", b, u[i]
        else        printf "%.1f %s\n", b, u[i]
    }'
}

# The GUIDs this file recognises. Partition type is the one piece of evidence
# about a partition that needs nothing mounted and cannot be wrong about what
# the partition is *for*, which is what makes it the right thing to key on.
GUID_ESP="C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
GUID_MSR="E3C9E316-0B5C-4DB8-817D-F92DF00215AE"     # Microsoft Reserved
GUID_MSDATA="EBD0A0A2-B9E5-4433-87C0-68B6B72699C7"  # Basic data: NTFS, and also FAT
GUID_WINRE="DE94BBA4-06D1-4D40-A16A-BFD50179D6AC"   # Windows Recovery
GUID_LINUX="0FC63DAF-8483-4772-8E79-3D69D8477DE4"
GUID_SWAP="0657FD6D-A4AB-43C4-84E5-0933C84B4F4F"

# The cached `sfdisk -d` of the target, and the header fields out of it.
DISK_TABLE=""
DISK_SECTOR=512
DISK_FIRST_LBA=2048
DISK_LAST_LBA=0
DISK_LABEL=""

# Reads the table into the variables above. Returns 1 for a disk with no
# partition table at all, which is not an error -- it is an empty disk, and the
# whole-disk path is the only thing that can be done with one anyway.
read_disk_table() {
    local disk="$1"
    DISK_TABLE="$(sfdisk -d "$disk" 2>/dev/null)" || return 1
    [[ -n "$DISK_TABLE" ]] || return 1

    DISK_LABEL=$(awk -F': *' '/^label:/ { print $2; exit }' <<< "$DISK_TABLE")
    DISK_SECTOR=$(awk -F': *' '/^sector-size:/ { print $2; exit }' <<< "$DISK_TABLE")
    DISK_FIRST_LBA=$(awk -F': *' '/^first-lba:/ { print $2; exit }' <<< "$DISK_TABLE")
    DISK_LAST_LBA=$(awk -F': *' '/^last-lba:/ { print $2; exit }' <<< "$DISK_TABLE")

    # sector-size and first-lba are recent additions to the dump format. A
    # 512-byte sector and a 2048-sector first LBA are what every GPT this will
    # meet actually uses, so defaulting is better than refusing -- but last-lba
    # cannot be guessed, and without it every gap calculation below is wrong.
    [[ -n "$DISK_SECTOR"    ]] || DISK_SECTOR=512
    [[ -n "$DISK_FIRST_LBA" ]] || DISK_FIRST_LBA=2048
    [[ -n "$DISK_LAST_LBA"  ]] || return 1
    return 0
}

# One line per partition: node, start, size, type -- all in sectors, tab
# separated, in table order.
table_rows() {
    awk '
        /^[^[:space:]]+[0-9]+[[:space:]]*:[[:space:]]*start=/ {
            node = $1
            start = size = type = ""
            if (match($0, /start=[[:space:]]*[0-9]+/))
                { start = substr($0, RSTART + 6, RLENGTH - 6); gsub(/[[:space:]]/, "", start) }
            if (match($0, /size=[[:space:]]*[0-9]+/))
                { size = substr($0, RSTART + 5, RLENGTH - 5);  gsub(/[[:space:]]/, "", size) }
            if (match($0, /type=[0-9A-Fa-f-]+/))
                { type = substr($0, RSTART + 5, RLENGTH - 5) }
            if (start != "" && size != "") print node "\t" start "\t" size "\t" type
        }
    ' <<< "$DISK_TABLE"
}

# start, size or type for one partition node.
part_field() {
    local node="$1" field="$2"
    table_rows | awk -F'\t' -v n="$node" -v f="$field" '
        $1 == n { print (f == "start" ? $2 : f == "size" ? $3 : $4); exit }'
}

# The disk's EFI System Partition, or nothing. Installing alongside means using
# the one that is already there: a second ESP is legal in the specification and
# a coin toss in practice, because the firmware picks which one it boots from
# and nothing says it will pick ours.
find_esp() {
    table_rows | awk -F'\t' -v esp="$GUID_ESP" '
        toupper($4) == esp { print $1; exit }'
}

# Unallocated space, as start/end/sectors, in table order. `sfdisk -F` prints
# this too, in a human format with a header, units that change with the size,
# and no promise about either -- so it is computed here from the same rows
# everything else reads.
free_gaps() {
    table_rows \
        | awk -F'\t' '{ print $2 "\t" ($2 + $3 - 1) }' \
        | sort -n -k1,1 \
        | awk -F'\t' -v first="$DISK_FIRST_LBA" -v last="$DISK_LAST_LBA" '
            BEGIN { cursor = first }
            {
                if ($1 > cursor) print cursor "\t" ($1 - 1) "\t" ($1 - cursor)
                if ($2 >= cursor) cursor = $2 + 1
            }
            END { if (last >= cursor) print cursor "\t" last "\t" (last - cursor + 1) }
        '
}

# The biggest one, as start/end/sectors. Empty when the disk is full.
largest_gap() {
    free_gaps | sort -n -k3,3 | tail -n 1
}

# What RavenBoot, a kernel and an initramfs need on an ESP: about 100 MB, and
# a little over for the next kernel. The same figure format_partitions holds a
# reused ESP to -- asked here, while planning, because finding out there was
# finding out after Windows had already been shrunk.
ESP_MIN_FREE="$(( 120 * 1024 * 1024 ))"
ESP_OWN=0              # 1 when RavenLinux gets its own ESP next to another OS's

# Free bytes on a FAT partition, or nothing when it cannot be looked at (not
# root, or not mountable). Unknown is not treated as too small: the check in
# format_partitions is still there behind it.
esp_free_bytes() {
    local dev="$1" mnt kb=""
    mnt=$(findmnt -no TARGET --source "$dev" 2>/dev/null | head -n 1)
    if [[ -n "$mnt" ]]; then
        kb=$(df -k "$mnt" 2>/dev/null | awk 'NR==2 { print $4 }')
    else
        mnt="${WORK}/espfree.$$"
        mkdir -p "$mnt" 2>/dev/null || return 0
        if mount -o ro "$dev" "$mnt" 2>/dev/null; then
            kb=$(df -k "$mnt" 2>/dev/null | awk 'NR==2 { print $4 }')
            umount "$mnt" 2>/dev/null
        fi
        rmdir "$mnt" 2>/dev/null
    fi
    [[ "$kb" =~ ^[0-9]+$ ]] && echo $(( kb * 1024 ))
    return 0
}

# Is Windows anywhere on this machine? NTFS or BitLocker, or the partition
# types only Windows makes (Microsoft Reserved, Windows Recovery). "Basic
# data" is not evidence: every FAT USB stick is typed that way.
machine_has_windows() {
    lsblk -rno FSTYPE,PARTTYPE 2>/dev/null \
        | grep -qiE 'ntfs|bitlocker|e3c9e316-0b5c-4db8-817d-f92df00215ae|de94bba4-06d1-4d40-a16a-bfd50179d6ac'
}

disk_has_bitlocker() {
    lsblk -rno FSTYPE "$1" 2>/dev/null | grep -qi '^bitlocker$'
}


# =============================================================================
# Filesystems on somebody else's partition
# =============================================================================
# The smallest root worth creating. The tree this copies is around 1.5 GB and
# an installed desktop settles near 6, so 12 GiB is not the floor of what fits
# -- it is the floor of what is still usable a month later, with a kernel or
# two, a package cache and somewhere to put a file. Below it the install would
# succeed and the machine would be full.
ALONGSIDE_MIN_ROOT="$(( 12 * 1024 * 1024 * 1024 ))"

# What must be left in the other OS's filesystem beyond the bytes it is
# actually using. A Windows that boots into 200 MB of headroom does not boot
# for long: the page file, the update cache and the restore points all want
# room, and the person shrinking it will blame the installer rather than the
# slider.
ALONGSIDE_MIN_HEADROOM="$(( 4 * 1024 * 1024 * 1024 ))"

# The swap the installer would create if nothing more is said, as a size string
# ("16G") or empty for none.
#
# run_wizard and apply_answers both resolve OPT_SWAP by these same three cases,
# but both of them run *after* the disk has been chosen -- and the alongside
# planner, the wizard's shrink prompt and --probe all have to know how much
# room swap is going to want before SWAP_SIZE has been set by either. This is
# that rule, asked early. It is an estimate only for an interactive run that
# has not reached the swap prompt yet; everywhere else OPT_SWAP is already
# final and this is exactly what will be created.
resolve_swap_size() {
    if [[ -z "${OPT_SWAP}" ]]; then
        suggested_swap
    elif [[ "${OPT_SWAP}" == "none" ]]; then
        echo ""
    else
        echo "${OPT_SWAP}"
    fi
}

# What an alongside install actually needs from the disk: a root, plus the swap
# partition that is going into the same gap next to it.
#
# ALONGSIDE_MIN_ROOT on its own is the number this file used to check
# everywhere, and it is the wrong one for every check made before the gap is
# split: plan_alongside_partitions puts swap in that gap too, so a gap that
# clears 12 GiB and nothing more leaves a root of whatever is left after swap
# has taken its share. On a machine with 16 GB of memory that is a root of
# zero. Asking one function means the probe, the wizard and the planner cannot
# answer it differently.
alongside_min_total() {
    local swap; swap="$(resolve_swap_size)"
    if [[ -n "$swap" ]]; then
        echo $(( ALONGSIDE_MIN_ROOT + $(to_bytes "$swap") ))
    else
        echo "$ALONGSIDE_MIN_ROOT"
    fi
}

# How a total that nobody typed breaks down, for the refusals that quote one.
# "28.0 GiB" on a machine with 16 GB of memory is a number the person cannot
# account for until they are told that 16 of it is a swap partition they were
# never asked about. Empty when swap is off and the total is only the root.
swap_share_note() {
    local swap="$1"
    [[ -n "$swap" ]] || return 0
    printf ' (%s for the root plus %s of swap; --swap none drops it)' \
        "$(to_human $ALONGSIDE_MIN_ROOT)" "$swap"
}

fs_type_of() { blkid -o value -s TYPE "$1" 2>/dev/null; }
fs_label_of() { blkid -o value -s LABEL "$1" 2>/dev/null; }

# Can this filesystem be made smaller without losing what is in it?
#
# The list is short on purpose. ext2/3/4 and NTFS are the two families with a
# shrink that is offline, in place, and old enough to trust. XFS cannot shrink
# at all -- the feature has never existed. btrfs can, but only while mounted,
# which means mounting somebody else's root read-write from a live image to
# resize it, and that is a different risk than this is willing to take on
# their behalf. FAT is refused because a partition that is FAT and big enough
# to be worth shrinking is nearly always an ESP.
fs_shrinkable() {
    case "$(fs_type_of "$1")" in
        ext2|ext3|ext4) have resize2fs && have e2fsck ;;
        ntfs)           have ntfsresize ;;
        *)              return 1 ;;
    esac
}

# The smallest this filesystem says it could become, in bytes, or nothing if it
# cannot be asked. This is the number the shrink is checked against, and it is
# the filesystem's own estimate rather than "space in use" -- the two differ by
# however badly the data is scattered, and it is the estimate that decides
# whether the resize succeeds.
fs_min_bytes() {
    local dev="$1" blocks bs min

    case "$(fs_type_of "$dev")" in
        ext2|ext3|ext4)
            blocks=$(resize2fs -P "$dev" 2>/dev/null | awk -F': *' '/minimum size/ { print $2 }')
            [[ "$blocks" =~ ^[0-9]+$ ]] || return 1
            bs=$(dumpe2fs -h "$dev" 2>/dev/null | awk -F': *' '/^Block size/ { print $2 }')
            [[ "$bs" =~ ^[0-9]+$ ]] || bs=4096
            echo $(( blocks * bs ))
            ;;
        ntfs)
            # `ntfsresize --info` reports the smallest supported size as a byte
            # count on its "You might resize at N bytes" line. It exits 1 when
            # the volume is already at its minimum, which is a real answer and
            # not a failure, so the output is parsed either way.
            min=$(ntfsresize --info --force "$dev" 2>/dev/null \
                  | awk '/You might resize at/ { print $5; exit }')
            [[ "$min" =~ ^[0-9]+$ ]] || return 1
            echo "$min"
            ;;
        *)  return 1 ;;
    esac
}

# A name for what is on a partition, for the plan and for a front-end's list.
# Type GUID first because it needs nothing mounted and cannot lie about intent;
# the filesystem label is a fallback and the filesystem type the last resort.
part_os_hint() {
    local node="$1" type label fstype
    type=$(part_field "$node" type | tr 'a-z' 'A-Z')
    label=$(fs_label_of "$node")
    fstype=$(fs_type_of "$node")

    case "$type" in
        "$GUID_ESP") echo "EFI System Partition"; return ;;
        "$GUID_MSR") echo "Microsoft Reserved";   return ;;
        "$GUID_WINRE") echo "Windows Recovery";   return ;;
    esac

    if [[ "$fstype" == "ntfs" ]]; then
        # The volume label is worth showing -- it is how somebody tells two
        # Windows partitions apart -- except when it is the word already being
        # printed, which on an OEM disk it very often is.
        if [[ -n "$label" && "${label,,}" != "windows" ]]; then
            echo "Windows (${label})"
        else
            echo "Windows"
        fi
        return
    fi
    if [[ -n "$label" ]]; then
        echo "${fstype:-unknown} (${label})"
        return
    fi
    echo "${fstype:-unformatted}"
}

# Disks other than the target that carry an EFI System Partition -- which is
# to say, the other operating systems on this machine.
#
# sfdisk is read directly rather than through read_disk_table because this is
# asked about every disk in turn and read_disk_table caches one: calling it
# here would leave DISK_TABLE describing the last disk looked at rather than
# the one being installed to.
disk_has_esp() {
    sfdisk -d "$1" 2>/dev/null | grep -qi "type=${GUID_ESP}"
}

other_esp_disks() {
    local line dev
    while read -r line; do
        [[ -z "$line" ]] && continue
        dev="/dev/$(echo "$line" | awk '{print $1}')"
        [[ "$dev" == "$DISK" ]] && continue
        disk_has_esp "$dev" && echo "$dev"
    done < <(list_disks)
}

# Whether to register a UEFI NVRAM boot entry, when nobody has said either way.
#
# Off is right when the disk is erased: \EFI\BOOT\BOOTX64.EFI is what firmware
# runs when no NVRAM entry matches, that file is RavenBoot after this install,
# and not touching NVRAM leaves the firmware's existing entries in their
# existing order. It is not right next to another OS on the same disk -- see
# below -- which is every install that is not a wipe.
#
# On two disks it is wrong, and wrong in a way that looks like a failed
# install. The other disk has a fallback loader of its own and an NVRAM entry
# pointing at it -- "Windows Boot Manager", ahead of ours in the boot order --
# so the firmware goes on booting that. RavenBoot is never reached, and so the
# menu it would have shown, with that other OS in it, is never reached either.
decide_nvram() {
    # An ESP of our own next to another OS's is reachable only through a boot
    # entry: the firmware's entry for the other OS comes first, and the
    # fallback path it would try after that is on the other OS's ESP.
    if (( ${ESP_OWN:-0} )); then
        (( NVRAM_DECLINED )) && die "RavenLinux has its own EFI partition next to another OS's, and
       the firmware can only find it through a boot entry. Allow the boot
       entry (efi_nvram=1), or share the existing EFI partition."
        have efibootmgr || die "RavenLinux needs a UEFI boot entry here and efibootmgr is not on this image."
        OPT_NVRAM=1
        info "Registering a UEFI boot entry for RavenLinux's own EFI partition."
        return 0
    fi

    (( OPT_NVRAM ))      && return 0
    (( NVRAM_DECLINED )) && return 0

    # Next to another OS on the same disk. That OS has an NVRAM entry of its
    # own -- "Windows Boot Manager", "ubuntu" -- ahead of the fallback path in
    # the boot order, so without ours the firmware goes on booting it and
    # RavenBoot never runs. efibootmgr -c puts the new entry first.
    if [[ "$OPT_MODE" != "wipe" ]]; then
        OPT_NVRAM=1
        info "Another operating system shares ${DISK}; registering a UEFI boot entry so RavenBoot runs first."
        info "Put efi_nvram=0 in an answers file to skip it."
        return 0
    fi

    local others
    others="$(other_esp_disks)"
    [[ -n "$others" ]] || return 0

    OPT_NVRAM=1
    info "Another operating system is on $(echo $others | tr '\n' ' ')and this install is going somewhere else."
    info "Registering a UEFI boot entry, or the firmware would keep booting that disk."
    info "Put efi_nvram=0 in an answers file to skip it."
}

# =============================================================================
# Planning an install alongside what is already there
# =============================================================================
# Everything this decides is decided before a byte is written, and confirm()
# prints all of it. The numbers below are sectors unless they say bytes.

SHRINK_DEV=""          # the partition being made smaller, or empty
SHRINK_OLD_SECTORS=0
SHRINK_NEW_SECTORS=0
SHRINK_NEW_BYTES=0
SHRINK_MIN_BYTES=0
GAP_START=0            # where the space for RavenLinux begins
GAP_SECTORS=0
ESP_REUSED=0           # 1 when ESP_DEV is somebody else's ESP, not one we made

# sectors -> the next lower multiple of the 1 MiB alignment
align_down() {
    local sectors="$1" a=$(( ALIGN_BYTES / DISK_SECTOR ))
    (( a < 1 )) && a=1
    echo $(( sectors / a * a ))
}
align_up() {
    local sectors="$1" a=$(( ALIGN_BYTES / DISK_SECTOR ))
    (( a < 1 )) && a=1
    echo $(( (sectors + a - 1) / a * a ))
}

plan_alongside() {
    # Start from nothing. Every one of these is set by exactly one branch
    # below, so a value left over from an earlier call is a plan describing a
    # shrink that this call did not decide to do -- and confirm() prints
    # whatever is in them.
    SHRINK_DEV=""
    SHRINK_OLD_SECTORS=0
    SHRINK_NEW_SECTORS=0
    SHRINK_NEW_BYTES=0
    SHRINK_MIN_BYTES=0
    GAP_START=0
    GAP_SECTORS=0
    ALONGSIDE_PARTS=""

    read_disk_table "$DISK" \
        || die "${DISK} has no partition table to install alongside. Use --wipe to erase it."

    [[ "${DISK_LABEL,,}" == "gpt" ]] \
        || die "${DISK} is ${DISK_LABEL:-MBR}, not GPT. Installing alongside needs a GPT disk;
       a UEFI machine has one, so this disk is probably from a BIOS install."

    # The ESP is reused, never created and never formatted. A second ESP is
    # legal and useless: the firmware chooses which one it boots from, and
    # nothing in the specification says it will choose ours.
    ESP_DEV="$(find_esp)"
    [[ -n "$ESP_DEV" ]] \
        || die "${DISK} has no EFI System Partition. There is no other UEFI OS on it
       to install alongside -- use --wipe to erase the disk and start clean."
    ESP_REUSED=1
    ESP_OWN=0

    # Windows makes a 100 MB ESP and fills most of it. Sharing one that small
    # fails in the bootloader step, after everything else has been written, so
    # it is decided here instead: RavenLinux gets an ESP of its own in the same
    # space, the other OS's is not touched, and a boot entry points at ours.
    local esp_free; esp_free="$(esp_free_bytes "$ESP_DEV")"
    if [[ -n "$esp_free" ]] && (( esp_free < ESP_MIN_FREE )); then
        ESP_OWN=1
        ESP_REUSED=0
        info "${ESP_DEV} has only $(to_human "$esp_free") free; RavenLinux gets an EFI partition of its own"
    fi

    local want_bytes=0
    [[ -n "$OPT_ALONGSIDE_SIZE" ]] && want_bytes=$(to_bytes "$OPT_ALONGSIDE_SIZE")

    # What the gap has to hold. SWAP_SIZE rather than resolve_swap_size here:
    # by the time anything is planned the wizard has asked, so this is the
    # answer rather than the estimate the probe had to work from.
    local need=$ALONGSIDE_MIN_ROOT
    [[ -n "$SWAP_SIZE" ]] && need=$(( need + $(to_bytes "$SWAP_SIZE") ))
    (( ${ESP_OWN:-0} )) && need=$(( need + $(to_bytes "$OPT_ESP_SIZE") ))
    local need_detail; need_detail="$(swap_share_note "$SWAP_SIZE")"

    if [[ -n "$OPT_SHRINK_PART" ]]; then
        plan_shrink "$want_bytes" "$need"
    else
        # No partition named: take the largest hole already on the disk. This
        # is the case where somebody has left space unallocated on purpose,
        # and it needs no resize at all.
        local gap
        gap="$(largest_gap)"
        [[ -n "$gap" ]] || die "There is no free space on ${DISK} and no partition was given to shrink.
       Pass --shrink <partition> to take space from one, or --wipe to erase the disk."

        GAP_START=$(echo "$gap" | cut -f1)
        GAP_SECTORS=$(echo "$gap" | cut -f3)

        # Align the start, and give back what alignment cost from the length.
        local aligned; aligned=$(align_up "$GAP_START")
        GAP_SECTORS=$(( GAP_SECTORS - (aligned - GAP_START) ))
        GAP_START=$aligned
        GAP_SECTORS=$(align_down "$GAP_SECTORS")

        if (( want_bytes > 0 && want_bytes < GAP_SECTORS * DISK_SECTOR )); then
            GAP_SECTORS=$(align_down $(( want_bytes / DISK_SECTOR )))
        fi

        # A disk with a megabyte of slack at the end has "free space" and no
        # room, and the generic size check below would report that as "0 B is
        # not enough" -- true, and no help at all to somebody who has not been
        # told that taking space from a partition is the other option.
        if (( GAP_SECTORS * DISK_SECTOR < need )); then
            die "${DISK} has only $(to_human $(( GAP_SECTORS * DISK_SECTOR ))) unallocated, and this install needs $(to_human $need)${need_detail}.
       Pass --shrink <partition> to take the space from one of the partitions
       that is already there, or --wipe to erase the disk."
        fi
    fi

    local gap_bytes=$(( GAP_SECTORS * DISK_SECTOR ))

    (( gap_bytes >= need )) || die "$(to_human $gap_bytes) is not enough for RavenLinux.
       It needs at least $(to_human $need)${need_detail}."

    plan_alongside_partitions
}

# Works out how far the chosen partition can be pulled back, and refuses rather
# than guessing when the answer is "not that far".
plan_shrink() {
    local want_bytes="$1" need="${2:-$ALONGSIDE_MIN_ROOT}"

    SHRINK_DEV="$OPT_SHRINK_PART"
    [[ -b "$SHRINK_DEV" ]] || die "${SHRINK_DEV} is not a block device."
    [[ "$SHRINK_DEV" == "$DISK"* ]] || die "${SHRINK_DEV} is not a partition of ${DISK}."
    [[ "$SHRINK_DEV" != "$ESP_DEV" ]] || die "${SHRINK_DEV} is the EFI System Partition. Shrinking it would
       take the space the other OS boots from. Choose a data partition."

    local start size
    start=$(part_field "$SHRINK_DEV" start)
    size=$(part_field "$SHRINK_DEV" size)
    [[ "$start" =~ ^[0-9]+$ && "$size" =~ ^[0-9]+$ ]] \
        || die "Cannot read ${SHRINK_DEV} from ${DISK}'s partition table."
    SHRINK_OLD_SECTORS="$size"

    # Mounted is fatal, not a warning. Every shrink here is an offline one;
    # resizing underneath a mounted filesystem corrupts it.
    if findmnt -no TARGET --source "$SHRINK_DEV" >/dev/null 2>&1; then
        die "${SHRINK_DEV} is mounted. Unmount it and run the installer again."
    fi

    local fstype; fstype=$(fs_type_of "$SHRINK_DEV")
    if ! fs_shrinkable "$SHRINK_DEV"; then
        # The two cases read very differently to whoever hit them: one is "this
        # filesystem cannot be shrunk by anything", the other is "it can, and
        # this image is missing the program that does it".
        if [[ "$fstype" == "ntfs" ]]; then
            die "Cannot shrink ${SHRINK_DEV}: ntfsresize is not installed on this image.
       Without it an NTFS partition cannot be made smaller. Install ntfsprogs,
       or erase the disk with --wipe."
        fi
        die "Cannot shrink ${SHRINK_DEV}: it is ${fstype:-unrecognised}.
       Shrinking is supported for ext2/3/4 and NTFS. XFS cannot shrink at all,
       and btrfs only while mounted, which this will not do to another OS's
       filesystem. Free space inside it and use that, or erase the disk."
    fi

    SHRINK_MIN_BYTES=$(fs_min_bytes "$SHRINK_DEV") \
        || die "${SHRINK_DEV} would not report how small it can be made.
       On NTFS this usually means Windows was hibernated or shut down with Fast
       Startup on, which leaves the filesystem dirty. Boot Windows, shut it
       down fully (Shift-click Restart, or 'shutdown /s /t 0'), and try again."

    local floor=$(( SHRINK_MIN_BYTES + ALONGSIDE_MIN_HEADROOM ))
    local old_bytes=$(( SHRINK_OLD_SECTORS * DISK_SECTOR ))

    # Half of what it can spare, but never less than the install actually
    # needs. Half is a good default only because it splits the disk evenly; on
    # a partition that can spare 30 GiB it is 15 GiB, and 15 GiB is a root of
    # nothing once a memory-sized swap has come out of the same gap. The
    # new_bytes check below is what refuses when even `need` will not fit.
    if (( want_bytes <= 0 )); then
        want_bytes=$(( (old_bytes - floor) / 2 ))
        (( want_bytes < need )) && want_bytes=$need
    fi
    (( want_bytes > 0 )) || die "${SHRINK_DEV} has no room to give.
       It holds $(to_human $SHRINK_MIN_BYTES) and is $(to_human $old_bytes)."

    local new_bytes=$(( old_bytes - want_bytes ))
    (( new_bytes >= floor )) || die "Taking $(to_human $want_bytes) would leave ${SHRINK_DEV} at $(to_human $new_bytes).
       It cannot go below $(to_human $floor): $(to_human $SHRINK_MIN_BYTES) is in use and
       $(to_human $ALONGSIDE_MIN_HEADROOM) is the headroom that OS needs to keep working.
       The most it can give up is $(to_human $(( old_bytes - floor )))."

    # The new boundary is where the gap starts, so it is what gets aligned;
    # the partition's size follows from it rather than the other way round.
    local new_end_excl
    new_end_excl=$(align_down $(( start + new_bytes / DISK_SECTOR )))
    SHRINK_NEW_SECTORS=$(( new_end_excl - start ))
    SHRINK_NEW_BYTES=$(( SHRINK_NEW_SECTORS * DISK_SECTOR ))

    GAP_START=$new_end_excl
    GAP_SECTORS=$(( start + SHRINK_OLD_SECTORS - new_end_excl ))
    GAP_SECTORS=$(align_down "$GAP_SECTORS")

    (( SHRINK_NEW_SECTORS > 0 && GAP_SECTORS > 0 )) \
        || die "The shrink works out to nothing after alignment. Ask for more space."
}

# Splits the gap into swap and root. Both get explicit start sectors: they are
# going into a hole between existing partitions, and sfdisk only picks a start
# for you when it is appending to the end of the disk.
ALONGSIDE_PARTS=""     # the sfdisk script, one line per partition to create

plan_alongside_partitions() {
    local cursor=$GAP_START
    local end_excl=$(( GAP_START + GAP_SECTORS ))
    local lines=""
    ESP_START=""; SWAP_START=""

    if (( ${ESP_OWN:-0} )); then
        local esp_sectors
        esp_sectors=$(align_up $(( $(to_bytes "$OPT_ESP_SIZE") / DISK_SECTOR )))
        lines+="start=${cursor}, size=${esp_sectors}, type=${GUID_ESP}, name=\"${ESP_LABEL}\""$'\n'
        ESP_START=$cursor
        cursor=$(( cursor + esp_sectors ))
    fi

    if [[ -n "$SWAP_SIZE" ]]; then
        local swap_sectors
        swap_sectors=$(align_up $(( $(to_bytes "$SWAP_SIZE") / DISK_SECTOR )))
        lines+="start=${cursor}, size=${swap_sectors}, type=${GUID_SWAP}, name=\"${SWAP_LABEL}\""$'\n'
        SWAP_START=$cursor
        cursor=$(( cursor + swap_sectors ))
    fi

    local root_sectors=$(( end_excl - cursor ))
    lines+="start=${cursor}, size=${root_sectors}, type=${GUID_LINUX}, name=\"${ROOT_LABEL}\""$'\n'
    ROOT_START=$cursor

    ALONGSIDE_PARTS="$lines"
    ROOT_ALONGSIDE_BYTES=$(( root_sectors * DISK_SECTOR ))
}

choose_disk() {
    phase disk "Choosing the target disk"

    if [[ -n "${OPT_DISK}" ]]; then
        DISK="${OPT_DISK}"
    elif (( OPT_NONINTERACTIVE )); then
        die "No target disk. --non-interactive needs 'disk=' in the answers file."
    else
        echo
        echo "  Disks on this machine:"
        echo
        local n=0 names=() line
        while read -r line; do
            [[ -z "$line" ]] && continue
            n=$((n + 1))
            names+=("/dev/$(echo "$line" | awk '{print $1}')")
            printf '    %d) /dev/%s\n' "$n" "$line"
        done < <(list_disks)
        echo

        [[ $n -gt 0 ]] || die "No disks found. If this machine uses RAID or Intel RST,
       switch the SATA/NVMe controller to AHCI mode in the firmware."

        local choice
        while true; do
            read -r -p "  Install to which disk? [1-${n}] " choice
            if [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 && $choice -le $n ]]; then
                DISK="${names[$((choice - 1))]}"
                break
            fi
            warn "Enter a number between 1 and ${n}."
        done
    fi

    [[ -b "$DISK" ]] || die "${DISK} is not a block device."

    # Refuse to install onto the stick we booted from. It is mounted, the copy
    # would read from a device it is simultaneously erasing, and the failure is
    # ugly and halfway through.
    if is_live_media "$DISK"; then
        die "${DISK} is the live boot media. Pick the machine's internal disk."
    fi

    DISK_SIZE=$(lsblk -dn -o SIZE "$DISK" 2>/dev/null | tr -d ' ')
    DISK_MODEL=$(lsblk -dn -o MODEL "$DISK" 2>/dev/null | sed 's/ *$//')
    ok "Target: ${DISK} (${DISK_SIZE}${DISK_MODEL:+, ${DISK_MODEL}})"

    # Show what is about to be destroyed. Vague warnings get clicked through;
    # a list of the user's actual partitions does not.
    local existing
    existing=$(lsblk -n -o NAME,SIZE,FSTYPE,LABEL "$DISK" 2>/dev/null | tail -n +2)
    if [[ -n "$existing" ]]; then
        echo
        echo "  ${YELLOW}This disk currently holds:${NC}"
        echo "$existing" | sed 's/^/      /'
    fi

    choose_install_mode
}

# Erase the disk, or move in next to what is on it.
#
# Only asked when there is something to ask about. A blank disk, or one with no
# ESP, has no other OS to install alongside and the question would be a choice
# between one real option and one that dies two functions later.
choose_install_mode() {
    # A flag or an answers file has already decided. --shrink implies
    # --alongside in the parser, so there is no half-set state to reconcile.
    [[ "$OPT_MODE" == "alongside" ]] && { choose_shrink_target; return 0; }
    # Manual is decided entirely by its three lists; there is no question left.
    [[ "$OPT_MODE" == "manual" ]] && return 0
    (( OPT_NONINTERACTIVE )) && return 0
    (( OPT_YES )) && return 0

    read_disk_table "$DISK" 2>/dev/null || return 0
    [[ "${DISK_LABEL,,}" == "gpt" ]] || return 0
    [[ -n "$(find_esp)" ]] || return 0

    # An ESP on its own is not another OS -- a disk this installer wrote has
    # one too. What makes the question worth asking is an ESP plus something
    # that is not ours next to it.
    local others=0 row node
    while IFS=$'\t' read -r node _ _ type; do
        [[ -z "$node" ]] && continue
        case "${type^^}" in
            "$GUID_ESP") continue ;;
        esac
        others=$((others + 1))
    done < <(table_rows)
    (( others > 0 )) || return 0

    echo
    echo "  ${YELLOW}This disk already has an operating system on it.${NC}"
    echo
    echo "    1) Install alongside it -- keep it, and take space for RavenLinux"
    echo "    2) Erase the whole disk"
    echo
    local choice=""
    while true; do
        read -r -p "  Which? [1-2] " choice
        case "$choice" in
            1) OPT_MODE="alongside"; break ;;
            2) OPT_MODE="wipe";      break ;;
            *) warn "Enter 1 or 2." ;;
        esac
    done

    [[ "$OPT_MODE" == "alongside" ]] && choose_shrink_target
    return 0
}

# Which partition gives up the space, and how much.
#
# Skipped entirely when the disk already has a big enough hole in it: taking
# space that is not allocated to anything needs no resize, and offering to
# shrink a filesystem when there is no need to is offering a risk for nothing.
choose_shrink_target() {
    read_disk_table "$DISK" 2>/dev/null || return 0

    # Root plus the swap that is going into the same gap. This runs before
    # run_wizard has asked about swap, so it is resolve_swap_size's estimate --
    # which is what will be created unless the person changes it at the prompt,
    # and erring towards asking for too much beats offering a partition that
    # plan_alongside then refuses.
    local need; need="$(alongside_min_total)"

    local gap gap_bytes=0
    gap="$(largest_gap)"
    [[ -n "$gap" ]] && gap_bytes=$(( $(echo "$gap" | cut -f3) * DISK_SECTOR ))

    if [[ -z "$OPT_SHRINK_PART" ]] && (( gap_bytes >= need )); then
        info "Using the $(to_human $gap_bytes) of unallocated space already on ${DISK}."
        return 0
    fi

    # Everything that could give up space: a filesystem this can shrink, not
    # the ESP, and not mounted.
    local -a cand=() cand_min=() cand_size=()
    local node start size type minb
    while IFS=$'\t' read -r node start size type; do
        [[ -z "$node" ]] && continue
        [[ "${type^^}" == "$GUID_ESP" ]] && continue
        [[ -b "$node" ]] || continue
        findmnt -no TARGET --source "$node" >/dev/null 2>&1 && continue
        fs_shrinkable "$node" || continue
        minb=$(fs_min_bytes "$node") || continue
        # Nothing to offer if it cannot spare root and swap plus the headroom.
        (( size * DISK_SECTOR - minb - ALONGSIDE_MIN_HEADROOM >= need )) || continue
        cand+=("$node"); cand_min+=("$minb"); cand_size+=("$(( size * DISK_SECTOR ))")
    done < <(table_rows)

    if [[ -n "$OPT_SHRINK_PART" ]]; then
        return 0        # named on the command line; plan_shrink validates it
    fi

    if (( ${#cand[@]} == 0 )); then
        die "Nothing on ${DISK} can give up $(to_human $need) for RavenLinux$(swap_share_note "$(resolve_swap_size)").
       Free space inside the other OS first, or erase the disk with --wipe.
       ext2/3/4 and NTFS can be shrunk; XFS and btrfs cannot be, here."
    fi

    echo
    echo "  Which partition should give up space?"
    echo
    local i
    for i in "${!cand[@]}"; do
        printf '    %d) %-16s %-9s %-22s can spare up to %s\n' \
            $((i + 1)) "${cand[$i]}" "$(to_human "${cand_size[$i]}")" \
            "$(part_os_hint "${cand[$i]}")" \
            "$(to_human $(( cand_size[i] - cand_min[i] - ALONGSIDE_MIN_HEADROOM )))"
    done
    echo

    local choice=""
    while true; do
        read -r -p "  Which? [1-${#cand[@]}] " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#cand[@]} )); then
            OPT_SHRINK_PART="${cand[$((choice - 1))]}"
            break
        fi
        warn "Enter a number between 1 and ${#cand[@]}."
    done

    local idx=$((choice - 1))
    local spare=$(( cand_size[idx] - cand_min[idx] - ALONGSIDE_MIN_HEADROOM ))
    # The floor is the whole gap, not just the root: swap comes out of the
    # space taken here before the root gets any of it.
    local suggest=$(( spare / 2 ))
    (( suggest < need )) && suggest=$need
    echo
    echo "  ${OPT_SHRINK_PART} can give RavenLinux between $(to_human $need) and $(to_human $spare)$(swap_share_note "$(resolve_swap_size)")."
    while true; do
        ask OPT_ALONGSIDE_SIZE "How much for RavenLinux" "$(to_human $suggest | tr -d ' ' | sed 's/iB$//')"
        local want; want=$(to_bytes "$OPT_ALONGSIDE_SIZE")
        if (( want >= need && want <= spare )); then
            break
        fi
        warn "Between $(to_human $need) and $(to_human $spare), e.g. 120G."
    done
}

# =============================================================================
# The answers file
# =============================================================================
# What a front-end sends instead of standing at the keyboard. One key=value per
# line; the value is everything after the first '=' including spaces, quotes
# and '#', because a password is a value like any other and stripping anything
# from it would silently install a machine nobody can log into.
#
# Parsed by hand rather than sourced. Sourcing it would be four lines shorter
# and would also execute whatever is in the file as shell, as root, before the
# disk is touched -- and this file is written by another process, in /run,
# during an install. There is no eval anywhere below for the same reason.

declare -A ANS=()

# Keys, and which of them are required. Printed by --probe as answers.key so a
# front-end reads the list rather than hardcoding it.
ANSWER_KEYS=(
    disk mode shrink_part alongside_size
    fs esp_size swap encrypt encrypt_password
    hostname username fullname user_password user_sudo
    root_password timezone locale keymap profile efi_nvram postinstall
    optional manual_delete manual_new manual_use rtc secureboot
)
ANSWER_REQUIRED=(disk hostname username)

load_answers() {
    local file="$1"

    [[ -f "$file" ]] || die "No such answers file: ${file}"
    [[ -r "$file" ]] || die "Cannot read ${file}"

    # It holds passwords. A file anyone on the machine can read is a mistake
    # worth stopping for rather than warning about, because by the time the
    # warning scrolls past, the install has already used it.
    local mode
    mode=$(stat -c '%a' "$file" 2>/dev/null || echo "")
    if [[ -n "$mode" && "${mode: -2}" != "00" ]]; then
        die "${file} is mode ${mode}; it holds passwords. Use 0600."
    fi

    local line key value lineno=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        [[ -z "${line//[[:space:]]/}" ]] && continue
        [[ "${line#"${line%%[![:space:]]*}"}" == \#* ]] && continue
        [[ "$line" == *=* ]] || die "${file}:${lineno}: not key=value: ${line}"

        key="${line%%=*}"
        value="${line#*=}"
        # Only the key is trimmed. A trailing space in a password is a
        # character somebody typed.
        key="${key//[[:space:]]/}"

        local known=0 k
        for k in "${ANSWER_KEYS[@]}"; do
            [[ "$k" == "$key" ]] && { known=1; break; }
        done
        (( known )) || die "${file}:${lineno}: unknown key '${key}'"

        ANS["$key"]="$value"
    done < "$file"

    local req
    for req in "${ANSWER_REQUIRED[@]}"; do
        [[ -n "${ANS[$req]:-}" ]] || die "${file}: missing required key '${req}'"
    done

    # The keys that have a command-line equivalent feed the same variables the
    # flag would, so there is one code path from here on. An explicit flag wins:
    # it is the more specific instruction, and it is how a front-end overrides
    # one field of a saved answers file without rewriting it.
    [[ -z "$OPT_DISK"    ]] && OPT_DISK="${ANS[disk]:-}"
    [[ "$OPT_MODE" == "wipe" && -n "${ANS[mode]:-}" ]] && OPT_MODE="${ANS[mode]}"
    [[ -z "$OPT_SHRINK_PART"    ]] && OPT_SHRINK_PART="${ANS[shrink_part]:-}"
    [[ -z "$OPT_ALONGSIDE_SIZE" ]] && OPT_ALONGSIDE_SIZE="${ANS[alongside_size]:-}"
    # shrink_part on its own means alongside: naming a partition to take space
    # from is not something you do to a disk you are erasing, and making the
    # front-end send two keys that cannot disagree is two chances to disagree.
    [[ -n "$OPT_SHRINK_PART" ]] && OPT_MODE="alongside"
    [[ -z "$OPT_MANUAL_DELETE" ]] && OPT_MANUAL_DELETE="${ANS[manual_delete]:-}"
    [[ -z "$OPT_MANUAL_NEW"    ]] && OPT_MANUAL_NEW="${ANS[manual_new]:-}"
    [[ -z "$OPT_MANUAL_USE"    ]] && OPT_MANUAL_USE="${ANS[manual_use]:-}"
    case "$OPT_MODE" in
        wipe|alongside|manual) ;;
        *) die "answers: mode must be wipe, alongside or manual, not '${OPT_MODE}'" ;;
    esac
    [[ -z "$OPT_PROFILE" ]] && OPT_PROFILE="${ANS[profile]:-}"
    [[ -z "$OPT_POSTINSTALL" ]] && OPT_POSTINSTALL="${ANS[postinstall]:-}"
    if (( ! OPT_OPTIONAL_SET )) && [[ -v 'ANS[optional]' ]]; then
        OPT_OPTIONAL="${ANS[optional]}"
        OPT_OPTIONAL_SET=1
    fi
    [[ -z "$OPT_SWAP"    ]] && OPT_SWAP="${ANS[swap]:-}"
    # --encrypt wins over the file the same way every other flag does, and
    # there is no --no-encrypt to undo it: the flag only ever turns encryption
    # on, so a front-end that sends encrypt=0 cannot be overruled into
    # encrypting a disk it did not ask to encrypt.
    case "${ANS[encrypt]:-0}" in
        1|yes|true) OPT_ENCRYPT=1 ;;
        0|no|false) ;;
        *) die "answers: encrypt must be 0 or 1, not '${ANS[encrypt]}'" ;;
    esac
    [[ "$OPT_FS" == "ext4" && -n "${ANS[fs]:-}" ]] && OPT_FS="${ANS[fs]}"
    [[ "$OPT_ESP_SIZE" == "${ESP_SIZE_DEFAULT}" && -n "${ANS[esp_size]:-}" ]] \
        && OPT_ESP_SIZE="${ANS[esp_size]}"
    # The flag wins, the same way every other one does -- but "skip" is the
    # flag's default rather than an instruction, so an answers file is only
    # overruled when --secure-boot actually asked for something. Getting this
    # backwards would mean a front-end that asked for signing got none of it
    # and was told nothing.
    if [[ "$OPT_SECUREBOOT" == "skip" && -n "${ANS[secureboot]:-}" ]]; then
        OPT_SECUREBOOT="${ANS[secureboot]}"
        case "$OPT_SECUREBOOT" in
            skip|sign|enroll) ;;
            *) die "answers: secureboot must be skip, sign or enroll, not '${OPT_SECUREBOOT}'" ;;
        esac
    fi
    [[ "${ANS[efi_nvram]:-0}" == "1" ]] && OPT_NVRAM=1
    # Told apart from "absent": a front-end that writes the key every time is
    # answering the question, and decide_nvram must not overrule it.
    [[ "${ANS[efi_nvram]:-}" == "0" ]] && NVRAM_DECLINED=1

    ok "Answers loaded from ${file}"
}

# =============================================================================
# Wizard
# =============================================================================

ask() {
    # ask VAR "prompt" "default"
    local __var="$1" __prompt="$2" __default="${3:-}" __reply=""
    if [[ -n "$__default" ]]; then
        read -r -p "  ${__prompt} [${__default}]: " __reply
        [[ -z "$__reply" ]] && __reply="$__default"
    else
        while [[ -z "$__reply" ]]; do
            read -r -p "  ${__prompt}: " __reply
        done
    fi
    printf -v "$__var" '%s' "$__reply"
}

ask_yn() {
    # ask_yn "prompt" "Y|N"  -> returns 0 for yes
    local prompt="$1" default="${2:-Y}" reply=""
    local hint="[Y/n]"
    [[ "$default" == "N" ]] && hint="[y/N]"
    while true; do
        read -r -p "  ${prompt} ${hint} " reply
        [[ -z "$reply" ]] && reply="$default"
        case "$reply" in
            [Yy]*) return 0 ;;
            [Nn]*) return 1 ;;
        esac
    done
}

ask_password() {
    # ask_password VAR "label"  -- reads twice, no echo, allows empty to skip
    local __var="$1" __label="$2" p1 p2
    while true; do
        read -r -s -p "  ${__label} password (leave empty to skip): " p1; echo
        if [[ -z "$p1" ]]; then
            warn "No ${__label} password set."
            printf -v "$__var" '%s' ""
            return 0
        fi
        read -r -s -p "  Repeat ${__label} password: " p2; echo
        if [[ "$p1" == "$p2" ]]; then
            printf -v "$__var" '%s' "$p1"
            return 0
        fi
        warn "Passwords do not match, try again."
    done
}

valid_username() {
    [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]
}

# Swap the size of RAM, rounded up, so hibernate has somewhere to go. Shared by
# the prompt, the answers file and --probe, so all three offer the same number.
suggested_swap() {
    local memkb memgb
    memkb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    memgb=$(( (memkb + 1048575) / 1048576 ))
    [[ $memgb -lt 1 ]] && memgb=2
    echo "${memgb}G"
}

valid_hostname() {
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]
}

# Where the zoneinfo database lives in the source tree, not on the live system:
# they are the same on the ISO but not when cloning an installed machine.
zoneinfo_dir() {
    local d="${SRC_ROOT%/}/usr/share/zoneinfo"
    [[ -d "$d" ]] && { echo "$d"; return 0; }
    [[ -d /usr/share/zoneinfo ]] && { echo /usr/share/zoneinfo; return 0; }
    return 1
}

# A default route in the kernel's table, which is what "has networking" means
# here. No tool involved: /proc/net/route is enough, and the live image does
# not promise ip(8).
have_default_route() {
    [[ -r /proc/net/route ]] || return 1
    awk 'NR > 1 && $2 == "00000000" { found = 1 } END { exit !found }' /proc/net/route
}

# Settle whether the profile's packages go in now or at first boot, and say so
# in the plan. Sets POSTINSTALL_NOW. Asked here, with the other questions,
# rather than in the middle of the install: the answer changes how long the
# install takes and whether it needs the network, both of which belong in the
# plan the user confirms.
decide_postinstall() {
    POSTINSTALL_NOW=0
    case "${OPT_POSTINSTALL:-auto}" in
        now|later|auto) ;;
        *) die "--postinstall takes now, later, or auto (got '${OPT_POSTINSTALL}')" ;;
    esac
    [[ "$INSTALL_PROFILE" == "minimal" ]] && return 0

    case "${OPT_POSTINSTALL:-auto}" in
        later) return 0 ;;
        now)
            have_default_route || warn "--postinstall now, but this session has no network; the postinstall service will do it at first boot."
            POSTINSTALL_NOW=1
            return 0
            ;;
    esac

    # auto
    if ! have_default_route; then
        info "No network here, so the ${INSTALL_PROFILE} packages will be installed at first boot."
        return 0
    fi
    if (( OPT_YES )) || (( OPT_NONINTERACTIVE )); then
        POSTINSTALL_NOW=1
        return 0
    fi
    echo
    if ask_yn "Install the ${INSTALL_PROFILE} profile's packages now, over the network? (No: at first boot)" "Y"; then
        POSTINSTALL_NOW=1
    fi
}

run_wizard() {
    phase wizard "System configuration"
    if (( OPT_NONINTERACTIVE )); then
        apply_answers
        return 0
    fi
    echo

    while true; do
        ask HOSTNAME "Hostname" "raven"
        valid_hostname "$HOSTNAME" && break
        warn "Hostnames are letters, digits and hyphens, and cannot start or end with a hyphen."
    done

    echo
    while true; do
        ask USERNAME "Username for the primary account" "raven"
        if ! valid_username "$USERNAME"; then
            warn "Usernames are lowercase letters, digits, underscore and hyphen, starting with a letter or underscore."
            continue
        fi
        if [[ "$USERNAME" == "root" ]]; then
            warn "Pick a name other than root; the root account is configured separately."
            continue
        fi
        break
    done

    ask FULLNAME "Full name for ${USERNAME} (optional)" "${USERNAME}"
    ask_password USER_PASSWORD "${USERNAME}'s"

    if ask_yn "Allow ${USERNAME} to run administrative commands with sudo?" "Y"; then
        USER_SUDO=1
    else
        USER_SUDO=0
    fi

    echo
    ask_password ROOT_PASSWORD "root"
    if [[ -z "$ROOT_PASSWORD" && -z "$USER_PASSWORD" ]]; then
        warn "Neither account has a password. Anyone with the machine can log in."
    fi

    echo
    local tzdir
    if tzdir=$(zoneinfo_dir); then
        while true; do
            ask TIMEZONE "Timezone (Region/City, or ? to list regions)" "UTC"
            if [[ "$TIMEZONE" == "?" ]]; then
                find "$tzdir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
                    | sort | column -c 70 2>/dev/null || \
                find "$tzdir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
                echo "  Then: <Region>/<City>, e.g. America/New_York. Type ?<Region> to list a region."
                continue
            fi
            if [[ "$TIMEZONE" == \?* ]]; then
                local region="${TIMEZONE#\?}"
                if [[ -d "${tzdir}/${region}" ]]; then
                    find "${tzdir}/${region}" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sort | column -c 70 2>/dev/null || true
                else
                    warn "No such region: ${region}"
                fi
                continue
            fi
            if [[ -f "${tzdir}/${TIMEZONE}" ]]; then
                break
            fi
            warn "No timezone '${TIMEZONE}' in the database."
        done
    else
        warn "No timezone database in the source tree; the clock will run on UTC."
        TIMEZONE="UTC"
    fi

    ask LOCALE "Locale" "en_US.UTF-8"
    ask KEYMAP "Console keymap" "us"

    echo
    if [[ -n "$OPT_PROFILE" ]]; then
        INSTALL_PROFILE="$OPT_PROFILE"
    else
        ask INSTALL_PROFILE "Post-install profile (minimal/desktop/developer)" "minimal"
    fi
    case "$INSTALL_PROFILE" in
        minimal|desktop|developer) ;;
        *) die "Unknown install profile: ${INSTALL_PROFILE}" ;;
    esac
    decide_postinstall

    choose_optional_apps

    echo
    if [[ -z "${OPT_SWAP}" ]]; then
        local suggested
        suggested="$(suggested_swap)"
        if ask_yn "Create a ${suggested} swap partition? (enables hibernate)" "Y"; then
            SWAP_SIZE="${suggested}"
        else
            SWAP_SIZE=""
        fi
    elif [[ "${OPT_SWAP}" == "none" ]]; then
        SWAP_SIZE=""
    else
        SWAP_SIZE="${OPT_SWAP}"
    fi

    # Asked last, and defaulting to no.
    #
    # The default is not timidity about the feature, it is about this
    # question's failure mode. Every other answer in this wizard can be got
    # wrong and fixed afterwards from a running system. This one cannot: a
    # passphrase that was mistyped, or typed on a keyboard whose layout the
    # initramfs does not have, is a disk that never opens again, and there is
    # no recovery key, no escrow and no support line. It is also the only
    # option here that has never been booted on real hardware -- see the note
    # in encrypt_partitions() -- so until it has, saying yes has to be
    # something a person did on purpose.
    echo
    if (( OPT_ENCRYPT )); then
        ENCRYPT=1
    elif ! have cryptsetup; then
        # Not asked at all rather than asked and then refused. preflight has
        # already said so for --encrypt; there is nothing to add by offering a
        # question whose only answer is no.
        info "cryptsetup is not on this image, so disk encryption is not offered."
    elif ask_yn "Encrypt this disk? (LUKS2; a passphrase is required at every boot)" "N"; then
        ENCRYPT=1
        check_encryption_support || die "Cannot encrypt this disk."
    fi
    if (( ENCRYPT )); then
        warn "There is no way to recover the data if the passphrase is lost."
        if [[ "${KEYMAP:-us}" != "us" ]]; then
            # The passphrase is typed into the initramfs, which loads no
            # keymap at all: the console is whatever the kernel came up with,
            # which is us. A passphrase containing a character that is
            # somewhere else on a ${KEYMAP} keyboard is typed correctly here,
            # stored correctly, and then cannot be entered at the one prompt
            # that matters.
            warn "The boot prompt uses a US keyboard layout, not ${KEYMAP}."
            echo "        Use characters that are in the same place on both layouts."
        fi
        # ask_password offers "leave empty to skip", which is true of the two
        # account passwords and is not true of this one -- an empty passphrase
        # is a container nobody can open, not a container anybody can. Said
        # before the prompt rather than only after an empty answer, so it is
        # read as a requirement instead of as a telling-off.
        info "This one cannot be left empty."
        while true; do
            ask_password ENCRYPT_PASSWORD "disk encryption"
            [[ -n "$ENCRYPT_PASSWORD" ]] && break
            warn "An encrypted disk needs a passphrase; there is no empty one."
        done
    fi

    ask_secure_boot
    resolve_secure_boot
}

# The Secure Boot offer.
#
# Asked only where there is something to offer, which is narrower than it
# looks: the firmware has to be in setup mode (nothing else can enrol a key
# without the firmware's own permission) and sbctl has to exist somewhere this
# script can reach. Everywhere else this says what the state is and why the
# question is not being asked -- because "the installer never mentioned it" is
# how somebody concludes RavenLinux cannot do this at all.
#
# The default is no, and the reason is the same shape as the encryption
# prompt's: of everything this installer does, enrolling a Platform Key is the
# one that changes a machine outside the disk it was pointed at.
ask_secure_boot() {
    # --secure-boot already answered it.
    [[ "$OPT_SECUREBOOT" != "skip" ]] && return 0

    if ! secureboot_tool_expected >/dev/null; then
        # Said once, quietly, and only where it would otherwise have been
        # offered: on a machine that is not in setup mode there is nothing to
        # regret about a missing tool.
        if [[ "$SECUREBOOT_SETUP" == "1" ]]; then
            echo
            info "This firmware is in Secure Boot setup mode, and the system being installed"
            info "will not have sbctl on it, so keys cannot be enrolled during the install."
            info "Install sbctl afterwards and see docs/secure-boot.md; the firmware stays"
            info "in setup mode until something enrols a key, so the window does not close."
        fi
        return 0
    fi

    if [[ "$SECUREBOOT_STATE" == "1" ]]; then
        # preflight has already printed the firmware instructions in full.
        # Nothing to ask: enrolment is impossible and signing alone would not
        # make this machine boot.
        return 0
    fi

    echo
    if [[ "$SECUREBOOT_SETUP" == "1" ]]; then
        info "This firmware is in Secure Boot setup mode: keys can be enrolled from here."
        echo "        Enrolling lets you turn Secure Boot on afterwards and still boot"
        echo "        RavenLinux. Microsoft's certificates are enrolled alongside ours,"
        echo "        so Windows and the option ROMs on your cards keep working."
        echo "        It is undone with 'sbctl reset', or by 'restore factory keys' in"
        echo "        the firmware. Kernel modules are NOT signed either way."
        if ask_yn "Enrol this machine's own Secure Boot keys and sign the bootloader?" "N"; then
            OPT_SECUREBOOT="enroll"
            return 0
        fi
    else
        info "Secure Boot is off and this firmware still holds its vendor keys,"
        info "so nothing here can enrol new ones -- that needs 'Clear Secure Boot"
        info "Keys' in the firmware first. See docs/secure-boot.md."
    fi

    # Offered in both branches, because signing is useful in both: it is
    # reversible, it changes nothing about the next boot, and it means that
    # whenever somebody does get round to enrolling keys the binaries already
    # carry a signature made by them.
    if ask_yn "Sign RavenBoot and the kernel anyway, so enrolling later is one command?" "N"; then
        OPT_SECUREBOOT="sign"
    fi
    return 0
}

# The answers file's half of run_wizard. Every value goes through the validator
# the prompt above it uses -- valid_hostname, valid_username, the zoneinfo
# lookup, the profile case -- because a front-end that lets someone type a
# hostname is one text entry away from sending "my laptop" and an installed
# machine whose /etc/hostname is not a hostname.
#
# It refuses rather than corrects. A front-end can show the message; an
# installer that quietly rewrote the answer would install a machine that does
# not match what the person confirmed on the summary page.
apply_answers() {
    HOSTNAME="${ANS[hostname]:-raven}"
    valid_hostname "$HOSTNAME" || die "answers: invalid hostname '${HOSTNAME}'"

    USERNAME="${ANS[username]:-raven}"
    valid_username "$USERNAME" || die "answers: invalid username '${USERNAME}'"
    [[ "$USERNAME" == "root" ]] && die "answers: username cannot be root"

    FULLNAME="${ANS[fullname]:-$USERNAME}"
    # It lands in a colon-separated field of /etc/passwd, so a colon in it
    # would shift every field after it by one.
    [[ "$FULLNAME" == *:* ]] && die "answers: fullname cannot contain ':'"

    USER_PASSWORD="${ANS[user_password]:-}"
    ROOT_PASSWORD="${ANS[root_password]:-}"

    case "${ANS[user_sudo]:-1}" in
        1|yes|true) USER_SUDO=1 ;;
        0|no|false) USER_SUDO=0 ;;
        *) die "answers: user_sudo must be 0 or 1" ;;
    esac

    if [[ -z "$ROOT_PASSWORD" && -z "$USER_PASSWORD" ]]; then
        warn "Neither account has a password. Anyone with the machine can log in."
    fi

    TIMEZONE="${ANS[timezone]:-UTC}"
    local tzdir
    if tzdir=$(zoneinfo_dir); then
        [[ -f "${tzdir}/${TIMEZONE}" ]] || die "answers: no timezone '${TIMEZONE}' in the database."
    else
        warn "No timezone database in the source tree; the clock will run on UTC."
        TIMEZONE="UTC"
    fi

    LOCALE="${ANS[locale]:-en_US.UTF-8}"
    KEYMAP="${ANS[keymap]:-us}"

    INSTALL_PROFILE="${OPT_PROFILE:-minimal}"
    case "$INSTALL_PROFILE" in
        minimal|desktop|developer) ;;
        *) die "answers: unknown install profile '${INSTALL_PROFILE}'" ;;
    esac
    decide_postinstall
    resolve_optional_apps

    # Same three cases as the prompt: unset means "decide for me", which here
    # is the same memory-sized default the wizard offers -- and the same rule
    # the alongside planner had to apply before this ran.
    SWAP_SIZE="$(resolve_swap_size)"

    # --encrypt has already folded `encrypt` into OPT_ENCRYPT in load_answers.
    ENCRYPT=$(( OPT_ENCRYPT ))
    ENCRYPT_PASSWORD="${ANS[encrypt_password]:-}"
    if (( ENCRYPT )); then
        # Refused rather than corrected, like every other answer here. The
        # correction available -- installing without encryption -- is not a
        # smaller version of what was asked for, it is the opposite of it, and
        # a front-end that dropped the passphrase field would otherwise ship
        # an install that silently is not encrypted.
        [[ -n "$ENCRYPT_PASSWORD" ]] || die "answers: encrypt=1 needs a non-empty encrypt_password"
    elif [[ -n "$ENCRYPT_PASSWORD" ]]; then
        warn "answers: encrypt_password given but encrypt is not 1; the disk will NOT be encrypted."
    fi

    ok "Hostname: ${HOSTNAME}"
    ok "User: ${USERNAME}${FULLNAME:+ (${FULLNAME})}"
    ok "Timezone: ${TIMEZONE}, locale ${LOCALE}, keymap ${KEYMAP}"
    ok "Profile: ${INSTALL_PROFILE}, swap: ${SWAP_SIZE:-none}"
    ok "Optional apps: $(optional_names)"

    resolve_secure_boot
}

# The one Secure Boot answer that has to be refused rather than warned about.
#
# Enrolment needs the firmware to be in setup mode, and that is a fact about
# the machine this is running on, known now, and not something the install can
# change. Quietly downgrading it to "sign" would leave somebody believing their
# machine is ready for Secure Boot to be switched on when the firmware has
# never heard of their key -- and they would find out at the next boot, which
# is a boot that does not happen. So this stops, here, before the first write.
#
# Everything else is a warning: whether sbctl actually reaches the new system
# is not settled until the packages are in, and an install that is otherwise
# correct should not be aborted over a signature it can be given afterwards.
resolve_secure_boot() {
    [[ "$OPT_SECUREBOOT" == "skip" ]] && return 0

    if [[ "$OPT_SECUREBOOT" == "enroll" && "$SECUREBOOT_SETUP" != "1" ]]; then
        if [[ "$SECUREBOOT_STATE" == "1" ]]; then
            die "secureboot=enroll, but Secure Boot is switched ON in this firmware.
       Nothing running under an enforcing firmware may replace its Platform
       Key. Turn Secure Boot off, clear the Secure Boot keys in the same
       firmware menu -- that is what puts it in setup mode -- and run this
       again. docs/secure-boot.md walks through it."
        fi
        die "secureboot=enroll, but this firmware is not in setup mode.
       It still holds a Platform Key -- its vendor's -- and will refuse to let
       anything here write another. Clear the Secure Boot keys in the firmware
       setup ('Clear Secure Boot Keys' under Key Management on most ASUS
       boards), leave Secure Boot off, and run this again. Use
       secureboot=sign if you only want the binaries signed for later.
       docs/secure-boot.md walks through it."
    fi

    local where
    if ! where="$(secureboot_tool_expected)"; then
        warn "secureboot=${OPT_SECUREBOOT}, but the installed system will not have sbctl."
        echo "        The install goes ahead; nothing is signed and no key is enrolled."
        echo "        Add sbctl afterwards (it is in the desktop and developer profiles)"
        echo "        and follow docs/secure-boot.md. The firmware stays in setup mode"
        echo "        until something enrols a key, so nothing is lost by waiting."
    elif [[ "$where" == "profile" ]]; then
        info "sbctl comes with the ${INSTALL_PROFILE} profile, which is being installed now."
        info "If that install fails, Secure Boot is skipped and the run says so."
    fi
    return 0
}

# =============================================================================
# Confirmation
# =============================================================================

ESP_DEV=""
SWAP_DEV=""
ROOT_DEV=""
ROOT_ALONGSIDE_BYTES=0

# Encryption, decided by run_wizard or apply_answers before confirm() prints
# the plan.
#
# ROOT_DEV and SWAP_DEV keep meaning "the device the root filesystem and the
# swap signature live on", and on an encrypted install that is the mapper node,
# not the partition. encrypt_partitions() does the swap, once, right after it
# opens the containers -- so mkfs, mkswap, the mount, uuid_of, write_fstab and
# the root=UUID= on the kernel command line all go on saying exactly what they
# said before and all of them come out right. The partitions underneath are
# kept here because three things still need them: luksUUID for the
# cryptdevice= argument, the crypttab, and anything that has to close the
# container again.
ENCRYPT=0
ENCRYPT_PASSWORD=""
ROOT_CRYPT_PART=""     # the partition holding the root container
SWAP_CRYPT_PART=""     # the partition holding the swap container
ROOT_CRYPT_UUID=""     # LUKS header UUID, which is what cryptdevice= names
SWAP_CRYPT_UUID=""

plan_partitions() {
    if [[ "$OPT_MODE" == "manual" ]]; then
        plan_manual
        return 0
    fi
    if [[ "$OPT_MODE" == "alongside" ]]; then
        # Every number in the alongside plan comes off the disk that is
        # already there, so the plan cannot be written down until it has been
        # read. plan_alongside dies with a reason rather than returning one.
        plan_alongside
        # The device nodes do not exist yet and their numbers are sfdisk's to
        # choose, so there is nothing to name here -- partition_alongside
        # fills ROOT_DEV and SWAP_DEV in once the table has been written.
        return 0
    fi

    local n=1
    ESP_DEV="$(partdev "$DISK" $n)"; n=$((n + 1))
    if [[ -n "$SWAP_SIZE" ]]; then
        SWAP_DEV="$(partdev "$DISK" $n)"; n=$((n + 1))
    fi
    ROOT_DEV="$(partdev "$DISK" $n)"
}

# =============================================================================
# Manual partitioning
# =============================================================================
# The person decides the layout; this checks it, prints it, and carries it out.
# Three lists, from --delete/--new/--use or the answers file's manual_* keys:
#
#   delete  PART,PART,...           removed from the table first
#   new     START:SECTORS:ROLE;...  created in what is free after the deletes
#   use     PART:ROLE:ACTION;...    existing partitions put to work
#
# ROLE is root, home, swap or esp. ACTION is keep or format; root is always
# formatted, and a new partition always is. Anything not named is not touched.
#
# Everything is validated here, before a byte is written, against the table as
# it is read now -- the front-end's arithmetic is a proposal, not an authority.

MANUAL_DELETE=()        # partition nodes
MANUAL_NEW=()           # "start sectors role"
MANUAL_USE=()           # "node role action"
ESP_FORMAT=0            # 1 when the ESP is created or reformatted here
SWAP_KEEP=0             # 1 when an existing swap is used as it is
HOME_DEV=""
HOME_KEPT=0             # 1 when /home is an existing filesystem left intact
ESP_NEEDS_TYPE=""       # an existing partition made the ESP that is not typed as one

MANUAL_MIN_ESP="$(( 200 * 1024 * 1024 ))"

# The table as it would be after the deletes: DISK_TABLE minus those rows.
manual_kept_rows() {
    local node start size type d skip
    while IFS=$'\t' read -r node start size type; do
        [[ -z "$node" ]] && continue
        skip=0
        for d in "${MANUAL_DELETE[@]}"; do [[ "$d" == "$node" ]] && skip=1; done
        (( skip )) || printf '%s\t%s\t%s\t%s\n' "$node" "$start" "$size" "$type"
    done < <(table_rows)
}

# Is this node, or anything on it, in use by the running system?
part_in_use() {
    local node="$1"
    findmnt -no TARGET --source "$node" >/dev/null 2>&1 && return 0
    awk 'NR > 1 { print $1 }' /proc/swaps 2>/dev/null | grep -qxF -- "$node" && return 0
    return 1
}

role_label() {
    case "$1" in
        root) echo "/ (root)" ;;
        home) echo "/home" ;;
        swap) echo "swap" ;;
        esp)  echo "EFI System Partition -> /boot/efi" ;;
    esac
}

plan_manual() {
    MANUAL_DELETE=(); MANUAL_NEW=(); MANUAL_USE=()
    ESP_REUSED=0; ESP_FORMAT=0; SWAP_KEEP=0; HOME_KEPT=0; ESP_NEEDS_TYPE=""
    ESP_DEV=""; ROOT_DEV=""; SWAP_DEV=""; HOME_DEV=""; SWAP_SIZE=""

    read_disk_table "$DISK" \
        || die "${DISK} has no partition table. Manual partitioning edits an existing
       GPT; use --wipe to lay a fresh one down."
    [[ "${DISK_LABEL,,}" == "gpt" ]] \
        || die "${DISK} is ${DISK_LABEL:-MBR}, not GPT. Manual partitioning needs a GPT
       disk, because RavenBoot is a UEFI loader. Use --wipe to convert it (erasing it)."

    local item node start size type role action
    local -A all_nodes=()
    while IFS=$'\t' read -r node start size type; do
        [[ -n "$node" ]] && all_nodes["$node"]=1
    done < <(table_rows)

    # -- deletes ---------------------------------------------------------------
    local -a list=()
    IFS=',' read -r -a list <<< "${OPT_MANUAL_DELETE// /}"
    for node in "${list[@]}"; do
        [[ -z "$node" ]] && continue
        [[ -n "${all_nodes[$node]:-}" ]] || die "manual: ${node} is not a partition on ${DISK}"
        part_in_use "$node" && die "manual: ${node} is mounted or in use as swap; it cannot be deleted"
        MANUAL_DELETE+=("$node")
    done

    local kept; kept="$(manual_kept_rows)"
    local -A kept_nodes=()
    while IFS=$'\t' read -r node _; do
        [[ -n "$node" ]] && kept_nodes["$node"]=1
    done <<< "$kept"

    local -A role_count=([root]=0 [home]=0 [swap]=0 [esp]=0)

    # -- existing partitions put to work ----------------------------------------
    IFS=';' read -r -a list <<< "${OPT_MANUAL_USE}"
    for item in "${list[@]}"; do
        item="${item// /}"
        [[ -z "$item" ]] && continue
        IFS=':' read -r node role action <<< "$item"
        [[ -n "${kept_nodes[$node]:-}" ]] \
            || die "manual: ${node} is not on ${DISK}, or is also being deleted"
        part_in_use "$node" && die "manual: ${node} is mounted or in use as swap"
        local fstype; fstype="$(fs_type_of "$node")"
        case "$role" in
            root)
                [[ "${action:-format}" == "format" ]] \
                    || die "manual: the root partition is always formatted; ${node} cannot be kept"
                ROOT_DEV="$node" ;;
            home)
                case "${action:-}" in
                    keep)
                        [[ -n "$fstype" ]] || die "manual: ${node} has no filesystem to keep as /home"
                        case "$fstype" in
                            ext2|ext3|ext4|xfs|btrfs) ;;
                            *) die "manual: ${node} is ${fstype}; /home has to be a Linux filesystem (or formatted)" ;;
                        esac
                        HOME_KEPT=1 ;;
                    format) HOME_KEPT=0 ;;
                    *) die "manual: ${node}: /home needs keep or format" ;;
                esac
                HOME_DEV="$node" ;;
            swap)
                case "${action:-format}" in
                    keep)
                        [[ "$fstype" == "swap" ]] || die "manual: ${node} is not a swap partition; format it instead"
                        SWAP_KEEP=1 ;;
                    format) SWAP_KEEP=0 ;;
                    *) die "manual: ${node}: swap needs keep or format" ;;
                esac
                SWAP_DEV="$node" ;;
            esp)
                case "${action:-keep}" in
                    keep)
                        [[ "$fstype" == "vfat" ]] \
                            || die "manual: ${node} is ${fstype:-unformatted}, not FAT; an ESP to keep has to be FAT already"
                        local efree; efree="$(esp_free_bytes "$node")"
                        if [[ -n "$efree" ]] && (( efree < ESP_MIN_FREE )); then
                            die "manual: ${node} has only $(to_human "$efree") free, and RavenBoot with its kernel
       needs $(to_human "$ESP_MIN_FREE"). Create a new EFI System Partition for RavenLinux
       in free space instead; a boot entry will point the firmware at it."
                        fi
                        ESP_REUSED=1; ESP_FORMAT=0 ;;
                    format) ESP_REUSED=0; ESP_FORMAT=1 ;;
                    *) die "manual: ${node}: esp needs keep or format" ;;
                esac
                local ptype; ptype="$(part_field "$node" type)"
                [[ "${ptype^^}" == "$GUID_ESP" ]] || ESP_NEEDS_TYPE="$node"
                (( $(part_field "$node" size) * DISK_SECTOR >= MANUAL_MIN_ESP )) || (( ESP_REUSED )) \
                    || die "manual: ${node} is smaller than $(to_human $MANUAL_MIN_ESP), too small for an ESP"
                ESP_DEV="$node" ;;
            *) die "manual: unknown role '${role}' for ${node} (root, home, swap or esp)" ;;
        esac
        role_count[$role]=$(( role_count[$role] + 1 ))
        MANUAL_USE+=("${node} ${role} ${action:-format}")
    done

    # -- new partitions ---------------------------------------------------------
    local a=$(( ALIGN_BYTES / DISK_SECTOR )); (( a < 1 )) && a=1
    local occupied; occupied="$(cut -f2,3 <<< "$kept")"
    IFS=';' read -r -a list <<< "${OPT_MANUAL_NEW}"
    for item in "${list[@]}"; do
        item="${item// /}"
        [[ -z "$item" ]] && continue
        IFS=':' read -r start size role <<< "$item"
        [[ "$start" =~ ^[0-9]+$ && "$size" =~ ^[0-9]+$ ]] \
            || die "manual: '${item}' is not START:SECTORS:ROLE"
        (( size > 0 )) || die "manual: '${item}' has no size"
        (( start % a == 0 )) || die "manual: ${start} is not on a 1 MiB boundary"
        (( start >= DISK_FIRST_LBA && start + size - 1 <= DISK_LAST_LBA )) \
            || die "manual: ${start}+${size} is outside ${DISK}'s usable sectors (${DISK_FIRST_LBA}-${DISK_LAST_LBA})"
        local os oz
        while read -r os oz; do
            [[ -z "$os" ]] && continue
            if (( start < os + oz && os < start + size )); then
                die "manual: the new ${role} at sector ${start} overlaps a partition that is being kept"
            fi
        done <<< "${occupied//$'\t'/ }"
        case "$role" in
            root|home|swap) ;;
            esp) (( size * DISK_SECTOR >= MANUAL_MIN_ESP )) \
                    || die "manual: a new ESP needs at least $(to_human $MANUAL_MIN_ESP)"
                 ESP_REUSED=0; ESP_FORMAT=1 ;;
            *) die "manual: unknown role '${role}' for a new partition (root, home, swap or esp)" ;;
        esac
        [[ "$role" == "home" ]] && HOME_KEPT=0
        [[ "$role" == "swap" ]] && SWAP_KEEP=0
        role_count[$role]=$(( role_count[$role] + 1 ))
        MANUAL_NEW+=("${start} ${size} ${role}")
        occupied+=$'\n'"${start}"$'\t'"${size}"
    done

    # -- the whole ------------------------------------------------------------------
    (( role_count[root] == 1 )) || die "manual: exactly one partition must be the root (have ${role_count[root]})"
    (( role_count[esp]  == 1 )) || die "manual: exactly one partition must be the EFI System Partition (have ${role_count[esp]})"
    (( role_count[home] <= 1 )) || die "manual: more than one partition is /home"
    (( role_count[swap] <= 1 )) || die "manual: more than one partition is swap"

    # Our own ESP while another one stays on the disk: that other one belongs
    # to an OS whose boot entry comes first, so ours needs an entry too.
    ESP_OWN=0
    if (( ! ESP_REUSED )); then
        while IFS=$'\t' read -r node start size type; do
            [[ -z "$node" || "$node" == "$ESP_DEV" ]] && continue
            [[ "${type^^}" == "$GUID_ESP" ]] && { ESP_OWN=1; break; }
        done <<< "$kept"
    fi

    # Root size: new or existing, it has to hold the system with room to spare.
    local root_sectors=0
    if [[ -n "$ROOT_DEV" ]]; then
        root_sectors=$(part_field "$ROOT_DEV" size)
    else
        for item in "${MANUAL_NEW[@]}"; do
            read -r start size role <<< "$item"
            [[ "$role" == "root" ]] && root_sectors=$size
        done
    fi
    ROOT_ALONGSIDE_BYTES=$(( root_sectors * DISK_SECTOR ))
    local src_mb=0
    [[ -n "$SRC_ROOT" ]] && src_mb=$(du -sm --one-file-system "$SRC_ROOT" 2>/dev/null | awk '{print $1}')
    [[ "$src_mb" =~ ^[0-9]+$ ]] || src_mb=0
    local need=$(( (src_mb + src_mb / 10) * 1024 * 1024 ))
    (( ROOT_ALONGSIDE_BYTES >= need )) \
        || die "manual: the root partition is $(to_human $ROOT_ALONGSIDE_BYTES); the system alone needs $(to_human $need)"
    (( ROOT_ALONGSIDE_BYTES >= ALONGSIDE_MIN_ROOT )) \
        || warn "The root partition is under $(to_human $ALONGSIDE_MIN_ROOT); it will fill up quickly."

    # For the summary. The swap size is informational here: it is the partition.
    if [[ -n "$SWAP_DEV" ]]; then
        SWAP_SIZE="$(to_human $(( $(part_field "$SWAP_DEV" size) * DISK_SECTOR )))"
    else
        for item in "${MANUAL_NEW[@]}"; do
            read -r start size role <<< "$item"
            [[ "$role" == "swap" ]] && SWAP_SIZE="$(to_human $(( size * DISK_SECTOR )))"
        done
    fi
}

print_manual_plan() {
    local item node role action start size
    if (( ${#MANUAL_DELETE[@]} )); then
        echo
        for node in "${MANUAL_DELETE[@]}"; do
            printf '      %-16s %-10s deleted  (%s)\n' "$node" \
                "$(to_human $(( $(part_field "$node" size) * DISK_SECTOR )))" "$(part_os_hint "$node")"
        done
    fi
    echo
    for item in "${MANUAL_USE[@]}"; do
        read -r node role action <<< "$item"
        [[ "$role" == "root" ]] && action="format (${OPT_FS})"
        [[ "$role" == "home" && "$action" == "format" ]] && action="format (${OPT_FS})"
        printf '      %-16s %-10s %-8s -> %s\n' "$node" \
            "$(to_human $(( $(part_field "$node" size) * DISK_SECTOR )))" "$action" "$(role_label "$role")"
    done
    for item in "${MANUAL_NEW[@]}"; do
        read -r start size role <<< "$item"
        printf '      %-16s %-10s %-8s -> %s\n' "new @${start}" \
            "$(to_human $(( size * DISK_SECTOR )))" "create" "$(role_label "$role")"
    done
    [[ -n "$ESP_NEEDS_TYPE" ]] && printf '\n      %s is retyped as an EFI System Partition\n' "$ESP_NEEDS_TYPE"
    echo
    echo "    Every other partition on ${DISK} is left exactly as it is."
}

# The node whose partition starts at sector $1.
part_by_start() {
    table_rows | awk -F'\t' -v s="$1" '$2 == s { print $1; exit }'
}

partition_manual() {
    phase partition "Applying the partition plan to ${DISK}"

    if (( ${#MANUAL_DELETE[@]} == 0 && ${#MANUAL_NEW[@]} == 0 )) && [[ -z "$ESP_NEEDS_TYPE" ]]; then
        ok "Partition table unchanged"
        return 0
    fi

    DISK_DIRTY=1
    local node nums=() item start size role type name lines=""

    if (( ${#MANUAL_DELETE[@]} )); then
        for node in "${MANUAL_DELETE[@]}"; do nums+=("${node##*[!0-9]}"); done
        sfdisk --delete --no-reread -q "$DISK" "${nums[@]}" >/dev/null 2>&1 \
            || die "sfdisk could not delete ${MANUAL_DELETE[*]} from ${DISK}."
        ok "Deleted ${MANUAL_DELETE[*]}"
    fi

    if (( ${#MANUAL_NEW[@]} )); then
        for item in "${MANUAL_NEW[@]}"; do
            read -r start size role <<< "$item"
            case "$role" in
                root) type="$GUID_LINUX"; name="$ROOT_LABEL" ;;
                home) type="$GUID_LINUX"; name="$HOME_LABEL" ;;
                swap) type="$GUID_SWAP";  name="$SWAP_LABEL" ;;
                esp)  type="$GUID_ESP";   name="$ESP_LABEL" ;;
            esac
            lines+="start=${start}, size=${size}, type=${type}, name=\"${name}\""$'\n'
        done
        printf '%s' "$lines" \
            | sfdisk --append --no-reread -w never -W never -q "$DISK" >/dev/null 2>&1 \
            || die "sfdisk could not create the new partitions on ${DISK}."
        ok "Created ${#MANUAL_NEW[@]} partition(s)"
    fi

    if [[ -n "$ESP_NEEDS_TYPE" ]]; then
        sfdisk --part-type --no-reread -q "$DISK" "${ESP_NEEDS_TYPE##*[!0-9]}" "$GUID_ESP" >/dev/null 2>&1 \
            || die "sfdisk could not mark ${ESP_NEEDS_TYPE} as an EFI System Partition."
        ok "${ESP_NEEDS_TYPE} marked as an EFI System Partition"
    fi

    sync
    partx -u "$DISK" >/dev/null 2>&1 || blockdev --rereadpt "$DISK" >/dev/null 2>&1 || true
    have udevadm && udevadm settle --timeout=10 >/dev/null 2>&1

    # New partitions are found by where they start. Their numbers are sfdisk's
    # choice, and a GPT name is not unique when an earlier RavenLinux is kept.
    read_disk_table "$DISK" || die "Cannot re-read ${DISK}'s partition table."
    for item in "${MANUAL_NEW[@]}"; do
        read -r start size role <<< "$item"
        node="$(part_by_start "$start")"
        [[ -n "$node" ]] || die "The new ${role} partition at sector ${start} cannot be found on ${DISK}."
        case "$role" in
            root) ROOT_DEV="$node" ;;
            home) HOME_DEV="$node" ;;
            swap) SWAP_DEV="$node" ;;
            esp)  ESP_DEV="$node" ;;
        esac
    done

    local waited=0 d
    for d in "$ROOT_DEV" "$ESP_DEV" "$SWAP_DEV" "$HOME_DEV"; do
        [[ -z "$d" ]] && continue
        while [[ ! -b "$d" ]]; do
            sleep 1
            waited=$((waited + 1))
            (( waited >= 15 )) && die "Partition node ${d} did not appear"
        done
    done
    ok "Partition devices ready"
}

# /home goes on after the copy, never before it: the live tree's own /home
# would otherwise be copied onto a partition that is being kept for its data.
mount_home() {
    [[ -n "${HOME_DEV:-}" ]] || return 0
    local live="${TARGET}/home.raven-live"
    rm -rf "$live"
    mv "${TARGET}/home" "$live" 2>/dev/null || true
    mkdir -p "${TARGET}/home"
    mount "$HOME_DEV" "${TARGET}/home" || die "Cannot mount ${HOME_DEV} on /home"
    if (( ! HOME_KEPT )) && [[ -d "$live" ]]; then
        cp -a "${live}/." "${TARGET}/home/" 2>/dev/null || true
    fi
    rm -rf "$live"
    ok "${HOME_DEV} mounted as /home$( (( HOME_KEPT )) && echo ', existing data kept')"
}

# Which of the partitioners runs. Named for what it does rather than for
# how, so main() reads the same whichever mode it is in.
partition_target() {
    if [[ "$OPT_MODE" == "manual" ]]; then
        partition_manual
    elif [[ "$OPT_MODE" == "alongside" ]]; then
        partition_alongside
    else
        partition_disk
    fi
}

confirm() {
    plan_partitions
    decide_nvram

    # Checked here because here is the last point at which the mode, the
    # partition plan and the encryption answer are all settled and nothing has
    # been written yet.
    #
    # Manual mode is refused rather than half-supported. Its whole purpose is
    # reusing partitions that are already there -- an ESP shared with another
    # OS, a /home whose data survives, an existing swap kept as it is -- and
    # each of those is a plaintext filesystem that encrypting the root does
    # nothing for. A "manual, encrypted" install would quietly produce a
    # machine whose home directory is in the clear on a disk its owner has
    # been told is encrypted, which is worse than not offering it.
    if (( ENCRYPT )) && [[ "$OPT_MODE" == "manual" ]]; then
        die "Encryption is not supported with manual partitioning yet.
       Manual mode exists to reuse partitions that are already on the disk --
       a shared ESP, an existing /home, an existing swap -- and those stay
       unencrypted, so the result would not be an encrypted machine. Use
       --wipe or --alongside with encryption, or manual without it."
    fi

    phase confirm "Installation plan"

    if [[ "$OPT_MODE" == "manual" ]]; then
        cat <<PLAN

    Disk           ${DISK} (${DISK_SIZE}${DISK_MODEL:+, ${DISK_MODEL}})
    Partitioning   Manual
PLAN
        print_manual_plan
    elif [[ "$OPT_MODE" == "alongside" ]]; then
        cat <<PLAN

    Disk           ${DISK} (${DISK_SIZE}${DISK_MODEL:+, ${DISK_MODEL}})
    Partitioning   Alongside what is already installed
PLAN
        if [[ -n "$SHRINK_DEV" ]]; then
            printf '\n      %s is shrunk\n' "$SHRINK_DEV"
            printf '        %-24s %s\n' "now"       "$(to_human $(( SHRINK_OLD_SECTORS * DISK_SECTOR )))"
            printf '        %-24s %s\n' "after"     "$(to_human "$SHRINK_NEW_BYTES")"
            printf '        %-24s %s\n' "in use"    "$(to_human "$SHRINK_MIN_BYTES")"
            printf '        %-24s %s\n' "holds"     "$(part_os_hint "$SHRINK_DEV")"
            echo   "        its data is kept; only the free space at the end is taken"
        else
            printf '\n      %s of unallocated space is used\n' "$(to_human $(( GAP_SECTORS * DISK_SECTOR )))"
        fi

        if (( ${ESP_OWN:-0} )); then
            printf '\n      new           %-8s EFI System Partition for RavenLinux\n' "$OPT_ESP_SIZE"
            printf '      %s  the other OS'"'"'s ESP, too full to share -- not touched\n' "$ESP_DEV"
        else
            printf '\n      %s  reused as the EFI System Partition (not formatted)\n' "$ESP_DEV"
        fi
        [[ -n "$SWAP_SIZE" ]] && printf '      new           %-8s swap\n' "$SWAP_SIZE"
        printf '      new           %-8s %s -> /\n' "$(to_human "$ROOT_ALONGSIDE_BYTES")" "$OPT_FS"

        echo
        echo "    Every other partition on ${DISK} is left exactly as it is."
        cat <<PLAN
PLAN
    else
        cat <<PLAN

    Disk           ${DISK} (${DISK_SIZE}${DISK_MODEL:+, ${DISK_MODEL}})
    Partitioning   GPT, erasing everything on the disk

      ${ESP_DEV}   ${OPT_ESP_SIZE}  EFI System Partition (FAT32) -> /boot/efi
PLAN
        # %-4s keeps the size column lined up with the 512M and "rest" above.
        [[ -n "$SWAP_DEV" ]] && printf '      %s   %-4s  swap\n' "$SWAP_DEV" "$SWAP_SIZE"
        printf '      %s   rest  %s -> /\n' "$ROOT_DEV" "$OPT_FS"
    fi

    if [[ "${OPT_FS}" == "btrfs" ]]; then
        # On the plan because it is the half of a btrfs install that is
        # invisible everywhere else until the day it matters: which
        # directories a rollback will rewind and which it will leave alone.
        # BTRFS_SUBVOLS is the same list create_btrfs_layout() builds from, so
        # what is printed here cannot drift from what is created.
        local sv sv_name sv_label="    Subvolumes  "
        echo
        for sv in "${BTRFS_SUBVOLS[@]}"; do
            sv_name="${sv%%:*}"
            [[ "$sv_name" == "@home" && -n "${HOME_DEV:-}" ]] && continue
            printf '%s   %-11s -> %-12s %s\n' \
                "$sv_label" "$sv_name" "${sv#*:}" "${BTRFS_SUBVOL_NOTES[$sv_name]:-}"
            sv_label="                "
        done
        printf '    Mount options  %s\n' "$(btrfs_root_flags)"
    fi

    if (( ENCRYPT )); then
        # An alongside install has no device names yet -- the partition
        # numbers are sfdisk's to choose and partition_alongside fills them in
        # afterwards -- so the plan says what is encrypted rather than which
        # node it will be.
        printf '\n    Encryption     LUKS2 (argon2id) on %s\n' "${ROOT_DEV:-the new root partition}"
        if [[ -n "$SWAP_DEV" || -n "$SWAP_SIZE" ]]; then
            printf '                   and on %s, so the hibernation image is encrypted too\n' \
                "${SWAP_DEV:-the new swap partition}"
        fi
        printf '                   One passphrase opens both, and is asked for at every boot.\n'
        printf '                   %sThere is no recovery key. A lost passphrase is lost data.%s\n' "$YELLOW" "$NC"
    fi

    cat <<PLAN

    Hostname       ${HOSTNAME}
    User           ${USERNAME}${FULLNAME:+ (${FULLNAME})}$([[ $USER_SUDO -eq 1 ]] && echo ", may use sudo via wheel")
    root password  $([[ -n "$ROOT_PASSWORD" ]] && echo "set" || echo "${YELLOW}not set${NC}")
    Timezone       ${TIMEZONE}
    Locale         ${LOCALE}
    Keymap         ${KEYMAP}
    Package profile ${INSTALL_PROFILE} (applied later with raven-postinstall)
    Optional apps  $(optional_names)
    Bootloader     RavenBoot at \\EFI\\raven and \\EFI\\BOOT\\BOOTX64.EFI$([[ $OPT_NVRAM -eq 1 ]] && echo ", plus an NVRAM entry")
    Secure Boot    $(secure_boot_plan_line)

PLAN

    if [[ "$OPT_MODE" != "wipe" ]] && disk_has_bitlocker "$DISK"; then
        warn "Windows on ${DISK} is encrypted with BitLocker."
        echo "        Booting it through RavenBoot changes what the TPM measured, so Windows"
        echo "        will ask for its BitLocker recovery key once. Have the key ready"
        echo "        (aka.ms/myrecoverykey), or suspend BitLocker in Windows before installing."
        echo
    fi

    if [[ $OPT_DRY_RUN -eq 1 ]]; then
        echo "  ${CYAN}--dry-run: stopping here. Nothing has been written.${NC}"
        echo
        cleanup
        trap - EXIT
        exit 0
    fi

    if (( OPT_NONINTERACTIVE )); then
        # The front-end owns the confirmation. It has the same plan on screen --
        # it built every line of it -- and a typed YES on a terminal nobody is
        # looking at would just be an install that never starts.
        info "Non-interactive: the plan above was confirmed by the front-end."
        return 0
    fi

    if [[ $OPT_YES -eq 1 ]]; then
        warn "--yes given; proceeding without confirmation."
        return 0
    fi

    if [[ "$OPT_MODE" == "manual" ]]; then
        echo "  ${YELLOW}The partitions marked delete or format above lose everything on them.${NC}"
    elif [[ "$OPT_MODE" == "alongside" ]]; then
        if [[ -n "$SHRINK_DEV" ]]; then
            echo "  ${YELLOW}${SHRINK_DEV} will be resized. Back up anything on it you cannot lose.${NC}"
        else
            echo "  ${YELLOW}${DISK}'s partition table will be changed.${NC}"
        fi
    else
        echo "  ${RED}Everything on ${DISK} will be destroyed.${NC}"
    fi
    echo
    local reply=""
    read -r -p "  Type YES to install, anything else to abort: " reply
    [[ "$reply" == "YES" ]] || die "Aborted at confirmation. Nothing was written."
}

# =============================================================================
# Partition and format
# =============================================================================

# Makes the room, then takes it. Ordered so that every step that can fail
# without consequence happens before the first one that cannot.
partition_alongside() {
    local fstype
    [[ -n "$SHRINK_DEV" ]] && fstype=$(fs_type_of "$SHRINK_DEV")

    if [[ -n "$SHRINK_DEV" ]]; then
        phase partition "Shrinking ${SHRINK_DEV}"

        # The filesystem check is not optional and is not just hygiene. Both
        # resizers refuse to shrink a filesystem they have not verified, and
        # finding out here -- before anything has been written -- is the
        # difference between an install that stops and one that stops halfway.
        case "$fstype" in
            ext2|ext3|ext4)
                # e2fsck's exit status is a bitfield: 1 is "errors corrected",
                # 2 is "corrected, reboot suggested", and neither is a reason
                # to stop. 4 and up mean errors it left alone.
                e2fsck -f -p "$SHRINK_DEV" >/dev/null 2>&1
                local rc=$?
                (( rc < 4 )) || die "e2fsck found errors on ${SHRINK_DEV} it could not fix (status ${rc}).
       Nothing has been written. Repair it and run the installer again."
                ;;
            ntfs)
                ntfsresize --info --force "$SHRINK_DEV" >/dev/null 2>&1 \
                    || die "ntfsresize will not read ${SHRINK_DEV}.
       Nothing has been written. Boot Windows and shut it down fully first."
                ;;
        esac
        ok "${SHRINK_DEV}: filesystem checked"

        # From here the disk is being changed. The filesystem goes first: a
        # filesystem smaller than its partition is a working filesystem, and a
        # partition smaller than its filesystem is a lost one -- so if only one
        # of the two steps happens, it has to be this one.
        DISK_DIRTY=1
        case "$fstype" in
            ext2|ext3|ext4)
                resize2fs "$SHRINK_DEV" "$(( SHRINK_NEW_BYTES / 1024 ))K" >/dev/null 2>&1 \
                    || die "resize2fs failed on ${SHRINK_DEV}. The filesystem is unchanged."
                ;;
            ntfs)
                # ntfsresize asks for a confirmation on a terminal even with
                # --force. The plan it is confirming is the one already shown
                # and agreed to, and there is no terminal here on the
                # non-interactive path.
                printf 'y\n' | ntfsresize --force --no-progress-bar \
                    --size "${SHRINK_NEW_BYTES}" "$SHRINK_DEV" >/dev/null 2>&1 \
                    || die "ntfsresize failed on ${SHRINK_DEV}. The filesystem is unchanged."
                ;;
        esac
        ok "${SHRINK_DEV}: filesystem now $(to_human "$SHRINK_NEW_BYTES")"

        # And now the partition, to the boundary the filesystem has already
        # moved behind. Signature wiping is off in both directions: -w would
        # erase the filesystem this just carefully preserved.
        local start; start=$(part_field "$SHRINK_DEV" start)
        printf 'start=%s, size=%s\n' "$start" "$SHRINK_NEW_SECTORS" \
            | sfdisk -N "${SHRINK_DEV##*[!0-9]}" --no-reread -w never -W never -q "$DISK" >/dev/null 2>&1 \
            || die "sfdisk could not resize ${SHRINK_DEV}.
       The filesystem on it is already smaller, so nothing has been lost --
       but the partition still claims the old size. Re-run the installer."
        ok "${SHRINK_DEV}: partition now $(to_human "$SHRINK_NEW_BYTES")"
    fi

    phase partition "Adding RavenLinux to ${DISK}"
    DISK_DIRTY=1

    printf '%s' "$ALONGSIDE_PARTS" \
        | sfdisk --append --no-reread -w never -W never -q "$DISK" >/dev/null 2>&1 \
        || die "sfdisk could not add the new partitions to ${DISK}."
    ok "Partitions added"

    sync
    partx -u "$DISK" >/dev/null 2>&1 || blockdev --rereadpt "$DISK" >/dev/null 2>&1 || true
    have udevadm && udevadm settle --timeout=10 >/dev/null 2>&1

    # Which numbers they got is sfdisk's decision, not ours: --append fills the
    # lowest free slots in the table, so a disk with a hole in its numbering
    # gets partitions whose numbers have nothing to do with where they sit.
    # They are found by the name written above instead.
    # Found by where they start rather than by name: an earlier RavenLinux on
    # the same disk has partitions called RAVEN_ROOT too.
    read_disk_table "$DISK" || die "Cannot re-read ${DISK}'s partition table."
    ROOT_DEV=$(part_by_start "$ROOT_START")
    [[ -n "$ROOT_DEV" ]] || die "The root partition was created but cannot be found on ${DISK}."
    if [[ -n "$SWAP_SIZE" ]]; then
        SWAP_DEV=$(part_by_start "$SWAP_START")
        [[ -n "$SWAP_DEV" ]] || die "The swap partition was created but cannot be found on ${DISK}."
    fi
    if (( ${ESP_OWN:-0} )); then
        ESP_DEV=$(part_by_start "$ESP_START")
        [[ -n "$ESP_DEV" ]] || die "The new EFI partition was created but cannot be found on ${DISK}."
    fi

    local waited=0
    while [[ ! -b "$ROOT_DEV" ]] || { [[ -n "$SWAP_DEV" ]] && [[ ! -b "$SWAP_DEV" ]]; }; do
        sleep 1
        waited=$((waited + 1))
        [[ $waited -ge 15 ]] && die "Partition nodes did not appear (${ROOT_DEV}${SWAP_DEV:+, ${SWAP_DEV}})"
    done
    ok "Partition devices ready"
}

# The node whose GPT name is $1. Names are ours -- RAVEN_ROOT and RAVEN_SWAP --
# and set in the same script that creates the partitions.
part_by_name() {
    local want="$1"
    awk -v want="$want" '
        /name="/ {
            if (match($0, /name="[^"]*"/)) {
                n = substr($0, RSTART + 6, RLENGTH - 7)
                if (n == want) { print $1; exit }
            }
        }
    ' <<< "$DISK_TABLE"
}

partition_disk() {
    phase partition "Partitioning ${DISK}"

    DISK_DIRTY=1

    # Anything still holding the old partitions open makes the kernel keep the
    # stale table, and the mkfs below then writes to the wrong offsets.
    local p
    for p in "${DISK}"*; do
        [[ -b "$p" ]] || continue
        swapoff "$p" 2>/dev/null
        umount "$p" 2>/dev/null
    done

    wipefs -a "$DISK" >/dev/null 2>&1 || warn "wipefs reported an error; continuing"

    {
        echo 'label: gpt'
        echo "size=${OPT_ESP_SIZE}, type=uefi, name=\"${ESP_LABEL}\""
        [[ -n "$SWAP_SIZE" ]] && echo "size=${SWAP_SIZE}, type=swap, name=\"${SWAP_LABEL}\""
        echo "type=linux, name=\"${ROOT_LABEL}\""
    } | sfdisk --wipe always --wipe-partitions always "$DISK" >/dev/null \
        || die "sfdisk failed to partition ${DISK}"

    ok "GPT written"

    sync
    partx -u "$DISK" >/dev/null 2>&1 || blockdev --rereadpt "$DISK" >/dev/null 2>&1 || true
    have udevadm && udevadm settle --timeout=10 >/dev/null 2>&1

    # The kernel can take a moment to publish the new nodes, and on NVMe it
    # regularly outlasts a single settle.
    local waited=0
    while [[ ! -b "$ROOT_DEV" || ! -b "$ESP_DEV" ]]; do
        sleep 1
        waited=$((waited + 1))
        [[ $waited -ge 15 ]] && die "Partition nodes did not appear (${ESP_DEV}, ${ROOT_DEV})"
    done
    ok "Partition devices ready"
}

# =============================================================================
# Encryption
# =============================================================================
# LUKS2 with argon2id, over the root partition and over the swap partition,
# both opened by the one passphrase the person typed.
#
# WHY TWO CONTAINERS AND NOT ONE. The obvious shape for full-disk encryption
# is one container holding an LVM volume group with root and swap inside it,
# and that is what most distributions ship. It was not taken here, and the
# reason is what the image contains rather than what is elegant: LVM would put
# lvm2 and its libraries in the sysroot AND in the initramfs, and the
# initramfs would then have to run `vgchange -ay` before it could find a root
# -- a second userspace volume manager on the boot path of a system whose
# whole design is that everything on that path is built into the kernel. Two
# LUKS headers need cryptsetup, which is needed anyway, and nothing else.
#
# WHY NOT A RANDOM-KEY SWAP. The other common shape -- plain dm-crypt over
# swap with a key from /dev/urandom at every boot -- is simpler still and is
# what most "encrypted swap" recipes mean. It also makes hibernation
# impossible: the image is written under one key and the next boot generates a
# different one, so there is nothing to resume from, ever. That would throw
# away the resume= support that was just added, on a laptop, which is the
# machine that actually hibernates. So the swap gets a real LUKS2 header with
# a real key, and the image survives the power cycle it was written for.
#
# WHY THE SAME PASSPHRASE. Two containers could take two passphrases, and
# typing two at every boot is how people end up choosing a short one. The
# initramfs reads the passphrase once and offers it to both containers, so
# what the person experiences is one prompt -- the same as the LVM layout
# would have given them.
#
# THE COST, STATED PLAINLY: unlocking runs argon2id twice, once per header,
# so the boot prompt takes about twice as long to accept a correct passphrase
# as a single-container layout would. With cryptsetup's default 2-second
# iteration target that is roughly four seconds. It is tunable with
# --iter-time below, and it was left at the default because a boot-time cost
# is a much better thing to spend than a brute-force margin.
#
# NOTHING HERE HAS BEEN BOOTED. See the summary for this change: an encrypted
# install has never completed on real hardware or in a VM, which is why
# nothing in this file turns encryption on by itself.

# Format DEVICE as a LUKS2 container and open it as /dev/mapper/NAME.
#
# The passphrase goes in on stdin, never as an argument: an argument is
# visible in /proc/<pid>/cmdline to every user on the machine for as long as
# the command runs, and this one command runs for seconds by design.
#
# `printf '%s'` and not `echo`, because the newline would be part of the
# passphrase. cryptsetup reading a key file from a pipe takes the bytes it is
# given and does not strip a trailing newline, while the prompt it shows at
# boot strips the Enter -- so a passphrase written with `echo` here can never
# be typed at that prompt. Verified against cryptsetup 2.8.8: formatted with
# `printf '%s'`, a piped trailing newline is rejected with "No key available
# with this passphrase."
luks_create() {
    local dev="$1" name="$2"

    # --batch-mode: there is no "are you sure, type YES" here, because
    # confirm() already asked it about this whole disk.
    # aes-xts-plain64 with a 512-bit key is cryptsetup's own default for
    # LUKS2 and is written out rather than inherited, so that a future
    # cryptsetup changing its default cannot change what Raven installs
    # without anybody noticing.
    printf '%s' "$ENCRYPT_PASSWORD" | cryptsetup luksFormat \
        --type luks2 \
        --pbkdf argon2id \
        --cipher aes-xts-plain64 \
        --key-size 512 \
        --batch-mode \
        --key-file - \
        "$dev" || return 1

    printf '%s' "$ENCRYPT_PASSWORD" | cryptsetup open \
        --type luks \
        --key-file - \
        "$dev" "$name" || return 1

    [[ -b "/dev/mapper/${name}" ]]
}

# Close whatever this run opened. Safe to call when nothing is open, which is
# every unencrypted install and every --probe.
close_crypt_devices() {
    local name
    # Swap first: it is the one that was opened last, and on a machine where
    # something still holds the root mapper open, closing the swap is still
    # worth doing.
    for name in "$CRYPT_SWAP_NAME" "$CRYPT_ROOT_NAME"; do
        [[ -e "/dev/mapper/${name}" ]] || continue
        have cryptsetup || return 0
        cryptsetup close "$name" 2>/dev/null || true
    done
    return 0
}

# Put the containers on the partitions, then make ROOT_DEV and SWAP_DEV mean
# the mapper nodes.
#
# That last sentence is the whole design. Every step after this one --
# mkfs, mkswap, the mount, uuid_of, write_fstab's UUID= lines, the root=UUID=
# on the kernel command line, and above all the resume=UUID= -- reads those
# two variables, and all of them want the inside of the container rather than
# the partition it sits on. Doing the substitution once, here, is what makes
# encryption a change to three functions instead of a conditional in fifteen.
#
# resume= is the one that fails silently if this is got wrong, so it is worth
# spelling out. blkid on the raw partition of an encrypted swap reports the
# *LUKS header's* UUID, not the swap signature's -- the swap signature is
# inside the container and blkid cannot see it from outside. A resume=UUID=
# built from the partition therefore names a device that is not swap, the
# kernel finds no hibernation image there, and the machine boots fresh with no
# error printed anywhere: exactly the failure resume= was added to remove.
# Because SWAP_DEV is the mapper node from here on, uuid_of reads the swap
# signature and resume= names the mapped device, which is the only thing that
# can be resumed from.
encrypt_partitions() {
    (( ENCRYPT )) || return 0

    have cryptsetup || die "cryptsetup disappeared between preflight and now; nothing has been encrypted."
    [[ -n "$ENCRYPT_PASSWORD" ]] \
        || die "No encryption passphrase; refusing to write a container nobody can open."
    [[ -b "$ROOT_DEV" ]] || die "No root partition to encrypt (${ROOT_DEV})"

    # Anything the live session mounted or swapped on from the old contents of
    # these partitions holds them open, and luksFormat on a busy device fails
    # after it has already written the header.
    close_crypt_devices

    ROOT_CRYPT_PART="$ROOT_DEV"
    step "Encrypting ${ROOT_CRYPT_PART}"
    info "Deriving the key with argon2id; this takes a few seconds by design."
    luks_create "$ROOT_CRYPT_PART" "$CRYPT_ROOT_NAME" \
        || die "Could not create the LUKS container on ${ROOT_CRYPT_PART}"
    ROOT_DEV="/dev/mapper/${CRYPT_ROOT_NAME}"
    ROOT_CRYPT_UUID="$(cryptsetup luksUUID "$ROOT_CRYPT_PART" 2>/dev/null)"
    [[ -n "$ROOT_CRYPT_UUID" ]] \
        || die "Could not read the LUKS UUID of ${ROOT_CRYPT_PART}; the boot entry would have nothing to unlock."
    ok "${ROOT_CRYPT_PART}: LUKS2 -> ${ROOT_DEV}"

    if [[ -n "$SWAP_DEV" ]]; then
        SWAP_CRYPT_PART="$SWAP_DEV"
        step "Encrypting ${SWAP_CRYPT_PART}"
        luks_create "$SWAP_CRYPT_PART" "$CRYPT_SWAP_NAME" \
            || die "Could not create the LUKS container on ${SWAP_CRYPT_PART}"
        SWAP_DEV="/dev/mapper/${CRYPT_SWAP_NAME}"
        SWAP_CRYPT_UUID="$(cryptsetup luksUUID "$SWAP_CRYPT_PART" 2>/dev/null)"
        [[ -n "$SWAP_CRYPT_UUID" ]] \
            || die "Could not read the LUKS UUID of ${SWAP_CRYPT_PART}; the boot entry would have nothing to unlock."
        ok "${SWAP_CRYPT_PART}: LUKS2 -> ${SWAP_DEV} (hibernation image is encrypted)"
    fi
}

# The crypttab the installed system does not read.
#
# It is written for the same reason the fstab's root and /tmp lines are
# written: nothing consumes it today, and a person opening the machine's
# /etc expects to find the answer to "what is encrypted here" in the file
# that is named after that question. The unlocking is done by the initramfs
# from cryptdevice= on the kernel command line, before any filesystem on this
# disk exists to read a crypttab out of, and RavenLinux has no systemd and so
# no crypttab-reading generator. The header says so, in the file, because the
# alternative is somebody editing this and expecting it to take effect.
write_crypttab() {
    (( ENCRYPT )) || return 0

    {
        echo "# /etc/crypttab -- written by raven-install"
        echo "#"
        echo "# DOCUMENTATION, NOT CONFIGURATION. Nothing on this system reads this"
        echo "# file. The containers below are opened by the initramfs, from the"
        echo "# cryptdevice= and cryptswap= arguments on the kernel command line,"
        echo "# long before this filesystem is mounted -- it is inside the first of"
        echo "# them. Changing a line here changes nothing; the command line is in"
        echo "# \\EFI\\raven\\boot.cfg on the EFI System Partition."
        echo "#"
        echo "# <name> <device> <key> <options>"
        printf '%-12s %-48s %-6s %s\n' \
            "$CRYPT_ROOT_NAME" "UUID=${ROOT_CRYPT_UUID}" "none" "luks"
        if [[ -n "$SWAP_CRYPT_UUID" ]]; then
            # Not "swap" in the options column, which in a crypttab means
            # "reformat this as swap with a fresh random key on every boot".
            # This container is a permanent one with a real header, precisely
            # so that a hibernation image written into it survives the reboot
            # that is supposed to read it back.
            printf '%-12s %-48s %-6s %s\n' \
                "$CRYPT_SWAP_NAME" "UUID=${SWAP_CRYPT_UUID}" "none" "luks"
        fi
    } > "${TARGET}/etc/crypttab"
    chmod 0600 "${TARGET}/etc/crypttab"
    ok "/etc/crypttab written (documentation; the initramfs does the unlocking)"
}

# Lay out a fresh btrfs root and mount it the way the installed system will.
#
# Called instead of the plain `mount "$ROOT_DEV" "$TARGET"` at the bottom of
# format_partitions, and it has to be: everything after it -- the copy, the
# fstab, /home -- writes into whatever is mounted there, and on btrfs that has
# to be @ rather than the top level, or the installed system's files end up
# outside the subvolume the machine boots from.
#
# On an encrypted install ROOT_DEV is already /dev/mapper/ravenroot by the
# time this runs: encrypt_partitions() reassigned it at the top of
# format_partitions, before the mkfs. So btrfs-inside-LUKS needs no special
# case anywhere in here, which is the point of doing the substitution once --
# the subvolumes are created inside the container, the UUID write_fstab reads
# is the btrfs superblock's from inside the container, and the initramfs opens
# the container before it ever looks for a root to mount.
create_btrfs_layout() {
    local opts entry name mnt
    opts="$(btrfs_common_opts)"

    # Subvolumes can only be created on a mounted btrfs filesystem, and the
    # only thing that exists on a fresh mkfs.btrfs is the top-level subvolume
    # -- which is not where the system is going to live. So the top level is
    # mounted out of the way for the second it takes, then unmounted again.
    # Leaving it mounted would give the install two writable views of one
    # filesystem, and `umount -R "$TARGET"` in cleanup() would never find this
    # one, which on an encrypted install means a container that will not close.
    mkdir -p "$BTRFS_TOP"
    mount -o "$opts" "$ROOT_DEV" "$BTRFS_TOP" \
        || die "Cannot mount ${ROOT_DEV} to create its subvolumes"

    for entry in "${BTRFS_SUBVOLS[@]}"; do
        name="${entry%%:*}"
        # A separate /home partition wins over @home, and the subvolume is not
        # created at all rather than created and left unmounted. An empty
        # @home sitting in the layout is something a snapshot tool would have
        # to have an opinion about, and something `btrfs subvolume list` would
        # show to a person whose /home is demonstrably somewhere else.
        [[ "$name" == "@home" && -n "${HOME_DEV:-}" ]] && continue
        btrfs subvolume create "${BTRFS_TOP}/${name}" >/dev/null 2>&1 || {
            umount "$BTRFS_TOP" 2>/dev/null
            die "Could not create the ${name} subvolume on ${ROOT_DEV}"
        }
    done

    umount "$BTRFS_TOP" || die "Cannot unmount ${BTRFS_TOP}"
    rmdir "$BTRFS_TOP" 2>/dev/null || true

    mount -o "subvol=@,${opts}" "$ROOT_DEV" "$TARGET" \
        || die "Cannot mount the @ subvolume of ${ROOT_DEV} on ${TARGET}"
    ok "${ROOT_DEV}: @ -> / (${opts})"

    # The rest, in the order BTRFS_SUBVOLS is written, so a nested mount point
    # is always created after the subvolume it sits inside is mounted.
    #
    # Mounted now, before copy_system rather than after it, and that ordering
    # is load-bearing. The copy has to land *inside* these: a /var/log written
    # onto @ and then hidden by a later mount of @log is a machine whose
    # install-time logs are invisible from the running system and whose every
    # @ snapshot carries a dead copy of them, which is the exact cost @log was
    # created to avoid.
    for entry in "${BTRFS_SUBVOLS[@]}"; do
        name="${entry%%:*}"
        mnt="${entry#*:}"
        [[ "$name" == "@" ]] && continue
        [[ "$name" == "@home" && -n "${HOME_DEV:-}" ]] && continue
        mkdir -p "${TARGET}${mnt}"
        mount -o "subvol=${name},${opts}" "$ROOT_DEV" "${TARGET}${mnt}" \
            || die "Cannot mount the ${name} subvolume on ${mnt}"
        ok "${ROOT_DEV}: ${name} -> ${mnt}"
    done

    # A snapshot of this system contains every file in /etc and every byte of
    # every home directory. At 0755 that is all readable to any account on the
    # machine by way of yesterday's copy of it, which would quietly undo the
    # permissions on the originals.
    chmod 0700 "${TARGET}/.snapshots" 2>/dev/null || true
}

format_partitions() {
    phase format "Creating filesystems"

    # Before any mkfs, because every filesystem below has to be made *inside*
    # the container rather than on the partition. It also reassigns ROOT_DEV
    # and SWAP_DEV to the mapper nodes, which is what makes the rest of this
    # function -- and write_fstab, and install_bootloader -- correct without
    # knowing anything about encryption.
    encrypt_partitions

    if (( ESP_REUSED )) && (( ! ${ESP_FORMAT:-0} )); then
        # Somebody else's ESP, holding the bootloader of the OS being installed
        # alongside. Formatting it is the one action in this whole file that
        # would make the other operating system unbootable, so it is the one
        # the alongside path must not take.
        #
        # It does have to be big enough for two. RavenBoot, a kernel and an
        # initramfs come to around 100 MB, and an ESP with less than that free
        # fails later, in the middle of the bootloader step, on an install
        # that has already copied the whole system.
        local free_kb
        mkdir -p "${WORK}/espcheck"
        if mount -o ro "$ESP_DEV" "${WORK}/espcheck" 2>/dev/null; then
            free_kb=$(df -k "${WORK}/espcheck" 2>/dev/null | awk 'NR==2 { print $4 }')
            umount "${WORK}/espcheck" 2>/dev/null
        fi
        rmdir "${WORK}/espcheck" 2>/dev/null
        if [[ "$free_kb" =~ ^[0-9]+$ ]] && (( free_kb < 120000 )); then
            die "${ESP_DEV} has only $(to_human $(( free_kb * 1024 ))) free.
       RavenBoot, the kernel and the initramfs need about 120 MB. Free some
       space on the EFI partition -- old distributions leave \\EFI directories
       behind -- and run the installer again."
        fi
        ok "${ESP_DEV}: reusing the existing EFI partition (not formatted)"
    else
        mkfs.vfat -F 32 -n "${ESP_LABEL}" "$ESP_DEV" >/dev/null 2>&1 \
            || die "mkfs.vfat failed on ${ESP_DEV}"
        ok "${ESP_DEV}: FAT32 (${ESP_LABEL})"
    fi

    case "${OPT_FS}" in
        ext4)  mkfs.ext4 -F -L "${ROOT_LABEL}" "$ROOT_DEV" >/dev/null 2>&1 ;;
        xfs)   mkfs.xfs -f -L "${ROOT_LABEL}" "$ROOT_DEV" >/dev/null 2>&1 ;;
        btrfs) mkfs.btrfs -f -L "${ROOT_LABEL}" "$ROOT_DEV" >/dev/null 2>&1 ;;
    esac || die "mkfs.${OPT_FS} failed on ${ROOT_DEV}"
    ok "${ROOT_DEV}: ${OPT_FS} (${ROOT_LABEL})"

    if [[ -n "$SWAP_DEV" ]] && (( ${SWAP_KEEP:-0} )); then
        ok "${SWAP_DEV}: existing swap, kept"
    elif [[ -n "$SWAP_DEV" ]]; then
        mkswap -L "${SWAP_LABEL}" "$SWAP_DEV" >/dev/null 2>&1 \
            || die "mkswap failed on ${SWAP_DEV}"
        ok "${SWAP_DEV}: swap (${SWAP_LABEL})"
    fi

    # /home is formatted here and mounted after the copy -- see mount_home.
    if [[ -n "${HOME_DEV:-}" ]] && (( ! ${HOME_KEPT:-0} )); then
        case "${OPT_FS}" in
            ext4)  mkfs.ext4 -F -L "${HOME_LABEL}" "$HOME_DEV" >/dev/null 2>&1 ;;
            xfs)   mkfs.xfs -f -L "${HOME_LABEL}" "$HOME_DEV" >/dev/null 2>&1 ;;
            btrfs) mkfs.btrfs -f -L "${HOME_LABEL}" "$HOME_DEV" >/dev/null 2>&1 ;;
        esac || die "mkfs.${OPT_FS} failed on ${HOME_DEV}"
        ok "${HOME_DEV}: ${OPT_FS} (${HOME_LABEL}) for /home"
    elif [[ -n "${HOME_DEV:-}" ]]; then
        ok "${HOME_DEV}: kept as /home, not formatted"
    fi

    if [[ "${OPT_FS}" == "btrfs" ]]; then
        create_btrfs_layout
    else
        mount "$ROOT_DEV" "$TARGET" || die "Cannot mount ${ROOT_DEV} on ${TARGET}"
    fi
    mkdir -p "${TARGET}/boot/efi"
    mount "$ESP_DEV" "${TARGET}/boot/efi" || die "Cannot mount ${ESP_DEV}"
    ok "Target mounted"
}

# =============================================================================
# Copy
# =============================================================================

# Poll the target filesystem's used space rather than walking the tree: du on a
# 1.4G tree every couple of seconds costs more than the copy it is reporting on.
# Without df, or without a size to measure against, fall back to a spinner --
# a copy this long with no output at all reads as a hang.
copy_progress() {
    local pid="$1" total_mb="$2" used_mb pct last=-1
    local spin='-\|/' i=0

    if ! have df || [[ $total_mb -le 0 ]]; then
        while kill -0 "$pid" 2>/dev/null; do
            printf '\r  [ %s**%s  ] Copying system files... %s' \
                "$BLUE" "$NC" "${spin:i++%4:1}"
            sleep 1
        done
        # Nothing measurable to report, so the stream says so once rather than
        # leaving a front-end to decide whether a silent phase is a hang.
        emit info "Copying system files (size unknown)"
        printf '\r%*s\r' 70 ''
        return 0
    fi

    while kill -0 "$pid" 2>/dev/null; do
        # -m is not universal across df implementations; -k is.
        used_mb=$(df -k "$TARGET" 2>/dev/null | awk 'NR==2 {print int($3/1024)}')
        [[ -z "$used_mb" ]] && used_mb=0
        pct=$((used_mb * 100 / total_mb))
        [[ $pct -gt 99 ]] && pct=99
        if [[ $pct -ne $last ]]; then
            printf '\r  [ %s**%s  ] Copying system files... %d%% (%d/%d MB)' \
                "$BLUE" "$NC" "$pct" "$used_mb" "$total_mb"
            pct "$pct"
            last=$pct
        fi
        sleep 2
    done
    printf '\r%*s\r' 70 ''
}

copy_system() {
    phase copy "Copying the system to ${ROOT_DEV}"

    local total_mb=0
    if have du; then
        total_mb=$(du -sm --one-file-system "$SRC_ROOT" 2>/dev/null | awk '{print $1}')
    fi
    [[ "$total_mb" =~ ^[0-9]+$ ]] || total_mb=0
    [[ $total_mb -gt 0 ]] && info "About ${total_mb} MB to copy"

    local rc=0
    if [[ "$SRC_KIND" == "squashfs" ]]; then
        # A read-only single-filesystem source: a plain recursive copy is exact.
        cp -a "${SRC_ROOT}/." "${TARGET}/" &
    else
        # The running root. --one-file-system is what keeps /proc, /sys, /dev,
        # /run and /tmp out: every one of them is a separate mount, so tar stops
        # at the boundary without needing a list of paths to skip.
        ( tar -C / --one-file-system -cf - . 2>/dev/null \
          | tar -C "$TARGET" -xpf - 2>/dev/null ) &
    fi
    local copy_pid=$!
    copy_progress "$copy_pid" "$total_mb"
    wait "$copy_pid" || rc=$?

    [[ $rc -eq 0 ]] || die "Copying the system failed (exit ${rc}). The disk is not usable."

    # Directories the copy cannot carry: they are mount points on the source,
    # so they arrive empty or not at all.
    local d
    for d in proc sys dev run tmp mnt media var/log var/tmp home boot/efi; do
        mkdir -p "${TARGET}/${d}"
    done
    chmod 1777 "${TARGET}/tmp" "${TARGET}/var/tmp" 2>/dev/null

    sync
    ok "System copied"
}

# =============================================================================
# Configure the installed system
# =============================================================================

uuid_of() { blkid -o value -s UUID "$1" 2>/dev/null; }

# The swap partition's UUID, published by write_fstab for install_bootloader.
#
# ROOT_UUID has always been handed on this way, and for a good reason: the
# fstab and the boot entries have to name the same root, and reading it twice
# is two chances to disagree -- on an alongside install the partition numbers
# are sfdisk's to choose, so a second blkid sweep is not self-evidently looking
# at the same partition as the first. SWAP_UUID exists for that reason and a
# sharper one. install_bootloader turns it into resume=, and a resume= that
# names a different partition from the one fstab swapons is a machine that
# writes its hibernation image into one place and then looks for it in
# another: it boots fresh, says nothing, and the session is gone.
#
# Empty is a legitimate value here -- --swap none is a supported answer -- so
# unlike ROOT_UUID this one carries a default rather than being left to `set
# -u` as a tripwire.
SWAP_UUID=""

write_fstab() {
    local root_uuid esp_uuid swap_uuid
    local root_opts root_pass sv sv_name sv_mnt
    root_uuid=$(uuid_of "$ROOT_DEV")
    esp_uuid=$(uuid_of "$ESP_DEV")

    [[ -n "$root_uuid" ]] || die "Could not read the UUID of ${ROOT_DEV}"

    # printf rather than echo: a FAT volume id is 9 characters and an ext4 UUID
    # is 36, so hand-spaced columns line up for one of them and not the other.
    local fmt='%-41s %-10s %-6s %-33s %s %s\n'

    {
        echo "# /etc/fstab -- written by raven-install"
        echo "#"
        # The header's first column is two narrower to pay for the "# " prefix.
        printf '# %-39s %-10s %-6s %-33s %s %s\n' \
            "<device>" "<mount>" "<type>" "<options>" "<dump>" "<pass>"
        # noatime, not the kernel's relatime, on both Linux filesystems here.
        #
        # relatime is already a large improvement on strictatime: it writes an
        # access time only when the stored one is older than the file's mtime
        # or ctime, or older than a day. But "older than a day" is the part
        # that costs. On a desktop that is used every morning, the first read
        # of every file that day still turns into a metadata write and a
        # journal transaction -- the dynamic linker walking the library path,
        # the compositor reading its themes and icons, a browser opening its
        # profile -- and none of it is read back by anything. Nothing in this
        # tree consumes atime. There is no mutt-style unread-mail check, no
        # tmpwatch sweeping /tmp by access time, and the one consumer people
        # reach for, a backup tool deciding what changed, uses mtime and ctime
        # here as everywhere else. So the writes buy nothing, and what they
        # cost is SSD erase cycles and a disk wakeup on a laptop that would
        # otherwise have been allowed to stay idle.
        #
        # This line does not by itself change how the root is mounted, and it
        # is important not to think it does. raven-init's mount_fstab skips
        # the root on purpose -- the initramfs already mounted it, and
        # changing a live root's flags underneath the system is worse than
        # leaving them alone -- so the root's real options come from
        # rootflags= on the kernel command line, which install_bootloader
        # writes. The two are kept saying the same thing so that a later
        # `mount -o remount /`, which reads this file, cannot quietly put
        # relatime back.
        root_opts="rw,noatime"
        root_pass=1
        if [[ "${OPT_FS}" == "btrfs" ]]; then
            # subvol=@ is what makes this line describe the root the machine
            # actually booted from. Without it a `mount -o remount /` reading
            # this file would be asking for the top-level subvolume, and the
            # two would disagree about what "/" means -- which is the same
            # class of quiet mismatch the noatime note above is guarding
            # against, one level further down.
            #
            # Pass 0, not 1: fsck.btrfs is a stub that exits 0 without looking
            # at anything, because btrfs checks and repairs at mount time and
            # with `btrfs scrub` rather than from a boot-time fsck. A pass of
            # 1 here asks for a check that cannot happen and would read as a
            # promise the system does not keep.
            root_opts="rw,$(btrfs_root_flags)"
            root_pass=0
        fi
        printf "$fmt" "UUID=${root_uuid}" "/" "${OPT_FS}" "$root_opts" 0 "$root_pass"
        # One line per subvolume, each naming the subvolume it mounts, and
        # subvol= here is neither optional nor cosmetic. A btrfs mount with no
        # subvol= gets the top-level subvolume, so a `mount /var/log` taken
        # from a line without it would mount the directory that contains @ --
        # the running system would find its own root filesystem tree appearing
        # inside its log directory. raven-init's mount_fstab passes any option
        # it does not have a flag for straight through as the mount's data
        # string (init/src/main.rs:934), so subvol= reaches the kernel exactly
        # as it is written here.
        #
        # These are the lines that do take effect, unlike the root above:
        # mount_fstab skips only the root and anything already mounted, and
        # none of these is either.
        if [[ "${OPT_FS}" == "btrfs" ]]; then
            for sv in "${BTRFS_SUBVOLS[@]}"; do
                sv_name="${sv%%:*}"
                sv_mnt="${sv#*:}"
                [[ "$sv_name" == "@" ]] && continue
                # Skipped for the same reason create_btrfs_layout() does not
                # create it: a separate /home partition owns /home, and its
                # own line is written further down.
                [[ "$sv_name" == "@home" && -n "${HOME_DEV:-}" ]] && continue
                printf "$fmt" "UUID=${root_uuid}" "$sv_mnt" "btrfs" \
                    "rw,subvol=${sv_name},$(btrfs_common_opts)" 0 0
            done
        fi
        if [[ -n "$esp_uuid" ]]; then
            printf "$fmt" "UUID=${esp_uuid}" "/boot/efi" "vfat" \
                "rw,noatime,fmask=0077,dmask=0077" 0 2
        fi
        if [[ -n "$SWAP_DEV" ]]; then
            swap_uuid=$(uuid_of "$SWAP_DEV")
            [[ -n "$swap_uuid" ]] && printf "$fmt" "UUID=${swap_uuid}" "none" "swap" "sw" 0 0
            # Read once, used twice: see SWAP_UUID above. A brace group with a
            # redirection runs in this shell, not a subshell, so the
            # assignment survives the end of the block.
            SWAP_UUID="$swap_uuid"
        fi
        if [[ -n "${HOME_DEV:-}" ]]; then
            local home_uuid home_type
            home_uuid=$(uuid_of "$HOME_DEV")
            home_type=$(fs_type_of "$HOME_DEV")
            [[ -n "$home_uuid" ]] || die "Could not read the UUID of ${HOME_DEV}"
            # noatime for the same reasons as the root, and this one does
            # take effect from here: /home is not the root, so mount_fstab
            # mounts it with exactly the options on this line. An NTFS or
            # vfat /home carried over from another OS ignores the flag
            # harmlessly rather than refusing to mount.
            local home_opts="rw,noatime"
            # A /home partition this installer just made with --fs btrfs is a
            # btrfs filesystem in its own right -- no subvolume, because it is
            # a whole separate filesystem and there is nothing for a subvolume
            # to separate it from -- but it wants the same compression and the
            # same allocator hint as the root does, for the same reasons.
            [[ "${home_type}" == "btrfs" ]] && home_opts="rw,$(btrfs_common_opts)"
            printf "$fmt" "UUID=${home_uuid}" "/home" "${home_type:-auto}" "$home_opts" 0 2
        fi
        # Redundant while raven-init mounts /tmp itself, and kept as the template
        # for anyone adding a mount by hand.
        #
        # size=50% is the cap, and it is worth being exact about what adding it
        # does. tmpfs with no size= is not unbounded: the kernel already
        # defaults it to half of physical RAM. So this is not a new limit, it
        # is the same limit written down. That is the point. A default is not
        # a decision -- nothing in this tree said what /tmp was allowed to
        # cost, so nobody could argue the figure up or down without first
        # going to read mm/shmem.c to find out what it currently was -- and a
        # mount whose ceiling is implicit moves if the kernel ever moves its
        # default.
        #
        # Half of RAM is also the right figure to pin, not just the
        # conventional one. /tmp here is swap-backed, so the pages a runaway
        # parks in it can be pushed out to the swap partition this installer
        # just created instead of sitting pinned in memory; and a build that
        # genuinely needs more than half of RAM in /tmp wants /var/tmp, which
        # is on the root filesystem and bounded by the disk.
        #
        # Like the root line above, this one is a statement of intent rather
        # than the thing that takes effect. raven-init mounts /tmp during
        # mount_essential_filesystems, before it has read this file at all,
        # and mount_fstab then skips any target that is already mounted. The
        # size has to be on init's own mount to matter.
        printf "$fmt" "tmpfs" "/tmp" "tmpfs" "rw,nosuid,nodev,mode=1777,size=50%" 0 0
    } > "${TARGET}/etc/fstab"

    ROOT_UUID="$root_uuid"
    ok "/etc/fstab written"
}

set_hostname() {
    echo "${HOSTNAME}" > "${TARGET}/etc/hostname"

    {
        echo "127.0.0.1   localhost"
        echo "::1         localhost ip6-localhost ip6-loopback"
        echo "127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}"
    } > "${TARGET}/etc/hosts"

    # raven-init reads /etc/hostname first, but init.toml carries a hostname of
    # its own and leaving it saying "raven-linux" is confusing later.
    if [[ -f "${TARGET}/etc/raven/init.toml" ]]; then
        sed -i "s|^hostname *= *\".*\"|hostname = \"${HOSTNAME}\"|" \
            "${TARGET}/etc/raven/init.toml" 2>/dev/null || true
    fi

    ok "Hostname: ${HOSTNAME}"
}

# Add $2 to group $1's member list in the target's /etc/group, if not already
# there. Editing the file directly rather than calling gpasswd keeps this
# working on an image whose shadow tools cannot chroot.
# Create a system group if the image does not already ship one.
#
# add_group_member fails on a group that does not exist, and every caller of it
# swallowed that with `|| true` -- so a missing group was indistinguishable
# from a successful add. `render` is the one where that had teeth: udev's
# 50-udev-default.rules gives /dev/dri/renderD* to group `render` at mode 0660,
# and with no such group in /etc/group the rule cannot apply and the node stays
# root-only 0600. The compositor survives that (it reaches the card node
# through seatd) but every GPU-accelerated Wayland client that opens the render
# node does not.
ensure_group() {
    local grp="$1" group="${TARGET}/etc/group"

    [[ -f "$group" ]] || return 1
    grep -q "^${grp}:" "$group" 2>/dev/null && return 0

    # First free GID in the system range, high end first so this never collides
    # with a distro's statically-assigned low GIDs. Brace expansion rather than
    # seq: the live image does not ship seq, and under `set -u` a loop over an
    # empty list left $gid unbound and aborted the whole install right after
    # the user account had been created.
    local gid found=""
    for gid in {999..900}; do
        if ! grep -q "^[^:]*:[^:]*:${gid}:" "$group" 2>/dev/null; then
            found="$gid"
            break
        fi
    done
    [[ -n "$found" ]] || return 1

    printf '%s:x:%s:\n' "$grp" "$found" >> "$group"
}

add_group_member() {
    local grp="$1" user="$2" group="${TARGET}/etc/group"
    grep -q "^${grp}:" "$group" 2>/dev/null || return 1

    awk -F: -v g="$grp" -v u="$user" 'BEGIN{OFS=":"}
        $1==g {
            n = split($4, m, ",")
            for (i = 1; i <= n; i++) if (m[i] == u) { print; next }
            $4 = ($4 == "" ? u : $4 "," u)
        }
        {print}' "$group" > "${group}.new" && mv "${group}.new" "$group"
}

# Drop $1 from every group's member list. Called when the placeholder account
# the image ships is removed -- otherwise it stays named in wheel, audio and
# the rest, referring to a user that no longer exists.
remove_group_member() {
    local user="$1" group="${TARGET}/etc/group"
    [[ -f "$group" ]] || return 0

    awk -F: -v u="$user" 'BEGIN{OFS=":"}
        {
            n = split($4, m, ",")
            out = ""
            for (i = 1; i <= n; i++) {
                if (m[i] == u || m[i] == "") continue
                out = (out == "" ? m[i] : out "," m[i])
            }
            $4 = out
            print
        }' "$group" > "${group}.new" && mv "${group}.new" "$group"
}

next_free_uid() {
    local uid=1000
    while grep -q ":x:${uid}:" "${TARGET}/etc/passwd" 2>/dev/null; do
        uid=$((uid + 1))
    done
    echo "$uid"
}

create_user() {
    local passwd="${TARGET}/etc/passwd"
    local group="${TARGET}/etc/group"
    local shadow="${TARGET}/etc/shadow"

    touch "$passwd" "$group" "$shadow"

    # The sysroot ships a placeholder "raven" account so the live image has a
    # non-root user. If the installer is creating an account under a different
    # name, that placeholder is dead weight and a login nobody set a password
    # on -- so it goes.
    if [[ "$USERNAME" != "raven" ]]; then
        sed -i '/^raven:/d' "$passwd" "$shadow" 2>/dev/null || true
        sed -i '/^raven:x:1000:/d' "$group" 2>/dev/null || true
        remove_group_member raven
        # Not on a kept /home: /home/raven there is somebody's data, not the
        # live image's placeholder -- mount_home already left that behind.
        (( ${HOME_KEPT:-0} )) || rm -rf "${TARGET}/home/raven" 2>/dev/null || true
    fi

    local shell="/bin/bash"
    for s in /usr/bin/ravenshell /bin/ravenshell /bin/bash /bin/sh; do
        [[ -x "${TARGET}${s}" ]] && { shell="$s"; break; }
    done

    if grep -q "^${USERNAME}:" "$passwd"; then
        info "Account ${USERNAME} already exists in the image; updating it"
        sed -i "s|^${USERNAME}:.*|${USERNAME}:x:$(awk -F: -v u="$USERNAME" '$1==u{print $3":"$4}' "$passwd"):${FULLNAME}:/home/${USERNAME}:${shell}|" "$passwd"
        USER_UID=$(awk -F: -v u="$USERNAME" '$1==u{print $3}' "$passwd")
        USER_GID=$(awk -F: -v u="$USERNAME" '$1==u{print $4}' "$passwd")
    else
        USER_UID=$(next_free_uid)
        USER_GID="$USER_UID"
        echo "${USERNAME}:x:${USER_UID}:${USER_GID}:${FULLNAME}:/home/${USERNAME}:${shell}" >> "$passwd"
        grep -q "^${USERNAME}:x:${USER_GID}:" "$group" || \
            echo "${USERNAME}:x:${USER_GID}:" >> "$group"
        echo "${USERNAME}:!:0:0:99999:7:::" >> "$shadow"
    fi

    mkdir -p "${TARGET}/home/${USERNAME}"
    # Seed the home directory from /etc/skel when the image has one.
    # -n on a kept /home: an existing .bashrc is the person's, not skel's.
    if [[ -d "${TARGET}/etc/skel" ]]; then
        if (( ${HOME_KEPT:-0} )); then
            cp -an "${TARGET}/etc/skel/." "${TARGET}/home/${USERNAME}/" 2>/dev/null || true
        else
            cp -a "${TARGET}/etc/skel/." "${TARGET}/home/${USERNAME}/" 2>/dev/null || true
        fi
    fi
    chown -R "${USER_UID}:${USER_GID}" "${TARGET}/home/${USERNAME}" 2>/dev/null || true
    chmod 0755 "${TARGET}/home/${USERNAME}"

    ok "Created ${USERNAME} (uid ${USER_UID}, shell ${shell})"

    if [[ $USER_SUDO -eq 1 ]]; then
        grant_sudo
    fi
}

# Membership in wheel, plus a sudoers rule that actually honours wheel. Several
# builds ship a sudoers with that line commented out, which turns "you have
# sudo" into "sudo: user is not in the sudoers file" on first use.
grant_sudo() {
    local group="${TARGET}/etc/group"

    add_group_member wheel "$USERNAME" || echo "wheel:x:10:${USERNAME}" >> "$group"

    local sudoers="${TARGET}/etc/sudoers"
    if [[ -f "$sudoers" ]] && grep -qE '^[[:space:]]*%wheel[[:space:]]+ALL=' "$sudoers"; then
        : # already enabled
    elif [[ -d "${TARGET}/etc/sudoers.d" ]] || mkdir -p "${TARGET}/etc/sudoers.d" 2>/dev/null; then
        echo '%wheel ALL=(ALL:ALL) ALL' > "${TARGET}/etc/sudoers.d/10-wheel"
        chmod 0440 "${TARGET}/etc/sudoers.d/10-wheel"
        # sudoers.d is only read if sudoers includes it -- and if there is no
        # /etc/sudoers at all, sudo reads nothing, the drop-in above is inert,
        # and the first `sudo` answers "user is not in the sudoers file" on a
        # machine this function just reported it had granted sudo on. The old
        # code only ever appended to a sudoers that already existed, so the
        # one case that needed help was the one it skipped.
        if [[ ! -f "$sudoers" ]]; then
            cat > "$sudoers" << 'SUDOERS_EOF'
# /etc/sudoers - written by raven-install because the image shipped none.
Defaults env_reset
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

root ALL=(ALL:ALL) ALL
%wheel ALL=(ALL:ALL) ALL

@includedir /etc/sudoers.d
SUDOERS_EOF
            chmod 0440 "$sudoers"
            chown 0:0 "$sudoers" 2>/dev/null || true
            warn "the image shipped no /etc/sudoers; wrote one"
        elif ! grep -qE '^[[:space:]]*@?include(dir)?[[:space:]]+/etc/sudoers\.d' "$sudoers"; then
            echo '@includedir /etc/sudoers.d' >> "$sudoers"
        fi
    fi

    # Groups a desktop session needs to reach hardware directly.
    #
    # Created first if the image lacks them. seatd runs with -g video, which
    # the base image does ship, so a seat works either way; `render` is the one
    # that was quietly absent and left /dev/dri/renderD* unopenable by anyone
    # but root. `seat` is created for symmetry and is unused today.
    #
    # `caw` is not hardware but belongs in the same loop: cawd checks the
    # peer's credentials on its socket, and `caw connect`, `disconnect` and
    # `shutdown` are refused to anyone outside the group. stage2 ships it
    # with the placeholder as its only member, and remove_group_member has
    # just stripped that -- so without this the installed user can scan but
    # never join a network except through sudo.
    local g
    for g in audio video input render seat caw; do
        ensure_group "$g" || true
        add_group_member "$g" "$USERNAME" || true
    done

    ok "${USERNAME} added to wheel (sudo) and the hardware groups"

    open_local_prefix
}

# /usr/local belongs to wheel, setgid and group-writable, so a wheel member
# can `imlazy install` into it at their own prompt; nothing there needs sudo.
# The image's skeleton ships it that way (scripts/lib/skeleton.sh,
# RAVEN_SKELETON_DIRS_USR), and this re-applies it on the target because an
# image built before the skeleton carried it, or a system being reconfigured
# in place, has root-only 755 directories there. It is recursive on purpose:
# subdirectories that earlier root installs created (share/applications,
# share/icons, ...) open up too. Files keep their owner; only the group and
# the group-write bit change.
#
# Only wheel may hold this. /usr/local/bin leads root's secure_path and holds
# rvnd, which runs as root, so write access here is root -- exactly what
# wheel already has through sudoers, and a privilege escalation for any other
# group. The gid is numeric (10, pinned in the skeleton) because the target's
# /etc/group is not the host's.
open_local_prefix() {
    local local_dir="${TARGET}/usr/local"
    [[ -d "$local_dir" ]] || return 0

    if ! chgrp -R 10 "$local_dir" 2>/dev/null; then
        warn "could not hand /usr/local to wheel; installing there will need sudo"
        return 0
    fi
    find "$local_dir" -type d -exec chmod g+ws {} + 2>/dev/null || true
    find "$local_dir" -type f -exec chmod g+w {} + 2>/dev/null || true
    ok "/usr/local is writable by wheel; imlazy install needs no sudo"
}

set_passwords() {
    if ! have chpasswd; then
        warn "chpasswd is missing; no passwords were set"
        NEEDS_PASSWORD_ON_FIRST_BOOT=1
        return 0
    fi

    local failed=0
    # chpasswd's stderr is the only thing that ever says WHY a password did not
    # get set, and it used to go to /dev/null -- so the failure mode was an
    # install that reported success and a disk whose root account had no
    # working password, with nothing anywhere to explain it. `-R` chroots into
    # the target, so every reason lives in there: a missing /etc/pam.d/chpasswd
    # falls through to pam_deny and fails with "pam_start failure 26", and a
    # missing PAM module or /etc/shadow fails just as quietly. Keep it.
    local err=""
    if [[ -n "$ROOT_PASSWORD" ]]; then
        if err=$(printf 'root:%s\n' "$ROOT_PASSWORD" | chpasswd -R "$TARGET" 2>&1); then
            ok "root password set"
        else
            failed=1
            [[ -n "$err" ]] && echo "        chpasswd: ${err}"
        fi
    else
        # An empty password field means "no password required", which is worse
        # than a locked account on a machine that now has a real user on it.
        sed -i 's|^root::|root:!:|' "${TARGET}/etc/shadow" 2>/dev/null || true
        warn "root has no password and is locked; use sudo from ${USERNAME}"
    fi

    if [[ -n "$USER_PASSWORD" ]]; then
        if err=$(printf '%s:%s\n' "$USERNAME" "$USER_PASSWORD" | chpasswd -R "$TARGET" 2>&1); then
            ok "${USERNAME} password set"
        else
            failed=1
            [[ -n "$err" ]] && echo "        chpasswd: ${err}"
        fi
    else
        # add_user() created the account with '!' in shadow, so it is locked
        # rather than open -- which is the right way round, and is also the one
        # state the graphical login screen cannot be talked past: `ravend`
        # offers this account, the person types the password nobody set, and
        # there is no answer that works. The live image gets away with an
        # account like this because it autologins; an installed disk does not.
        #
        # So this has to be said out loud. It used to be the one path through
        # here that set nothing and warned about nothing, and the summary at
        # the end still told you to log in as this user.
        warn "${USERNAME} has no password and is locked"
        echo "        Boot the rescue entry and run 'passwd ${USERNAME}' before"
        echo "        the login screen -- there is no password that will get past it."
        NEEDS_PASSWORD_ON_FIRST_BOOT=1
    fi

    if [[ $failed -eq 1 ]]; then
        warn "chpasswd could not set one or more passwords"
        echo "        Boot the rescue entry and run 'passwd' to set them."
        NEEDS_PASSWORD_ON_FIRST_BOOT=1
    fi

    chmod 0600 "${TARGET}/etc/shadow" 2>/dev/null || true
    chown 0:0 "${TARGET}/etc/shadow" 2>/dev/null || true
}

set_locale_and_time() {
    local tzdir="${TARGET}/usr/share/zoneinfo"
    if [[ -f "${tzdir}/${TIMEZONE}" ]]; then
        ln -sf "/usr/share/zoneinfo/${TIMEZONE}" "${TARGET}/etc/localtime"
        echo "${TIMEZONE}" > "${TARGET}/etc/timezone"
        ok "Timezone: ${TIMEZONE}"
    else
        warn "No zoneinfo for ${TIMEZONE} in the installed tree; leaving the clock on UTC"
    fi

    # The hardware clock. Windows keeps it in local time and will not be
    # talked out of it, so on a machine with Windows the RTC is kept in local
    # time here too (/etc/adjtime, which raven-init and raven-timed read) --
    # otherwise each OS shows the other's clock off by the timezone offset.
    local rtc="${ANS[rtc]:-}"
    if [[ -z "$rtc" ]]; then
        if machine_has_windows; then rtc=local; else rtc=utc; fi
    fi
    if [[ "$rtc" == "local" ]]; then
        printf '0.0 0 0.0\n0\nLOCAL\n' > "${TARGET}/etc/adjtime"
        ok "Hardware clock: local time, as Windows keeps it"
    else
        printf '0.0 0 0.0\n0\nUTC\n' > "${TARGET}/etc/adjtime"
        ok "Hardware clock: UTC"
    fi

    {
        echo "LANG=${LOCALE}"
        echo "LC_COLLATE=C"
    } > "${TARGET}/etc/locale.conf"
    ok "Locale: ${LOCALE}"

    # Recorded for the console setup to pick up. Nothing applies it today --
    # the sysroot ships no loadkeys -- so say that rather than let a setting
    # that does nothing look like one that works.
    echo "KEYMAP=${KEYMAP}" > "${TARGET}/etc/vconsole.conf"
    if [[ "$KEYMAP" != "us" ]]; then
        warn "Keymap '${KEYMAP}' recorded in /etc/vconsole.conf but not applied"
        echo "        RavenLinux does not ship loadkeys yet, so the console stays on us."
    fi

    # A stable machine-id, generated per install rather than baked into the ISO.
    local mid=""
    if have od; then
        mid=$(od -An -tx1 -N16 /dev/urandom 2>/dev/null | tr -d ' \n')
    fi
    if [[ ${#mid} -ne 32 ]]; then
        # No od in this image. bash's own RNG is not cryptographic, but a
        # machine-id only has to be unique, not unguessable.
        mid=""
        local i
        for ((i = 0; i < 8; i++)); do
            mid+=$(printf '%04x' $((RANDOM % 65536)))
        done
    fi
    printf '%s\n' "$mid" > "${TARGET}/etc/machine-id"
}

# The live image enters raven-init through a small /init hand-off. An installed
# root enters it through /sbin/init, so remove the live-only hand-off and make
# that relationship explicit on disk.
switch_to_raven_init() {
    if [[ -x "${TARGET}/sbin/raven-init" ]]; then
        rm -f "${TARGET}/sbin/init"
        ln -sf raven-init "${TARGET}/sbin/init"
        rm -f "${TARGET}/init"
        ok "PID 1 on the installed system: raven-init"
    else
        die "raven-init not found in the image; this build cannot be installed safely"
    fi

    # The live image autologins root on tty1 with no password, which is correct
    # for a live shell and unacceptable once the machine has real accounts.
    local toml="${TARGET}/etc/raven/init.toml"
    if [[ -f "$toml" ]] && [[ -x "${TARGET}/bin/login" || -x "${TARGET}/sbin/login" ]]; then
        # Replace the getty-tty1 argument list with a real login prompt. Only
        # the first match: later services have their own args.
        awk '
            /^name = "getty-tty1"/ { intty = 1 }
            intty && /^args = / {
                print "args = [\"--noclear\", \"tty1\", \"linux\"]"
                intty = 0
                next
            }
            { print }
        ' "$toml" > "${toml}.new" && mv "${toml}.new" "$toml"
        ok "tty1 asks for a login"
    else
        warn "Leaving the tty1 autologin in place: no /bin/login in the image"
    fi

    # The first-boot script exists to catch systems that were never through an
    # installer. This one has been.
    touch "${TARGET}/etc/.raven-first-boot-done"
}

# Strip the live image's credentials from the installed system.
#
# The twin of the tty1 change above, and it exists for the same reason: what is
# correct on a live ISO is unacceptable once the machine has real accounts on
# it.
#
# stage4 writes /etc/sudoers.d/10-raven-live-installer so the graphical
# installer can reach root on an image whose session user is the `raven`
# placeholder and whose tty1 is already an unauthenticated root shell. Neither
# of those is true of the machine being installed here -- switch_to_raven_init
# has just given tty1 a real login prompt -- so a passwordless route to
# raven-install would be a genuine hole rather than a convenience, and it would
# be one nobody would ever notice, because nothing on the installed system
# prompts for it.
remove_live_credentials() {
    local rule="${TARGET}/etc/sudoers.d/10-raven-live-installer"

    if [[ -f "$rule" ]]; then
        rm -f "$rule"
        ok "Live installer's passwordless sudo rule removed"
    fi
}

# Take the graphical installer off the machine it just installed.
#
# The squashfs is copied wholesale, so everything the live image carries lands
# on the target -- including raven-installer-ui and the "Install RavenLinux"
# entry that puts it in the launcher. On the ISO that entry is the point of the
# image. On the disk it has just written, it is an application whose entire job
# is to partition a disk and copy a system onto it, sitting in the launcher of
# the system it copied, one click away, offering to do it again.
#
# So the entry, its icon, its metainfo -- which is what the store reads -- and
# the binary all go. Removing the binary as well as the entry is deliberate:
# an entry with a binary still behind it is a launcher search away from being
# found by name, which is most of what the entry was doing.
#
# raven-install itself stays. It is not in the launcher, nothing on the desktop
# starts it, and it is what installs this machine onto a second disk, restores
# a bootloader, or reinstalls over the top -- see stage4-iso.sh's
# install_installer(), which puts it in the squashfs for exactly that reason.
# The rule this draws is "no graphical installer on an installed system", not
# "an installed system cannot install".
remove_graphical_installer() {
    local removed=0 f
    local files=(
        "usr/bin/raven-installer-ui"
        "usr/share/applications/com.raveninstaller.Raven.desktop"
        "usr/share/icons/hicolor/scalable/apps/com.raveninstaller.Raven.svg"
        "usr/share/metainfo/com.raveninstaller.Raven.metainfo.xml"
    )

    for f in "${files[@]}"; do
        if [[ -e "${TARGET}/${f}" ]]; then
            rm -f "${TARGET}/${f}" && removed=$((removed + 1))
        fi
    done

    if (( removed > 0 )); then
        ok "Graphical installer removed from the installed system (${removed} files)"
    fi
}

# =============================================================================
# Optional applications
# =============================================================================
# Applications that travel on the install media without being part of the
# system: the GUI stage builds each one into its own tree under OPTIONAL_DIR,
# where the live session neither runs nor advertises it, and this copies the
# trees somebody asked for onto the disk. What nobody asked for never arrives.
#
#   OPTIONAL_DIR/<id>/info   name=... and description=..., one per line
#   OPTIONAL_DIR/<id>/root/  laid out like / -- copied over the target as is
#
# The ids are directory names, so adding an application is a build change and
# nothing here has to learn about it.
OPTIONAL_DIR="usr/share/raven/optional"
OPTIONAL_APPS=()

# Every id the source tree carries, one per line, sorted.
optional_available() {
    local d
    [[ -n "${SRC_ROOT}" && -d "${SRC_ROOT%/}/${OPTIONAL_DIR}" ]] || return 0
    for d in "${SRC_ROOT%/}/${OPTIONAL_DIR}"/*/; do
        [[ -d "${d}root" ]] || continue
        d="${d%/}"
        echo "${d##*/}"
    done | sort
}

# One field of an application's info file, or nothing.
optional_field() {
    local id="$1" key="$2" file="${SRC_ROOT%/}/${OPTIONAL_DIR}/$1/info"
    [[ -f "$file" ]] || return 0
    awk -v k="$key" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$file"
}

optional_names() {
    local id out=()
    (( ${#OPTIONAL_APPS[@]} )) || { echo "none"; return; }
    for id in "${OPTIONAL_APPS[@]}"; do
        out+=("$(optional_field "$id" name || true)")
        [[ -n "${out[-1]}" ]] || out[-1]="$id"
    done
    local IFS=','
    echo "${out[*]}" | sed 's/,/, /g'
}

# The answers file's and --optional's half: validate, never guess. An id this
# media does not carry is refused rather than dropped, for the same reason the
# profile is -- the summary page said it would be installed.
resolve_optional_apps() {
    OPTIONAL_APPS=()
    local list="${OPT_OPTIONAL// /}" id have
    local -a ids=()
    [[ "$list" == "none" ]] && list=""
    local available; available="$(optional_available)"
    IFS=',' read -r -a ids <<< "$list"
    for id in "${ids[@]}"; do
        [[ -z "$id" ]] && continue
        have=0
        grep -qxF -- "$id" <<< "$available" && have=1
        (( have )) || die "optional: '${id}' is not on this install media (have: $(echo $available | tr ' ' ',' ))"
        [[ " ${OPTIONAL_APPS[*]} " == *" ${id} "* ]] || OPTIONAL_APPS+=("$id")
    done
}

# run_wizard's half: ask about each one, default no -- they are optional
# because the system is complete without them.
choose_optional_apps() {
    if (( OPT_OPTIONAL_SET )); then
        resolve_optional_apps
        return
    fi
    OPTIONAL_APPS=()
    local id name desc
    while read -r id; do
        [[ -z "$id" ]] && continue
        name="$(optional_field "$id" name)"
        desc="$(optional_field "$id" description)"
        [[ -n "$desc" ]] && echo "  ${name:-$id}: ${desc}"
        ask_yn "Install ${name:-$id}?" "N" && OPTIONAL_APPS+=("$id")
    done < <(optional_available)
}

# Copies the chosen trees over the target, then removes every payload from it:
# the directory was copied along with the rest of the live root, and an
# installed system has no use for applications it was not asked to have.
install_optional_apps() {
    local id src
    for id in "${OPTIONAL_APPS[@]}"; do
        src="${SRC_ROOT%/}/${OPTIONAL_DIR}/${id}/root"
        if [[ ! -d "$src" ]]; then
            warn "Optional app ${id} is not on the install media; skipped"
            continue
        fi
        if cp -a "${src}/." "${TARGET}/"; then
            ok "Installed $(optional_field "$id" name || true) (${id})"
        else
            warn "Could not install optional app ${id}"
        fi
    done
    rm -rf "${TARGET:?}/${OPTIONAL_DIR}"
}

# Put the seatd service definition where raven-rc can see it.
#
# The other templates under /usr/share/raven/services are inert until `rvn
# install <pkg>` brings their daemon in. seatd is different: it is already in
# the base image next to huginn, so there is no install step to hook and the
# template would sit in /usr/share forever.
#
# It matters on a console boot. raven-init only creates a seatd service on
# raven.graphics=wayland, so booting the plain entry and trying to run the
# compositor from a TTY -- the workflow RavenGUI's scripts/tty-session.sh
# documents -- hit "no such service" from raven-rc and "Failed to open session:
# Function not implemented" from huginn, with nothing to start in between.
#
# Copied disabled. init's ensure_service overwrites enabled/exec/args from its
# own copy on a graphical boot, so this never holds seatd off when the session
# needs it.
install_seat_service() {
    local src="${TARGET}/usr/share/raven/services/seatd.toml"
    local dest_dir="${TARGET}/etc/raven/init.d"

    [[ -f "${src}" ]] || return 0
    [[ -x "${TARGET}/sbin/seatd" || -x "${TARGET}/usr/bin/seatd" ]] || return 0

    mkdir -p "${dest_dir}"
    if cp "${src}" "${dest_dir}/seatd.toml" 2>/dev/null; then
        ok "seatd service available to raven-rc (disabled; enable for TTY sessions)"
    fi
}

# The service that installs the recorded profile at first boot. Its template
# ships disabled (see configs/raven/services/postinstall.toml); the installed
# system is the one place it is meant to run, so this is where it is enabled.
# The drop-in is written even when the packages are installed before reboot:
# the script is a no-op once /etc/raven/.postinstall-done exists, and a system
# whose install-time attempt failed is exactly the one that needs the retry.
install_postinstall_service() {
    local src="${TARGET}/usr/share/raven/services/postinstall.toml"
    local dest_dir="${TARGET}/etc/raven/init.d"

    if [[ ! -x "${TARGET}/usr/bin/raven-postinstall" ]]; then
        warn "No raven-postinstall in the image; the ${INSTALL_PROFILE} profile must be installed by hand."
        return 0
    fi

    mkdir -p "${dest_dir}"
    if [[ -f "${src}" ]]; then
        sed 's/^enabled = false$/enabled = true/' "${src}" > "${dest_dir}/postinstall.toml"
    else
        # An image older than the template. The service is small enough to
        # write here rather than leave the promise unkept.
        cat > "${dest_dir}/postinstall.toml" <<'TOML'
# Written by raven-install: installs the recorded package profile at first boot.
[[services]]
name = "postinstall"
description = "Install the package profile chosen at install time"
exec = "/usr/bin/raven-postinstall"
args = ["--auto"]
after = ["udev"]
restart = false
enabled = true
critical = false
TOML
    fi
    chmod 0644 "${dest_dir}/postinstall.toml"
    ok "postinstall service enabled: the ${INSTALL_PROFILE} profile installs at first boot with a network"
}

# Install the profile's packages into the new system now, from the live
# session, so the machine is complete at its first boot. rvn runs inside a
# chroot of the target with the live session's network. After the bootloader:
# a failure here must never be able to leave a disk that does not boot, and
# it cannot, because the first-boot service retries anyway.
apply_profile_now() {
    phase packages "Installing the ${INSTALL_PROFILE} package profile"

    if [[ "$INSTALL_PROFILE" == "minimal" ]]; then
        info "The minimal profile has no packages to install."
        return 0
    fi
    if (( ! ${POSTINSTALL_NOW:-0} )); then
        info "Deferred: the postinstall service installs it at first boot once there is a network."
        return 0
    fi
    if [[ ! -x "${TARGET}/usr/bin/raven-postinstall" || ! -x "${TARGET}/usr/bin/rvn" ]]; then
        warn "The image lacks raven-postinstall or rvn; nothing to run."
        return 0
    fi
    if ! have_default_route; then
        warn "No network now; the postinstall service will do it at first boot."
        return 0
    fi

    local d rc=0
    for d in proc sys dev dev/pts; do
        mkdir -p "${TARGET}/${d}"
        mount --bind "/${d}" "${TARGET}/${d}" || { warn "Cannot bind /${d} into the target; deferred to first boot."; rc=1; break; }
    done
    if (( rc == 0 )); then
        # A tmpfs, so the script's own /run markers do not land on the disk.
        mkdir -p "${TARGET}/run"
        mount -t tmpfs tmpfs "${TARGET}/run" 2>/dev/null || true
        # The live session's resolver, whatever it is a symlink to. The
        # target's /etc/resolv.conf is a link to /run/caw/resolv.conf (see
        # stage2), and /run in there is the empty tmpfs mounted just above,
        # so the link dangles inside the chroot until the file it names is
        # written there. Copying onto the link itself would follow it out to
        # the live system's /run instead.
        if [[ -e /etc/resolv.conf ]]; then
            local resolver="${TARGET}/etc/resolv.conf"
            if [[ -L "${resolver}" ]]; then
                local link
                link="$(readlink "${resolver}")"
                [[ "${link}" == /* ]] || link="/etc/${link}"
                resolver="${TARGET}${link}"
                mkdir -p "$(dirname "${resolver}")"
            fi
            cp -L /etc/resolv.conf "${resolver}" 2>/dev/null || true
        fi

        info "Running raven-postinstall in the new system (this needs the network and can take a while)"
        if chroot "$TARGET" /usr/bin/raven-postinstall -y --profile "${INSTALL_PROFILE}"; then
            ok "${INSTALL_PROFILE} profile installed"
            PROFILE_INSTALLED_NOW=1
        else
            warn "raven-postinstall failed; the postinstall service will retry at first boot."
        fi
        umount "${TARGET}/run" 2>/dev/null || true
    fi
    for d in dev/pts dev sys proc; do
        umount "${TARGET}/${d}" 2>/dev/null || true
    done
    sync
}

configure_system() {
    phase configure "Configuring the installed system"

    NEEDS_PASSWORD_ON_FIRST_BOOT=0

    mount_home
    write_fstab
    write_crypttab
    set_hostname
    create_user
    set_passwords
    set_locale_and_time
    switch_to_raven_init
    remove_live_credentials
    remove_graphical_installer
    install_optional_apps
    install_seat_service
    install_postinstall_service
    {
        echo "profile=${INSTALL_PROFILE}"
        echo "optional=${OPTIONAL_APPS[*]:-}"
        echo "configured_by=raven-install"
    } > "${TARGET}/etc/raven/install-profile"

    sync
}

# =============================================================================
# Bootloader
# =============================================================================

install_bootloader() {
    phase boot "Installing RavenBoot to the ESP"

    local esp="${TARGET}/boot/efi"
    mkdir -p "${esp}/EFI/BOOT" "${esp}/EFI/raven"

    # \EFI\BOOT\BOOTX64.EFI is the removable-media fallback: one file, one
    # name, and whatever is in it is what the firmware runs when no NVRAM entry
    # matches. On a disk that already has an OS, something is usually in it
    # already -- OEM machines ship a copy of the Windows loader there -- and
    # overwriting it is exactly how a dual-boot install ends up being the only
    # thing that boots.
    #
    # Keeping a copy is not a nicety. RavenBoot chainloads the other OS from
    # its own menu, so the normal path is unaffected, but if RavenLinux is
    # later removed the machine is left with a fallback loader pointing at a
    # partition that is gone. Renaming rather than deleting means putting it
    # back is one file operation from any live image.
    if (( ESP_REUSED )) && [[ -f "${esp}/EFI/BOOT/BOOTX64.EFI" ]] \
       && [[ ! -f "${esp}/EFI/BOOT/BOOTX64.RAVENBAK.EFI" ]]; then
        if cp "${esp}/EFI/BOOT/BOOTX64.EFI" "${esp}/EFI/BOOT/BOOTX64.RAVENBAK.EFI" 2>/dev/null; then
            ok "Existing fallback loader kept as \\EFI\\BOOT\\BOOTX64.RAVENBAK.EFI"
        else
            warn "Could not back up the existing \\EFI\\BOOT\\BOOTX64.EFI; it will be replaced"
        fi
    fi

    cp "$SRC_EFI" "${esp}/EFI/raven/raven-boot.efi" || die "Cannot write RavenBoot to the ESP"
    # The fallback path. Firmware booting a disk with no matching NVRAM entry
    # looks here, which is what makes this work without touching NVRAM at all.
    cp "$SRC_EFI" "${esp}/EFI/BOOT/BOOTX64.EFI" || die "Cannot write the fallback bootloader"
    ok "RavenBoot at \\EFI\\raven and \\EFI\\BOOT\\BOOTX64.EFI"

    cp "$SRC_KERNEL" "${esp}/EFI/raven/vmlinuz" || die "Cannot copy the kernel to the ESP"
    # 8.3-safe name: some firmware is unhappy with long names in the boot path.
    cp "$SRC_INITRD" "${esp}/EFI/raven/initrd.img" || die "Cannot copy the initramfs to the ESP"
    ok "Kernel and initramfs on the ESP"

    # Keep a copy in /boot on the root filesystem too, so a later
    # 'raven-install --help'-free reinstall of the bootloader has a source and
    # the installed system is not dependent on the ESP for its own kernel.
    mkdir -p "${TARGET}/boot"
    cp "$SRC_KERNEL" "${TARGET}/boot/vmlinuz" 2>/dev/null || true
    cp "$SRC_INITRD" "${TARGET}/boot/initramfs.img" 2>/dev/null || true

    # rootflags= carries the root's mount options, because nothing else can.
    #
    # /etc/fstab cannot: raven-init's mount_fstab skips the root outright, on
    # the grounds that the initramfs mounted it already and remounting a live
    # root to change its flags is a worse idea than leaving them. The
    # initramfs can, and this is how it is told -- raven_root_from_cmdline
    # parses rootflags= and raven_mount_disk_root appends it to the mount, so
    # the root comes up noatime from its very first mount rather than being
    # corrected later, which means not even the boot's own reads write an
    # atime. write_fstab's root line says the same thing so that a later
    # `mount -o remount /` agrees with this; see the reasoning there for why
    # noatime and not relatime.
    local base_cmdline="root=UUID=${ROOT_UUID} rw rootflags=noatime"

    # A btrfs root is mounted from a subvolume, and rootflags= is the only
    # channel that can say which one -- so on btrfs the noatime above grows
    # into the full option string from btrfs_root_flags().
    #
    # It is folded into the existing rootflags= rather than appended as a
    # second one. The initramfs parses the command line in a loop and the last
    # rootflags= it sees wins, so two of them would work by accident; a person
    # reading boot.cfg to find out how their root is mounted should not have
    # to know which end of the line the parser started from.
    #
    # And the literal `rootflags=noatime` above is kept literal on purpose.
    # test-raven-install.sh:561 greps this exact source line for that exact
    # string, and that assertion is the one that catches the change that edits
    # the fstab, forgets the command line, reviews perfectly and does nothing
    # on the machine -- because raven-init's mount_fstab skips the root.
    if [[ "${OPT_FS}" == "btrfs" ]]; then
        local root_flags
        root_flags="$(btrfs_root_flags)"
        base_cmdline="${base_cmdline/rootflags=noatime/rootflags=${root_flags}}"
        info "Root subvolume: @ (rootflags=${root_flags})"
    fi

    # cryptdevice=: which container holds that root, and what to call it.
    #
    # It goes in front of nothing and after nothing in particular -- the
    # initramfs parses the whole line -- but the relationship between this and
    # the root=UUID= above is worth being exact about, because getting it
    # backwards produces a boot.cfg that looks right and a machine that never
    # starts. root=UUID= names the *filesystem* UUID, which lives inside the
    # container and is invisible until the container is open. cryptdevice=
    # names the *LUKS header* UUID, which is on the partition and is what can
    # be found before anything has been unlocked. They are two different
    # UUIDs on two different devices and neither can stand in for the other.
    #
    # The form is `cryptdevice=<spec>:<name>`, which is mkinitcpio's, because
    # somebody arriving here from Arch already knows it and because there is
    # no value in inventing a fourth spelling of the same idea.
    #
    # cryptswap= is ours and has no equivalent elsewhere: the second container
    # is opened with the same passphrase, so that hibernating writes its image
    # into encrypted swap and the next boot can read it back. See
    # encrypt_partitions() for why the swap is a second container rather than
    # a volume inside the first.
    if (( ENCRYPT )); then
        [[ -n "$ROOT_CRYPT_UUID" ]] \
            || die "Encrypted install with no LUKS UUID for the root container; refusing to write an unbootable boot.cfg."
        base_cmdline+=" cryptdevice=UUID=${ROOT_CRYPT_UUID}:${CRYPT_ROOT_NAME}"
        info "Root container: UUID=${ROOT_CRYPT_UUID} -> /dev/mapper/${CRYPT_ROOT_NAME}"
        if [[ -n "$SWAP_CRYPT_UUID" ]]; then
            base_cmdline+=" cryptswap=UUID=${SWAP_CRYPT_UUID}:${CRYPT_SWAP_NAME}"
            info "Swap container: UUID=${SWAP_CRYPT_UUID} -> /dev/mapper/${CRYPT_SWAP_NAME}"
        fi
    fi

    # resume=: without it, hibernation on the installed machine is a trap.
    #
    # The kernel is perfectly willing to hibernate as things stand.
    # CONFIG_HIBERNATION is on, and `echo disk > /sys/power/state` finds the
    # swap partition, writes the whole suspend image into it and powers the
    # machine off. What does not happen is the other half. Nothing reads that
    # image back unless the boot that follows is told which device to look in,
    # so the machine comes up fresh, the image is abandoned, and every unsaved
    # thing in that session is gone with no error printed anywhere. That
    # asymmetry -- the dangerous half works, the recovering half silently does
    # not -- is why init/src/power.rs leaves `disk` out of its sleep states
    # and offers only mem and freeze. This line is what unblocks that.
    #
    # It goes on every entry, which is deliberate and not just tidiness. A
    # suspend image is only valid against the filesystem exactly as it stood
    # when the snapshot was taken. Booting the verbose or the rescue entry
    # after a hibernate would mount the same root rw and start writing to it,
    # and a resume attempted after that hands the resumed kernel a page cache
    # describing a filesystem that has since moved. Since base_cmdline is
    # shared by all of them, every entry either resumes or refuses to; none of
    # them can half-do it.
    #
    # UUID= rather than PARTUUID= or a device node is a choice with a
    # consequence, so it is worth stating. The kernel's own resume= parser
    # understands PARTUUID=, PARTLABEL=, major:minor and /dev/ names, but not
    # a filesystem UUID, which needs a superblock read. Writing PARTUUID=
    # here would therefore resume with no help from userspace at all -- and it
    # would do it from a late initcall, which on NVMe regularly runs before
    # the disk has finished probing. That race is exactly what
    # raven_mount_disk_root polls thirty seconds to avoid, and a resume that
    # silently does not happen is the failure being removed here, not one to
    # reintroduce in a new place. So the resolution belongs where the root's
    # already is: /init must parse resume=, put it through raven_resolve_root
    # -- which handles UUID= via blkid and polls until the node exists -- and
    # write the resulting device to /sys/power/resume BEFORE it mounts the
    # root rw. Resuming after the root has been mounted writable is how the
    # filesystem gets corrupted rather than merely stale.
    #
    # If an initramfs does not do that, this is inert and not harmful: the
    # kernel cannot parse a filesystem UUID, says so once, and the machine
    # boots fresh exactly as it does today.
    #
    # ON AN ENCRYPTED INSTALL this line still says resume=UUID=<swap UUID>,
    # and that is correct rather than an oversight -- but only because
    # SWAP_DEV was pointed at /dev/mapper/ravenswap in encrypt_partitions()
    # before write_fstab read it. The UUID below is therefore the swap
    # signature's, written by mkswap *inside* the container, and the only
    # device that can ever carry it is the open mapper node. The wrong version
    # of this line -- the UUID of the raw partition -- is the LUKS header's,
    # names a device that is not swap, and produces a machine that hibernates
    # happily and then boots fresh every time with nothing in the log. The
    # initramfs resolves this after it has opened the containers, which is the
    # other half of the same requirement.
    if [[ -n "${SWAP_UUID:-}" ]]; then
        base_cmdline+=" resume=UUID=${SWAP_UUID}"
        info "Hibernate will resume from UUID=${SWAP_UUID}"
    elif [[ -n "$SWAP_DEV" ]]; then
        # write_fstab leaves SWAP_UUID empty only when blkid could not read
        # the partition it had just run mkswap over, which is strange enough
        # to say out loud -- the same condition drops the swap line from the
        # fstab, so this machine has no swap at all and the install is
        # otherwise fine.
        warn "No UUID for ${SWAP_DEV}; no resume= written and hibernate will not work"
    fi

    # Dell firmware can hang on the kernel's default ACPI reset: a Latitude
    # 5350 went to a black screen with the backlight on and never reached
    # POST, and reboot=efi did no better. The PCI reset (port 0xcf9) is what
    # brings it back. Dells only -- elsewhere the default is known to work,
    # and forcing a reset method on unknown firmware can break a good one.
    # The installer runs on the target, so its DMI vendor is the machine's.
    local sys_vendor=""
    sys_vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
    if [[ "$sys_vendor" == Dell* ]]; then
        base_cmdline+=" reboot=pci"
        info "Dell firmware detected; adding reboot=pci"
    fi

    # Does this root actually carry a compositor? The Desktop entry is written
    # only if it does, so everything below keys off the same answer.
    local has_desktop=0
    if [[ -x "${TARGET}/usr/bin/huginn" || -x "${TARGET}/bin/huginn" ]]; then
        has_desktop=1
    fi

    # Which entry the menu preselects.
    #
    # This was a hardcoded `default = 0` -- the console entry -- so
    # `raven-install --profile desktop` installed a compositor, wrote a Desktop
    # entry for it, and then booted past it to a text console every time.
    # raven-init starts seatd and the session only on raven.graphics=wayland,
    # so the machine came up with no seat, no /run/user/0 and no huginn: a
    # desktop install with no desktop, unless you caught the five-second menu
    # and arrowed down one.
    #
    # Console profiles still default to console. Only a profile that asked for
    # a graphical system gets one without being asked twice.
    local default_entry=0
    if (( has_desktop )); then
        case "${INSTALL_PROFILE}" in
            desktop|developer) default_entry=1 ;;
        esac
    fi

    {
        echo "# RavenBoot configuration -- written by raven-install"
        echo "# Paths are relative to the EFI System Partition."
        echo
        echo "timeout = 5"
        echo "default = ${default_entry}"
        echo
        echo "[entry]"
        echo "name = \"RavenLinux\""
        echo "kernel = \"\\EFI\\raven\\vmlinuz\""
        echo "initrd = \"\\EFI\\raven\\initrd.img\""
        echo "cmdline = \"${base_cmdline} quiet loglevel=3 console=tty0\""
        echo "type = linux-efi"
        echo

        if (( has_desktop )); then
            echo "[entry]"
            echo "name = \"RavenLinux (Desktop)\""
            echo "kernel = \"\\EFI\\raven\\vmlinuz\""
            echo "initrd = \"\\EFI\\raven\\initrd.img\""
            echo "cmdline = \"${base_cmdline} quiet loglevel=3 raven.graphics=wayland raven.wayland=huginn console=tty0\""
            echo "type = linux-efi"
            echo
        fi

        echo "[entry]"
        echo "name = \"RavenLinux (verbose)\""
        echo "kernel = \"\\EFI\\raven\\vmlinuz\""
        echo "initrd = \"\\EFI\\raven\\initrd.img\""
        echo "cmdline = \"${base_cmdline} loglevel=7 console=tty0 console=ttyS0,115200\""
        echo "type = linux-efi"
        echo

        # The escape hatch. If login, init or a service is broken, this still
        # gets a root shell on the installed root with nothing else running.
        echo "[entry]"
        echo "name = \"RavenLinux (rescue shell)\""
        echo "kernel = \"\\EFI\\raven\\vmlinuz\""
        echo "initrd = \"\\EFI\\raven\\initrd.img\""
        echo "cmdline = \"${base_cmdline} init=/bin/bash console=tty0\""
        echo "type = linux-efi"
        echo

        # RavenBoot's parser drops any entry whose kernel is empty, so these
        # three carry a placeholder path. It is never read: handle_entry_selection
        # dispatches on the type and returns before anything is loaded.
        echo "# The kernel lines below are placeholders that RavenBoot's parser"
        echo "# requires. The type field is what decides what these entries do."
        echo "[entry]"
        echo "name = \"System UEFI Settings\""
        echo "kernel = \"firmware-setup\""
        echo "type = firmware-setup"
        echo

        echo "[entry]"
        echo "name = \"Reboot\""
        echo "kernel = \"reboot\""
        echo "type = reboot"
        echo

        echo "[entry]"
        echo "name = \"Shutdown\""
        echo "kernel = \"shutdown\""
        echo "type = shutdown"
    } > "${esp}/EFI/raven/boot.cfg"

    ok "boot.cfg written (root=UUID=${ROOT_UUID}${SWAP_UUID:+, resume=UUID=${SWAP_UUID}})"

    if [[ $OPT_NVRAM -eq 1 ]]; then
        register_nvram_entry
    else
        info "No NVRAM entry written; booting via the fallback path"
    fi

    sync
}

register_nvram_entry() {
    if ! have efibootmgr; then
        warn "efibootmgr is not installed; skipping the NVRAM entry"
        echo "        The fallback path still boots, so this is not fatal."
        return 0
    fi

    # efibootmgr wants the disk and the ESP's partition number separately.
    local partnum="${ESP_DEV##*[!0-9]}"

    # Drop any entry we wrote on a previous run, so reinstalling does not leave
    # a row of identical "RavenLinux" entries behind.
    local old
    for old in $(efibootmgr 2>/dev/null | awk '/[[:space:]]RavenLinux$/ {print substr($1,5,4)}'); do
        efibootmgr -B -b "$old" >/dev/null 2>&1 || true
    done

    if efibootmgr -c -d "$DISK" -p "$partnum" \
        -L "RavenLinux" -l '\EFI\raven\raven-boot.efi' >/dev/null 2>&1; then
        ok "UEFI NVRAM entry 'RavenLinux' registered"
    else
        warn "efibootmgr could not write the NVRAM entry"
        echo "        The fallback path still boots, so this is not fatal."
    fi
}

# =============================================================================
# Secure Boot
# =============================================================================
#
# What this is for. RavenBoot is Raven's own EFI binary, built here, signed by
# nobody a firmware has heard of. A machine with Secure Boot enabled will not
# load it, which is why every other part of this installer says "turn Secure
# Boot off". Turning it off is a real answer and stays the default. The other
# real answer is to make the firmware trust THIS machine's own key instead of
# the vendor's, and that is what the code below does.
#
# THE CHAIN THAT HAS TO BE SIGNED, and it is exactly three files:
#
#   \EFI\BOOT\BOOTX64.EFI     RavenBoot, as the firmware's fallback path
#   \EFI\raven\raven-boot.efi RavenBoot, as an NVRAM entry points at it
#   \EFI\raven\vmlinuz        the kernel
#
# The kernel is on that list because RavenBoot does not hand-roll the Linux
# boot protocol: bootloader/src/linux.rs loads the kernel with the firmware's
# own LoadImage and StartImage, so an enforcing firmware verifies the kernel
# image the same way it verified the loader. A signed loader and an unsigned
# kernel is a machine that shows its boot menu and then stops. The initramfs is
# NOT on the list and cannot be: it is handed over through the LoadFile2
# protocol, which has no signature check, and the kernel is what measures it.
#
# GRUB IS NOT ON THAT LIST EITHER, and the task that asked for this expected it
# to be. It is not: raven-install never installs GRUB. configs/grub holds a
# theme, grub.cfg is generated inside stage4-iso.sh for the live ISO, and
# bootloader/preview/src/grub.rs says in as many words that GRUB here is BIOS-only. The
# EFI binary an installed Raven machine boots is RavenBoot, so RavenBoot is
# what gets signed.
#
# MODULES ARE NOT SIGNED AND THAT IS DELIBERATE. CONFIG_MODULE_SIG is off, with
# the reasoning written out at the symbol in configs/kernel/config-6.17-raven
# and in docs/kernel-hardening.md: turning it on means every DKMS rebuild of
# evdi (the DisplayLink dock) and of the NVIDIA modules has to be signed on the
# target machine with a key the target machine does not have. Secure Boot
# without module signing verifies everything up to and including the kernel and
# nothing after it. That is a smaller guarantee than a distribution with a
# signing infrastructure offers, and it is a much larger one than nothing, and
# it does not break anybody's dock. See docs/secure-boot.md.
#
# WHY THIS RUNS INSIDE THE TARGET rather than with the live image's sbctl.
# sbctl keeps its key set and its list of files to re-sign in /var/lib/sbctl,
# on the machine it was run on. The live image's copy of that is a tmpfs that
# ceases to exist at the next reboot -- so keys made there would be enrolled
# into the firmware and then thrown away, leaving a machine whose firmware
# trusts a key nobody has, and whose next kernel update cannot be signed by
# anyone. Running it in a chroot of the new system puts the keys where they
# will still be tomorrow, and makes `sbctl sign-all` after a kernel update the
# one command it should be.
#
# EVERY STEP HERE IS REVERSIBLE, and they are ordered so that the reversible
# ones all happen before the one that touches the firmware:
#
#   create-keys  writes /var/lib/sbctl on the new disk. Undone with rm -rf.
#   sign         adds a signature to an EFI binary. A firmware that is not
#                checking ignores it completely, so this changes nothing about
#                how the machine boots. Undone by copying the file back, or by
#                reinstalling, or by ignoring it.
#   enroll-keys  hands the firmware a new Platform Key. This is the one that
#                matters, it is done last, it is done only in setup mode, and
#                it is done only if every signature above succeeded. Undone
#                with `sbctl reset` from the installed system, or with
#                "restore factory keys" in the firmware setup.
#
# And the machine still boots with Secure Boot OFF at every point in that
# sequence, including after a failure half way through, because none of it
# removes anything.

setup_secure_boot() {
    phase secureboot "Secure Boot"
    setup_secure_boot_step

    # What actually happened, on the progress stream and nowhere else -- there
    # is nothing here a person reading a terminal has not already been told in
    # full sentences. It is emitted from a wrapper rather than from the step
    # itself because the step returns early from five different places and this
    # has to be true of all of them.
    #
    # It exists because the last page of the graphical front-end has to choose
    # between "boot once, then turn Secure Boot on" and "leave Secure Boot
    # off", and choosing from the ANSWER rather than from the outcome is how
    # somebody whose enrolment failed gets told to switch on a firmware check
    # their machine cannot pass. One of: none, skipped, signed, enrolled,
    # failed.
    emit info "secure-boot: ${SECUREBOOT_RESULT:-none}"
    return 0
}

setup_secure_boot_step() {
    if [[ "$OPT_SECUREBOOT" == "skip" ]]; then
        info "Secure Boot: not touched. The machine boots with it off."
        return 0
    fi

    if ! secureboot_tool; then
        warn "sbctl is not on the installed system; nothing was signed."
        echo "        No key was enrolled and the firmware was not touched, so this"
        echo "        install is exactly what it would have been without the option."
        echo "        From the installed system, once sbctl is there:"
        secure_boot_manual_steps
        SECUREBOOT_RESULT="skipped"
        return 0
    fi
    if ! have chroot; then
        warn "chroot is not on this image; Secure Boot setup needs it. Nothing was signed."
        SECUREBOOT_RESULT="skipped"
        return 0
    fi

    # The three files, as the installed system sees them. /boot/efi is where
    # write_fstab mounts the ESP and where it is mounted right now.
    local -a targets=(
        /boot/efi/EFI/BOOT/BOOTX64.EFI
        /boot/efi/EFI/raven/raven-boot.efi
        /boot/efi/EFI/raven/vmlinuz
    )
    local t
    for t in "${targets[@]}"; do
        if [[ ! -f "${TARGET}${t}" ]]; then
            warn "${t} is not on the ESP; Secure Boot setup skipped."
            echo "        install_bootloader should have put it there. Nothing was signed"
            echo "        and no key was enrolled."
            SECUREBOOT_RESULT="skipped"
            return 0
        fi
    done

    # /sys is rbind rather than bind on purpose: efivarfs is a filesystem of
    # its own mounted at /sys/firmware/efi/efivars, and a plain --bind of /sys
    # gives the chroot an empty directory there -- which sbctl reads as "this
    # machine has no EFI variables" rather than as "I cannot see them".
    local -a binds=(proc sys dev)
    local d bound=()
    local mounted_ok=1
    for d in "${binds[@]}"; do
        mkdir -p "${TARGET}/${d}"
        if mount --rbind "/${d}" "${TARGET}/${d}" 2>/dev/null; then
            bound+=("$d")
            # Made a slave immediately, and this is not a nicety. A recursive
            # bind of a mount that is shared -- which / usually is -- creates
            # peers, and an unmount of a peer PROPAGATES: the umount -R below,
            # or finish()'s umount -R of the whole target, would take the live
            # system's own /sys or /dev down with it, in the middle of an
            # install, with no error to say what happened. Slave propagation
            # still passes mounts in (so efivarfs is visible in the chroot) and
            # passes nothing back out.
            mount --make-rslave "${TARGET}/${d}" 2>/dev/null || \
                warn "Could not make ${TARGET}/${d} a slave mount; unmounting it may affect the live system."
        else
            warn "Cannot bind /${d} into the new system; Secure Boot setup skipped."
            mounted_ok=0
            break
        fi
    done

    if (( mounted_ok )); then
        secure_boot_run_sbctl || true
    else
        SECUREBOOT_RESULT="skipped"
    fi

    # Reverse order, recursive, and unconditional. A bind of /sys left behind
    # would keep the target mounted and finish()'s umount -R would take the
    # host's /sys down with it.
    local i
    for (( i=${#bound[@]}-1; i>=0; i-- )); do
        umount -R "${TARGET}/${bound[i]}" 2>/dev/null || \
            warn "Could not unmount ${TARGET}/${bound[i]}"
    done

    sync
    return 0
}

# The part that runs with the chroot's mounts in place. Split out so the
# unmounts above are one block with no early return in front of them: leaving a
# recursive bind of /sys on the target is how finish()'s umount -R takes the
# live system's /sys with it.
secure_boot_run_sbctl() {
    local sb=(chroot "$TARGET" /usr/bin/sbctl)

    local ver
    ver="$("${sb[@]}" version 2>/dev/null | head -1)"
    info "sbctl: ${ver:-version not reported}"

    # create-keys is not idempotent in every version -- some refuse when a key
    # set is already there, some say so and succeed -- so an existing key set
    # is checked for first and its presence is the success condition either
    # way. Both paths are looked at because sbctl moved from the second to the
    # first in 0.14 and an installed system may have either.
    local keydir found_keys=0
    for keydir in /var/lib/sbctl/keys /usr/share/secureboot/keys; do
        [[ -d "${TARGET}${keydir}" ]] && found_keys=1 && break
    done
    if (( found_keys )); then
        info "A key set is already present at ${keydir}; keeping it."
    else
        if ! "${sb[@]}" create-keys; then
            warn "sbctl create-keys failed; nothing was signed and no key was enrolled."
            echo "        The firmware was not touched. docs/secure-boot.md has the"
            echo "        manual route, which is the same commands run by hand."
            SECUREBOOT_RESULT="failed"
            return 1
        fi
        ok "Secure Boot key set created in the new system"
    fi

    # -s records the file in sbctl's own database, which is what makes
    # `sbctl sign-all` after a kernel update re-sign the right files. Without
    # it the signature is applied once and the first kernel update silently
    # produces an unsigned kernel and a machine that stops at the boot menu.
    local t signed=0 failed=0
    for t in /boot/efi/EFI/BOOT/BOOTX64.EFI \
             /boot/efi/EFI/raven/raven-boot.efi \
             /boot/efi/EFI/raven/vmlinuz; do
        if "${sb[@]}" sign -s "$t"; then
            signed=$((signed + 1))
        else
            warn "sbctl could not sign ${t}"
            failed=$((failed + 1))
        fi
    done

    if (( failed )); then
        warn "${failed} of $((signed + failed)) files could not be signed."
        echo "        No key was enrolled: a firmware that trusts this machine's key"
        echo "        and a boot chain that is only partly signed is a machine that"
        echo "        stops at the loader. Secure Boot stays off and the install is"
        echo "        otherwise complete."
        SECUREBOOT_RESULT="failed"
        return 1
    fi
    ok "RavenBoot, the fallback loader and the kernel are signed"
    SECUREBOOT_RESULT="signed"

    # Informational. Not the gate -- the gate is the per-file exit status
    # above, because `sbctl verify` walks the whole ESP and reports on files
    # that are not ours (another OS's loader, on a shared ESP) which are not
    # this installer's to sign and must not make it look as if something went
    # wrong.
    "${sb[@]}" verify 2>/dev/null || true

    [[ "$OPT_SECUREBOOT" == "enroll" ]] || return 0

    # Read the firmware again rather than trusting what preflight saw. Minutes
    # have passed, and the one thing that must not happen is writing a Platform
    # Key into a firmware that is no longer in setup mode -- where the write is
    # refused half way through with some of the other variables already
    # changed.
    read_secureboot_state
    if [[ "$SECUREBOOT_SETUP" != "1" ]]; then
        warn "The firmware is no longer in setup mode; no key was enrolled."
        echo "        The binaries are signed, which is harmless and useful: enrolling"
        echo "        later is one command. See docs/secure-boot.md."
        return 0
    fi

    # --microsoft enrols Microsoft's KEK and their two db certificates
    # alongside ours, and it is not a concession -- it is what keeps the
    # machine working. Without them a dual-booting machine stops booting
    # Windows (its loader is signed by exactly those certificates, and
    # RavenBoot chainloads it through the firmware's LoadImage, which checks),
    # and any card whose option ROM is signed by them stops initialising,
    # which on some machines is the discrete GPU and on others is the network
    # card the firmware boots from. Somebody who genuinely wants only their own
    # key can run `sbctl enroll-keys` by hand afterwards; that is a decision to
    # make deliberately on a machine that is already booting, not one to make
    # for them here.
    #
    # The second attempt is for older sbctl, where the same option was spelled
    # -m. A failed enroll-keys leaves setup mode intact -- there is no Platform
    # Key either way -- so trying twice costs nothing and risks nothing.
    info "Enrolling this machine's keys, with Microsoft's certificates alongside them."
    if "${sb[@]}" enroll-keys --microsoft || "${sb[@]}" enroll-keys -m; then
        read_secureboot_state
        if [[ "$SECUREBOOT_SETUP" == "1" ]]; then
            # The command succeeded and the firmware still says setup mode.
            # Reported rather than celebrated: some firmware does not update
            # the variable until the next boot, and some silently discards the
            # write, and this installer cannot tell those apart.
            warn "sbctl enroll-keys succeeded, but the firmware still reports setup mode."
            echo "        That is either a firmware that updates the variable at the next"
            echo "        boot, or a write it quietly discarded. Check with 'sbctl status'"
            echo "        after rebooting, BEFORE turning Secure Boot on."
            SECUREBOOT_RESULT="enrolled"
            return 0
        fi
        ok "Secure Boot keys enrolled; the firmware now holds this machine's Platform Key"
        SECUREBOOT_RESULT="enrolled"
        return 0
    fi

    warn "sbctl enroll-keys failed; no key was enrolled."
    echo "        The firmware is unchanged and still in setup mode, and the boot"
    echo "        binaries are signed. Nothing is broken and nothing is half done."
    echo "        Try it again from the installed system:"
    secure_boot_manual_steps
    return 1
}

# The commands somebody runs by hand when the installer could not. Printed by
# more than one failure path, so there is one copy of them and it cannot drift
# from what docs/secure-boot.md says.
secure_boot_manual_steps() {
    echo "          sudo sbctl create-keys"
    echo "          sudo sbctl sign -s /boot/efi/EFI/BOOT/BOOTX64.EFI"
    echo "          sudo sbctl sign -s /boot/efi/EFI/raven/raven-boot.efi"
    echo "          sudo sbctl sign -s /boot/efi/EFI/raven/vmlinuz"
    echo "          sudo sbctl enroll-keys --microsoft    # setup mode only"
    echo "        Then turn Secure Boot on in the firmware. 'sbctl reset' undoes it."
}

# =============================================================================
# Finish
# =============================================================================

finish() {
    phase finish "Finishing up"

    sync
    umount "${TARGET}/boot/efi" 2>/dev/null
    umount -R "$TARGET" 2>/dev/null
    # mount(8) attached the loop device for the squashfs; umount detaches it.
    mountpoint -q "$SRCMNT" && umount "$SRCMNT" 2>/dev/null
    # The install is over, so the containers are locked again rather than left
    # open on a live session somebody may walk away from.
    close_crypt_devices
    ok "Filesystems unmounted"

    echo
    echo "${GREEN}==========================================${NC}"
    echo "${GREEN}  RavenLinux is installed on ${DISK}${NC}"
    echo "${GREEN}==========================================${NC}"
    echo
    echo "  Log in as ${WHITE}${USERNAME}${NC} on tty1."
    if [[ "$INSTALL_PROFILE" != "minimal" ]]; then
        if (( ${PROFILE_INSTALLED_NOW:-0} )); then
            echo "  The ${INSTALL_PROFILE} package profile is installed."
        else
            echo "  The ${INSTALL_PROFILE} package profile installs itself at first boot once"
            echo "  there is a network. The login screen says so until it has; to run it"
            echo "  by hand: ${WHITE}sudo raven-postinstall${NC}"
        fi
    fi
    if [[ ${NEEDS_PASSWORD_ON_FIRST_BOOT:-0} -eq 1 ]]; then
        echo "  ${YELLOW}No password was set, and the login screen cannot be passed without one.${NC}"
        echo "  ${YELLOW}Boot 'RavenLinux (rescue shell)' and run passwd ${USERNAME} first.${NC}"
    fi
    if (( ENCRYPT )); then
        echo "  ${YELLOW}This disk is encrypted.${NC} Every boot stops at"
        echo "      Unlock ${DISK} (/dev/mapper/${CRYPT_ROOT_NAME}):"
        echo "  and waits for the passphrase. It is typed on a US keyboard layout --"
        echo "  the initramfs loads no keymap -- and there is no recovery key."
        echo "  Add a second passphrase from the installed system with:"
        echo "    ${WHITE}cryptsetup luksAddKey ${ROOT_CRYPT_PART}${NC}"
        echo
    fi
    echo
    echo "  Before rebooting:"
    echo "    - Remove the installation media."
    case "${SECUREBOOT_RESULT}" in
        enrolled)
            echo "    - ${YELLOW}Secure Boot keys are enrolled and the boot chain is signed.${NC}"
            echo "      Boot this machine ONCE with Secure Boot still off and check that it"
            echo "      works, then turn Secure Boot on in the firmware. Doing it the other"
            echo "      way round means finding out in the one place with no error message."
            echo "      To undo it: ${WHITE}sudo sbctl reset${NC}, or 'restore factory keys' in"
            echo "      the firmware setup. Kernel modules are not signed and do not need to be."
            ;;
        signed)
            echo "    - RavenBoot and the kernel are signed with this machine's own key,"
            echo "      but no key is enrolled, so ${YELLOW}Secure Boot must stay off${NC} for now."
            echo "      To finish: ${WHITE}sudo sbctl enroll-keys --microsoft${NC} with the firmware"
            echo "      in setup mode, then turn Secure Boot on."
            ;;
        failed|skipped)
            echo "    - ${YELLOW}Secure Boot was not set up${NC} (see the warning above), so it must"
            echo "      stay off. Nothing was half done and the firmware was not touched."
            ;;
        *)
            if [[ "$SECUREBOOT_STATE" == "1" ]]; then
                echo "    - ${YELLOW}Disable Secure Boot${NC} -- RavenBoot is unsigned and will not load."
                echo "      Or, to keep it on: clear the Secure Boot keys in the firmware to"
                echo "      put it in setup mode, boot this installer again, and choose to"
                echo "      enrol keys. See docs/secure-boot.md."
            fi
            ;;
    esac
    if [[ $OPT_NVRAM -eq 0 ]]; then
        echo "    - The firmware boots this disk through the removable-media path."
        echo "      If it does not appear, choose the disk directly from the boot menu"
        echo "      (F8 on ASUS), or reinstall with --efi-nvram."
    fi
    echo
    echo "  If it does not boot, pick ${WHITE}RavenLinux (rescue shell)${NC} from the"
    echo "  RavenBoot menu -- it drops straight to a root shell on the installed root."
    echo
}

# =============================================================================
# Probe
# =============================================================================
# Everything a front-end needs to draw the wizard, as key=value lines on
# stdout. Keys repeat where the value is a list; a `disk.begin`/`disk.end` pair
# brackets one device's records.
#
# It runs the *real* preflight and the *real* source lookup -- soft_die is the
# whole of the difference -- so what it reports is what the install would find,
# and it cannot drift from it by being a second opinion. The human log those
# two produce goes to stderr, leaving stdout carrying only the report.
#
# Nothing here writes. The one side effect is the squashfs loop-mount that
# locate_source makes, and cleanup() in main() unmounts it.

pk() { printf '%s=%s\n' "$1" "${2-}"; }

# What installing alongside would look like on one disk.
#
# It answers the two questions a front-end has to put on screen -- can this be
# done here, and which partition would give up the space -- with the same
# functions that would do it, so a disk the wizard would accept is a disk the
# front-end offers and no disk is judged twice by two rules.
#
# The per-partition rows are separate from the disk.part rows above rather than
# an extension of them. Those describe what is on the disk; these describe what
# could be done to it, they cost a resize2fs or ntfsresize probe each, and a
# front-end that only draws a list should not have to pay for the ones it is
# not going to offer.
probe_alongside() {
    local dev="$1" node start size type minb spare esp

    # Told apart because they are three different problems and only one of
    # them is about the disk. --probe is documented as harmless and is run by
    # hand as often as it is run by the front-end, and a disk this user cannot
    # open reported as "no GPT partition table" sends whoever reads it looking
    # at the wrong thing entirely.
    if [[ ! -r "$dev" ]]; then
        pk disk.alongside 0
        pk disk.alongside_why "cannot read ${dev}; run the probe as root"
        return 0
    fi
    if ! read_disk_table "$dev" 2>/dev/null; then
        pk disk.alongside 0
        pk disk.alongside_why "no partition table on the disk"
        return 0
    fi
    if [[ "${DISK_LABEL,,}" != "gpt" ]]; then
        pk disk.alongside 0
        pk disk.alongside_why "the disk is ${DISK_LABEL:-MBR}, not GPT"
        return 0
    fi

    esp="$(find_esp)"
    if [[ -z "$esp" ]]; then
        pk disk.alongside 0
        pk disk.alongside_why "no EFI System Partition, so no other UEFI OS to keep"
        return 0
    fi
    pk disk.esp "$esp"
    local esp_free esp_extra=0
    esp_free="$(esp_free_bytes "$esp")"
    pk disk.esp_free_bytes "${esp_free:-}"
    if [[ -n "$esp_free" ]] && (( esp_free < ESP_MIN_FREE )); then
        esp_extra=$(to_bytes "$OPT_ESP_SIZE")
    fi
    # What an ESP of our own adds to the space needed, when the existing one is
    # too full to share. Zero when it can be shared.
    pk disk.esp_extra_bytes "$esp_extra"

    local gap gap_bytes=0
    gap="$(largest_gap)"
    [[ -n "$gap" ]] && gap_bytes=$(( $(echo "$gap" | cut -f3) * DISK_SECTOR ))
    pk disk.free_bytes "$gap_bytes"
    pk disk.min_root_bytes "$ALONGSIDE_MIN_ROOT"
    pk disk.min_headroom_bytes "$ALONGSIDE_MIN_HEADROOM"

    # Swap goes into the same gap as the root -- plan_alongside_partitions
    # splits one hole between the two -- so every "is there room" answer below
    # is about root plus swap, not about the root alone. Reporting the two
    # separately as well as the total is what lets a front-end recompute when
    # somebody turns swap off on a later page, instead of being stuck with the
    # answer the probe happened to be run with.
    local swap_size swap_bytes=0 min_total
    swap_size="$(resolve_swap_size)"
    [[ -n "$swap_size" ]] && swap_bytes=$(to_bytes "$swap_size")
    min_total=$(( ALONGSIDE_MIN_ROOT + swap_bytes + esp_extra ))
    pk disk.swap_bytes "$swap_bytes"
    pk disk.min_total_bytes "$min_total"

    local candidates=0
    while IFS=$'\t' read -r node start size type; do
        [[ -z "$node" ]] && continue
        [[ "${type^^}" == "$GUID_ESP" ]] && continue
        [[ -b "$node" ]] || continue

        pk part.begin "$node"
        pk part.size_bytes "$(( size * DISK_SECTOR ))"
        pk part.fstype "$(fs_type_of "$node")"
        pk part.label "$(fs_label_of "$node")"
        pk part.os "$(part_os_hint "$node")"

        # part.resizable and part.shrinkable are two different questions and a
        # front-end needs both. The first is about the filesystem -- can it be
        # made smaller at all, by this image, right now -- and nothing the
        # person clicks will change the answer. The second adds "by enough",
        # and that one moves: swap comes out of the same space, so turning it
        # off lowers the bar. Reporting only the second is what left a
        # front-end no way to re-judge a partition it had greyed out.
        if findmnt -no TARGET --source "$node" >/dev/null 2>&1; then
            pk part.resizable 0
            pk part.shrinkable 0
            pk part.why "mounted"
        elif ! fs_shrinkable "$node"; then
            local t; t=$(fs_type_of "$node")
            # A partition with no filesystem on it -- Microsoft Reserved is one
            # on every Windows disk -- has no name to put in this sentence, and
            # "  cannot be shrunk here" is what leaving it empty produces.
            pk part.resizable 0
            pk part.shrinkable 0
            if [[ -z "$t" ]]; then
                pk part.why "it has no filesystem to shrink"
            else
                pk part.why "${t} cannot be shrunk here"
            fi
        elif ! minb=$(fs_min_bytes "$node"); then
            pk part.resizable 0
            pk part.shrinkable 0
            pk part.why "the filesystem would not report its minimum size (dirty? hibernated?)"
        else
            spare=$(( size * DISK_SECTOR - minb - ALONGSIDE_MIN_HEADROOM ))
            (( spare < 0 )) && spare=0
            pk part.resizable 1
            pk part.used_bytes "$minb"
            pk part.spare_bytes "$spare"
            if (( spare >= min_total )); then
                pk part.shrinkable 1
                candidates=$((candidates + 1))
            else
                pk part.shrinkable 0
                pk part.why "only $(to_human $spare) to spare; this install needs $(to_human $min_total)$(swap_share_note "$swap_size")"
            fi
        fi
        pk part.end "$node"
    done < <(table_rows)

    if (( gap_bytes >= min_total )) || (( candidates > 0 )); then
        pk disk.alongside 1
    else
        pk disk.alongside 0
        pk disk.alongside_why "no free space and nothing that can give up $(to_human $min_total)$(swap_share_note "$swap_size")"
    fi
}

# The whole partition table, for a front-end that lets somebody lay the disk
# out by hand. Every row, the ESP included, with where it sits in sectors --
# the unit --new speaks -- and whether the running system is using it.
probe_layout() {
    local dev="$1" node start size type
    [[ -r "$dev" ]] || return 0
    read_disk_table "$dev" 2>/dev/null || { pk disk.label ""; return 0; }
    pk disk.label "${DISK_LABEL,,}"
    pk disk.sector_size "$DISK_SECTOR"
    pk disk.first_lba "$DISK_FIRST_LBA"
    pk disk.last_lba "$DISK_LAST_LBA"
    pk disk.align_sectors "$(( ALIGN_BYTES / DISK_SECTOR ))"
    while IFS=$'\t' read -r node start size type; do
        [[ -z "$node" ]] && continue
        pk slot.begin "$node"
        pk slot.start "$start"
        pk slot.sectors "$size"
        pk slot.type "${type^^}"
        pk slot.fstype "$(fs_type_of "$node")"
        pk slot.label "$(fs_label_of "$node")"
        pk slot.os "$(part_os_hint "$node")"
        pk slot.in_use "$(part_in_use "$node" && echo 1 || echo 0)"
        [[ "$(fs_type_of "$node")" == "vfat" ]] && pk slot.free_bytes "$(esp_free_bytes "$node")"
        pk slot.end "$node"
    done < <(table_rows)
}

probe_disks() {
    local line name dev size model bytes rm existing
    while read -r line; do
        [[ -z "$line" ]] && continue
        name=$(echo "$line" | awk '{print $1}')
        dev="/dev/${name}"

        pk disk.begin "$dev"
        size=$(lsblk -dn -o SIZE  "$dev" 2>/dev/null | tr -d ' ')
        bytes=$(lsblk -dnb -o SIZE "$dev" 2>/dev/null | tr -d ' ')
        model=$(lsblk -dn -o MODEL "$dev" 2>/dev/null | sed 's/ *$//')
        rm=$(lsblk -dn -o RM "$dev" 2>/dev/null | tr -d ' ')
        pk disk.size  "$size"
        pk disk.bytes "${bytes:-0}"
        pk disk.model "$model"
        pk disk.removable "${rm:-0}"
        pk disk.live_media "$(is_live_media "$dev" && echo 1 || echo 0)"

        # The same listing choose_disk prints before it asks. A front-end that
        # shows "this disk currently holds..." is showing these rows.
        existing=$(lsblk -n -o NAME,SIZE,FSTYPE,LABEL "$dev" 2>/dev/null | tail -n +2)
        if [[ -n "$existing" ]]; then
            while read -r part; do
                [[ -z "${part//[[:space:]]/}" ]] && continue
                # Pipe-separated so a label containing a space survives; the
                # tree-drawing characters lsblk prefixes the name with go.
                pk disk.part "$(echo "$part" | sed 's/^[^[:alnum:]]*//' | awk '{
                    name=$1; size=$2; fstype=$3; label="";
                    for (i = 4; i <= NF; i++) label = label (i > 4 ? " " : "") $i;
                    print name "|" size "|" fstype "|" label
                }')"
            done <<< "$existing"
            pk disk.windows "$(echo "$existing" | grep -qiE 'ntfs|Microsoft|Windows|Basic data' && echo 1 || echo 0)"
        else
            pk disk.windows 0
        fi

        probe_alongside "$dev"
        probe_layout "$dev"
        pk disk.bitlocker "$(disk_has_bitlocker "$dev" && echo 1 || echo 0)"
        pk disk.end "$dev"
    done < <(list_disks)
}

probe_timezones() {
    local tzdir
    tzdir=$(zoneinfo_dir) || return 0
    # Zone files only: the database also carries tables (zone.tab), the
    # compiled source (tzdata.zi), the leap-second list, and the posix/ and
    # right/ trees, none of which is a timezone anyone should be offered.
    find "$tzdir" -type f \
        -not -path "*/posix/*" -not -path "*/right/*" \
        -not -name "*.tab" -not -name "*.zi" -not -name "*.list" \
        -not -name "leapseconds" -not -name "leap-seconds*" \
        -not -name "localtime" -not -name "Factory" \
        -printf '%P\n' 2>/dev/null | LC_ALL=C sort
}

probe_report() {
    # Discovery talks to stderr; the report owns stdout. fd 9 parks the real
    # stdout for the duration.
    exec 9>&1
    exec 1>&2
    preflight     || true
    locate_source || true
    exec 1>&9 9>&-

    pk probe.protocol "${RAVEN_INSTALL_PROTOCOL}"
    pk probe.installer_version "${RAVEN_INSTALL_VERSION}"
    pk probe.euid "$(id -u)"
    pk probe.ok "$(( ${#PROBE_ERRORS[@]} == 0 ))"
    local e
    for e in "${PROBE_ERRORS[@]:-}"; do
        [[ -z "$e" ]] && continue
        # Errors are multi-line in two places. One record per line, or a
        # front-end reading line by line loses the second half of the reason.
        while IFS= read -r line; do pk probe.error "$line"; done <<< "$e"
    done

    pk preflight.firmware   "$([[ -d /sys/firmware/efi ]] && echo uefi || echo bios)"
    case "${SECUREBOOT_STATE}" in
        1)  pk preflight.secureboot on ;;
        "") pk preflight.secureboot unknown ;;
        *)  pk preflight.secureboot off ;;
    esac
    # Reported separately from `secureboot`, because "off" covers two firmware
    # states that want opposite things said about them. With a Platform Key
    # still enrolled, nothing here can put a new one in and the person has to
    # visit the firmware first; in setup mode there is no Platform Key at all
    # and enrolment is a command away. A front-end that greyed out the offer
    # on both would be hiding the one case where it works.
    case "${SECUREBOOT_SETUP}" in
        1)  pk preflight.setupmode on ;;
        "") pk preflight.setupmode unknown ;;
        *)  pk preflight.setupmode off ;;
    esac
    # Whether the system being installed will have sbctl -- either because the
    # tree being copied has it, or because it is in the package profile that
    # is going in during this install. The live image's own copy is not asked
    # about and would not help: sbctl keeps its keys on the machine it runs
    # on, and the live image's are on a tmpfs. See setup_secure_boot().
    pk preflight.sbctl "$([[ -n "${SRC_ROOT}" && -x "${SRC_ROOT%/}/usr/bin/sbctl" ]] && echo 1 || echo 0)"

    local t missing=()
    for t in sfdisk blkid lsblk findmnt mount umount mountpoint mkfs.vfat wipefs; do
        have "$t" || missing+=("$t")
    done
    pk preflight.tools_missing "${missing[*]:-}"

    # Only the filesystems this machine can actually make. A front-end offering
    # btrfs on an image with no mkfs.btrfs offers an install that dies at the
    # mkfs, three steps after the disk was erased.
    local fs
    for fs in ext4 xfs btrfs; do
        have "mkfs.${fs}" || continue
        # btrfs needs its second binary too, and for the same reason the rest
        # of this list exists: mkfs.btrfs makes the filesystem, `btrfs` makes
        # the @ subvolume the root is mounted from, and offering btrfs on an
        # image with only the first offers an install that dies after the disk
        # has been erased. preflight refuses it there; this keeps a front-end
        # from putting it on the menu in the first place.
        [[ "$fs" == "btrfs" ]] && ! have btrfs && continue
        pk preflight.fs "$fs"
    done
    # Reported separately so a front-end can say *why* btrfs is not on the
    # list above. "This image cannot make btrfs at all" and "this image can
    # make the filesystem but not its subvolumes" are different bugs in
    # different files, and the second one is the surprising one.
    pk preflight.btrfs_progs "$(have btrfs && echo 1 || echo 0)"
    # The two resizers, reported separately from the required tools because
    # neither is required: they matter only for --alongside, and only for the
    # filesystem each one handles. A front-end greys out "install alongside
    # Windows" when ntfsresize is 0 rather than offering it and failing.
    pk preflight.resize2fs  "$(have resize2fs  && have e2fsck && echo 1 || echo 0)"
    pk preflight.ntfsresize "$(have ntfsresize && echo 1 || echo 0)"
    pk preflight.chpasswd   "$(have chpasswd   && echo 1 || echo 0)"
    pk preflight.mkswap     "$(have mkswap     && echo 1 || echo 0)"
    pk preflight.efibootmgr "$(have efibootmgr && echo 1 || echo 0)"
    # Whether this image can encrypt a disk at all. A front-end with no
    # cryptsetup here must not offer the switch: the answer would be accepted,
    # the plan would say "encrypted", and the install would stop at preflight.
    pk preflight.cryptsetup "$(have cryptsetup && echo 1 || echo 0)"
    # And whether it would be fast. Reported separately because it changes
    # nothing about whether the install works -- see check_encryption_support.
    pk preflight.aes_ni "$( [[ -r /proc/crypto ]] && grep -q aesni /proc/crypto && echo 1 || echo 0)"

    pk source.kind   "${SRC_KIND}"
    pk source.root   "${SRC_ROOT}"
    pk source.kernel "${SRC_KERNEL}"
    pk source.initrd "${SRC_INITRD}"
    pk source.efi    "${SRC_EFI}"

    # Measured the way copy_system measures it, so the number a front-end shows
    # is the number the progress percentage is computed against.
    local total_mb=0
    if [[ -n "${SRC_ROOT}" ]] && have du; then
        total_mb=$(du -sm --one-file-system "$SRC_ROOT" 2>/dev/null | awk '{print $1}')
    fi
    [[ "$total_mb" =~ ^[0-9]+$ ]] || total_mb=0
    pk source.size_mb "$total_mb"

    local rootsupport=unknown
    [[ -n "${SRC_INITRD}" ]] && rootsupport="$(initrd_root_support "$SRC_INITRD")"
    pk source.initrd_root_support "$rootsupport"

    # Whether the tree being installed carries a compositor. install_bootloader
    # asks the same question of the copied root to decide whether to write the
    # Desktop entry; asking it here is what lets a front-end grey out the
    # desktop profile on an image that has no desktop in it.
    local has_desktop=0
    if [[ -n "${SRC_ROOT}" ]]; then
        [[ -x "${SRC_ROOT%/}/usr/bin/huginn" || -x "${SRC_ROOT%/}/bin/huginn" ]] && has_desktop=1
    fi
    pk source.has_desktop "$has_desktop"

    pk machine.windows "$(machine_has_windows && echo 1 || echo 0)"
    pk mem.total_mb "$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
    pk swap.suggested   "$(suggested_swap)"
    pk esp.size_default "${ESP_SIZE_DEFAULT}"

    probe_disks

    local z
    while IFS= read -r z; do
        [[ -z "$z" ]] && continue
        pk tz "$z"
    done < <(probe_timezones)

    # What raven-postinstall will be able to apply, read from the directory
    # rather than listed here, so adding a .packages file adds a profile.
    local p found=0 dir
    local profiles=()
    for dir in "${SRC_ROOT%/}/etc/raven/install-profiles" /etc/raven/install-profiles; do
        [[ -d "$dir" ]] || continue
        for p in "$dir"/*.packages; do
            [[ -e "$p" ]] || continue
            p="$(basename "$p")"
            pk profile "${p%.packages}"
            profiles+=("${p%.packages}")
            found=1
        done
        (( found )) && break
    done
    if (( ! found )); then
        # The three run_wizard accepts. Named here only when the image ships no
        # profile directory to read them from.
        for p in minimal desktop developer; do pk profile "$p"; profiles+=("$p"); done
    fi

    # Which of those profiles would put sbctl on the new system. A front-end
    # can then tell somebody who picked "desktop" that the Secure Boot option
    # is open to them, and somebody who picked "minimal" why it is not --
    # rather than greying out a switch for a reason it cannot name. Read from
    # the package lists, so adding sbctl to a profile is one edit in one file
    # and this follows it.
    local sbprof=()
    for p in "${profiles[@]:-}"; do
        [[ -z "$p" ]] && continue
        profile_names_sbctl "$p" && sbprof+=("$p")
    done
    pk preflight.sbctl_profiles "${sbprof[*]:-}"

    # The optional applications this media carries, for the front-end's
    # switches. Nothing here is installed unless the answers name it.
    local id
    while read -r id; do
        [[ -z "$id" ]] && continue
        pk optional.begin "$id"
        pk optional.name "$(optional_field "$id" name)"
        pk optional.description "$(optional_field "$id" description)"
        pk optional.end "$id"
    done < <(optional_available)

    local k
    for k in "${ANSWER_KEYS[@]}";     do pk answers.key "$k"; done
    for k in "${ANSWER_REQUIRED[@]}"; do pk answers.required "$k"; done

    pk probe.end 1
}

# =============================================================================
# Main
# =============================================================================

main() {
    [[ -n "$OPT_ANSWERS" ]] && load_answers "$OPT_ANSWERS"

    if (( OPT_PROBE )); then
        probe_report
        cleanup
        trap - EXIT
        exit 0
    fi

    banner
    preflight
    locate_source
    choose_disk
    run_wizard
    confirm
    partition_target
    format_partitions
    copy_system
    configure_system
    install_bootloader
    apply_profile_now
    # After the packages, not with the bootloader, and the ordering is the
    # whole reason this is a step of its own: sbctl arrives with the desktop
    # and developer profiles, so on a machine where the packages go in during
    # the install it exists by now and did not exist an instant earlier.
    setup_secure_boot
    finish

    trap - EXIT
    emit done 0

    # The front-end asks this one itself: it is the only question left, it is
    # the only one whose answer is "close this window", and reading stdin here
    # would block an install nobody is sitting in front of.
    (( OPT_NONINTERACTIVE )) && return 0

    echo
    if ask_yn "Reboot now?" "N"; then
        echo "  Rebooting..."
        sync
        reboot
    fi
}

main "$@"
