#!/bin/bash
# =============================================================================
# raven-install -- install RavenLinux from the live image onto a disk
# =============================================================================
#
# Ships in the sysroot at /usr/sbin/raven-install, so it is present both on the
# live ISO and on an installed system.
#
# What it does, in order:
#
#   1. preflight   -- root, UEFI, required tools, a usable source tree
#   2. wizard      -- disk, hostname, users, passwords, timezone, locale, swap
#   3. confirm     -- prints the plan, requires a typed YES
#   4. partition   -- GPT: ESP + optional swap + root, via sfdisk
#   5. copy        -- the squashfs (preferred) or the running root, onto the disk
#   6. configure   -- fstab, users, hostname, timezone, locale, init handoff
#   7. bootloader  -- RavenBoot on the ESP, at both \EFI\raven and the fallback
#
# Steps 2 and 3 are the only ones that need a person. Everything else is the
# engine, and the engine is reachable without a terminal: --probe reports what
# a front-end needs to ask about, --answers supplies the answers a wizard would
# have collected, and --progress-fd streams the same status lines this prints
# as one record per line. raven-installer-ui (installer-ui/ in the source tree)
# is a front-end built on exactly those three options -- it does not partition,
# copy or configure anything itself, so there is one implementation of the
# disk-destroying half and two ways to drive it. See PROTOCOL below.
#
# The bootloader is installed to \EFI\BOOT\BOOTX64.EFI as well as
# \EFI\raven\raven-boot.efi. The fallback path is what makes this boot on
# firmware that will not take an NVRAM entry from us -- which is most laptop
# firmware, ASUS included. --efi-nvram additionally registers a named entry.
#
# Secure Boot must be off: RavenBoot is unsigned.
#
# This is deliberately a shell script rather than a compiled binary. It shells
# out to sfdisk/mkfs/blkid for everything that matters anyway, and being a
# script means it can be read and patched on the live system, over SSH, on the
# machine that is refusing to install -- which is exactly when you need to.

set -uo pipefail

# =============================================================================
# Constants
# =============================================================================

RAVEN_INSTALL_VERSION="1.0"

# The wire format --probe and --progress-fd speak. Bumped when a record changes
# meaning; a front-end that reads a version it does not know should refuse to
# drive the installer rather than guess.
RAVEN_INSTALL_PROTOCOL="1"

ESP_SIZE_DEFAULT="512M"
ESP_LABEL="RAVEN_ESP"      # FAT labels are capped at 11 characters
ROOT_LABEL="RAVEN_ROOT"
SWAP_LABEL="RAVEN_SWAP"

# Where we do our work. Under /run so it is a tmpfs and never lands on disk.
WORK="/run/raven-install"
TARGET="${WORK}/target"
SRCMNT="${WORK}/source"

# =============================================================================
# Output
# =============================================================================

if [[ -t 1 ]]; then
    RED=$'\033[1;31m'; GREEN=$'\033[1;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[1;34m'; WHITE=$'\033[1;37m'; CYAN=$'\033[1;36m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; WHITE=""; CYAN=""; NC=""
fi

# -----------------------------------------------------------------------------
# The progress stream
# -----------------------------------------------------------------------------
# PROTOCOL, version ${RAVEN_INSTALL_PROTOCOL}
#
# With --progress-fd N every status line below is written a second time to file
# descriptor N, as one record per line: a verb, a space, and the rest of the
# line. No colour, no escapes, no continuation lines.
#
#   phase <id> <text>   a phase started; <id> is one of the ids in main()
#   ok    <text>        a thing succeeded
#   warn  <text>        a thing is wrong but not fatal
#   fail  <text>        a thing failed; a `done` with a non-zero code follows
#   info  <text>        neither, just news
#   pct   <id> <0-100>  progress *within* phase <id>
#   dirty <0|1>         whether the target disk has been written to yet
#   done  <exit-code>   the last record, always written, exactly once
#
# The verbs are a summary, deliberately. The full human log still goes to
# stdout, escapes stripped when stdout is not a terminal, and a front-end is
# expected to show that as the detail behind these records rather than to
# reconstruct it from them -- which is what keeps the two in parity when a
# message here grows a second explanatory line.
PROGRESS_FD=""
PHASE=""

emit() {
    [[ -n "$PROGRESS_FD" ]] || return 0
    # Never let a closed or broken progress pipe take the install down: the
    # front-end may have died, and a half-partitioned disk is a far worse
    # outcome than an unwatched install that finishes.
    printf '%s %s\n' "$1" "${2-}" >&"$PROGRESS_FD" 2>/dev/null || true
}

ok()   { echo "  [  ${GREEN}OK${NC}  ] $*"; emit ok "$*"; }
warn() { echo "  [${YELLOW}WARN${NC} ] $*"; emit warn "$*"; }
fail() { echo "  [${RED}FAIL${NC} ] $*"; emit fail "$*"; }
info() { echo "  [ ${BLUE}**${NC}  ] $*"; emit info "$*"; }
step() { echo; echo "${WHITE}>>>${NC} $*"; emit step "$*"; }

# A step that also names the phase it opens. Everything main() calls uses this
# rather than step(), so a front-end can map progress onto a fixed list of
# phases instead of matching on prose that is free to change.
phase() {
    PHASE="$1"; shift
    echo; echo "${WHITE}>>>${NC} $*"
    emit phase "${PHASE} $*"
}

# Progress inside the current phase, 0-100.
pct() { emit pct "${PHASE} $1"; }

# Print the reason and leave. The EXIT trap owns the "aborted" banner and the
# unmounting, so this must not do either -- doing them here printed the banner
# twice, once with the disk state and once without.
die() {
    echo
    fail "$*"
    exit 1
}

# Every check --probe reports on is written once, as a `die` in the real
# preflight, and read twice. In probe mode nothing is fatal -- a machine with
# no UEFI is a fact the front-end has to *show* someone, and a probe that
# exited on it would have nothing to show them -- so the same call records the
# reason and returns non-zero, and its caller returns instead of exiting.
#
# This is why probe and install cannot disagree about whether a machine is
# installable: they are not two checks with the same intent, they are one call.
PROBE_ERRORS=()

soft_die() {
    if (( OPT_PROBE )); then
        PROBE_ERRORS+=("$*")
        return 1
    fi
    die "$@"
}

banner() {
    cat <<BANNER
${CYAN}
   ██████╗  █████╗ ██╗   ██╗███████╗███╗   ██╗
   ██╔══██╗██╔══██╗██║   ██║██╔════╝████╗  ██║
   ██████╔╝███████║██║   ██║█████╗  ██╔██╗ ██║
   ██╔══██╗██╔══██║╚██╗ ██╔╝██╔══╝  ██║╚██╗██║
   ██║  ██║██║  ██║ ╚████╔╝ ███████╗██║ ╚████║
   ╚═╝  ╚═╝╚═╝  ╚═╝  ╚═══╝  ╚══════╝╚═╝  ╚═══╝${NC}
   ${WHITE}Installer${NC} v${RAVEN_INSTALL_VERSION}

BANNER
}

# =============================================================================
# Options
# =============================================================================

OPT_DISK=""
OPT_FS="ext4"
OPT_SWAP=""          # "", "none", or a size like 8G
OPT_ESP_SIZE="${ESP_SIZE_DEFAULT}"
OPT_NVRAM=0
OPT_DRY_RUN=0
OPT_YES=0
OPT_PROFILE=""
OPT_ANSWERS=""
OPT_NONINTERACTIVE=0
OPT_PROBE=0

usage() {
    cat <<USAGE
Usage: raven-install [options]

Installs RavenLinux onto a disk. Interactive by default; the options below
pre-answer individual questions rather than replacing the wizard.

Options:
  --disk DEVICE      Target disk (e.g. /dev/nvme0n1). Prompted for if omitted.
  --fs TYPE          Root filesystem: ext4 (default) or xfs or btrfs, if the
                     matching mkfs is present.
  --swap SIZE        Swap partition size (e.g. 8G), or "none" for no swap.
  --esp-size SIZE    EFI System Partition size. Default ${ESP_SIZE_DEFAULT}.
  --efi-nvram        Also register a "RavenLinux" UEFI NVRAM boot entry with
                     efibootmgr. Off by default: the fallback bootloader path
                     boots without it, and writing NVRAM can reorder the
                     firmware's existing entries.
  --profile NAME      Post-install package template: minimal (default), desktop,
                     or developer. Packages are installed later with
                     raven-postinstall, after networking is available.
  --dry-run          Run every check and print the plan, then stop before the
                     first write. Nothing is partitioned, formatted, or copied.
  -y, --yes          Skip the final typed confirmation. THIS DESTROYS THE DISK
                     WITH NO FURTHER PROMPT.
  -h, --help         This message.

Driving it from a front-end (see PROTOCOL near the top of this file):

  --probe            Report what a front-end needs in order to ask the
                     questions this wizard asks -- the preflight results, the
                     disks and what is on them, the source tree it found, the
                     timezones, the profiles -- as key=value lines on stdout,
                     and exit. Nothing is written and nothing is fatal: a
                     failed check is reported as a value, not an exit code.
  --answers FILE     Read the wizard's answers from FILE instead of asking.
                     One key=value per line, '#' comments, no quoting and no
                     substitution -- the value is the rest of the line, so a
                     password may contain anything but a newline. Keys are the
                     ones --probe names in answers.key. FILE holds passwords in
                     the clear, so put it on a tmpfs at mode 0600 and unlink it
                     afterwards; the installer refuses one that is readable by
                     anyone else.
  --non-interactive  Never read stdin. Requires --answers, implies --yes, and
                     turns a missing or invalid answer into an error instead of
                     a prompt. The final "reboot now?" is skipped.
  --progress-fd N    Also write each status line to file descriptor N, as the
                     one-record-per-line protocol documented above.

The target disk is erased completely. Dual-boot installation is not supported
yet -- if this machine has another OS you want to keep, stop here.
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --disk)      OPT_DISK="${2:-}"; shift 2 ;;
        --fs)        OPT_FS="${2:-}"; shift 2 ;;
        --swap)      OPT_SWAP="${2:-}"; shift 2 ;;
        --esp-size)  OPT_ESP_SIZE="${2:-}"; shift 2 ;;
        --efi-nvram) OPT_NVRAM=1; shift ;;
        --profile)   OPT_PROFILE="${2:-}"; shift 2 ;;
        --dry-run)   OPT_DRY_RUN=1; shift ;;
        -y|--yes)    OPT_YES=1; shift ;;
        --answers)   OPT_ANSWERS="${2:-}"; shift 2 ;;
        --non-interactive) OPT_NONINTERACTIVE=1; OPT_YES=1; shift ;;
        --progress-fd) PROGRESS_FD="${2:-}"; shift 2 ;;
        --probe)     OPT_PROBE=1; shift ;;
        -h|--help)   usage; exit 0 ;;
        *)           echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -n "$PROGRESS_FD" ]]; then
    [[ "$PROGRESS_FD" =~ ^[0-9]+$ ]] || { echo "--progress-fd takes a number" >&2; exit 2; }
    # Written to before the trap that would report the failure is installed, so
    # a bad descriptor is caught here rather than silently swallowed by emit's
    # own error suppression for the whole run.
    # In a subshell: a bad redirection is reported by the shell itself, before
    # the command's own 2>/dev/null can catch it, so the test has to happen
    # somewhere whose stderr is already redirected.
    if ! ( : >&"$PROGRESS_FD" ) 2>/dev/null; then
        echo "--progress-fd ${PROGRESS_FD} is not open for writing" >&2
        exit 2
    fi
fi

if (( OPT_NONINTERACTIVE )) && [[ -z "$OPT_ANSWERS" ]]; then
    echo "--non-interactive requires --answers FILE" >&2
    exit 2
fi

# =============================================================================
# Cleanup
# =============================================================================

# Set once the installer has started writing to the disk, so a failure after
# that point can say so rather than implying the disk is untouched.
DISK_DIRTY=0

# "1" when the firmware reports Secure Boot on, "" when off or unreadable.
SECUREBOOT_STATE=""

cleanup() {
    # Unmount in reverse depth order so nested mounts come off first.
    for m in "${TARGET}/boot/efi" "${TARGET}/dev" "${TARGET}/proc" "${TARGET}/sys" \
             "${TARGET}" "${SRCMNT}"; do
        mountpoint -q "$m" 2>/dev/null && umount -R "$m" 2>/dev/null
    done
    return 0
}

on_error() {
    local rc=$?
    [[ $rc -eq 0 ]] && return 0
    echo
    fail "Installation aborted."
    emit dirty "$DISK_DIRTY"
    emit done "$rc"
    if [[ $DISK_DIRTY -eq 1 ]]; then
        echo "  ${YELLOW}The target disk has already been modified and is not bootable.${NC}"
        echo "  Re-run raven-install to start over."
    else
        echo "  No changes were made to any disk."
    fi
    cleanup
    exit $rc
}
trap on_error EXIT
trap 'die "Interrupted."' INT TERM

# =============================================================================
# Preflight
# =============================================================================

have() { command -v "$1" >/dev/null 2>&1; }

preflight() {
    phase preflight "Preflight checks"

    [[ "$(id -u)" == "0" ]] || soft_die "raven-install must run as root." || return 1
    ok "Running as root"

    if [[ -d /sys/firmware/efi ]]; then
        ok "Firmware: UEFI"
    else
        fail "Firmware: BIOS/CSM"
        echo
        echo "  RavenBoot is a UEFI bootloader, and raven-install can only install it"
        echo "  on a machine booted in UEFI mode. Two things to check:"
        echo
        echo "    - You may have booted the live USB through the firmware's legacy/CSM"
        echo "      entry. Reboot and pick the UEFI entry for the same stick."
        echo "    - The machine may be UEFI-capable with CSM forced on. Turn CSM off."
        echo
        echo "  Installing to a genuinely BIOS-only machine is not supported yet;"
        echo "  it needs GRUB in the sysroot, which the build does not ship."
        soft_die "UEFI firmware required." || return 1
    fi

    # Secure Boot rejects RavenBoot before it gets a chance to run, and the
    # failure lands at the next boot rather than here -- so say it now.
    if [[ -d /sys/firmware/efi/efivars ]] && have od; then
        local sbvar
        sbvar=$(ls /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | head -1)
        if [[ -n "$sbvar" ]]; then
            # The variable is a 4-byte attribute prefix followed by one byte:
            # 01 = Secure Boot enabled.
            SECUREBOOT_STATE=$(od -An -tu1 -j4 -N1 "$sbvar" 2>/dev/null | tr -d ' ')
        fi
    fi
    if [[ "$SECUREBOOT_STATE" == "1" ]]; then
        warn "Secure Boot is ENABLED"
        echo "        RavenBoot is unsigned, so the installed system will not boot"
        echo "        until you disable Secure Boot in the firmware setup."
        echo "        On ASUS ROG: F2 at power-on, Advanced Mode (F7),"
        echo "        Security > Secure Boot > Secure Boot Control > Disabled."
    else
        ok "Secure Boot is off (or not reported)"
    fi

    local missing=()
    local t
    for t in sfdisk blkid lsblk findmnt mount umount mountpoint mkfs.vfat wipefs; do
        have "$t" || missing+=("$t")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        fail "Missing required tools: ${missing[*]}"
        echo
        echo "  These come from util-linux and dosfstools and are copied into the"
        echo "  sysroot by stage2. If you are on an ISO built before they were added"
        echo "  to that list, rebuild with 'imlazy stage2 && imlazy iso'."
        soft_die "Cannot continue without the tools above." || return 1
    fi
    ok "Disk tools present"

    case "${OPT_FS}" in
        ext4|xfs|btrfs) ;;
        *) die "Unsupported root filesystem: ${OPT_FS} (ext4, xfs, btrfs)" ;;
    esac
    have "mkfs.${OPT_FS}" || soft_die "mkfs.${OPT_FS} is not installed; use --fs ext4." || return 1
    ok "Root filesystem: ${OPT_FS}"

    if [[ -n "${OPT_SWAP}" && "${OPT_SWAP}" != "none" ]]; then
        have mkswap || die "mkswap is not installed; use --swap none."
    fi

    have chpasswd || warn "chpasswd not found; passwords will have to be set on first boot"

    mkdir -p "${TARGET}" "${SRCMNT}" || soft_die "Cannot create ${WORK}" || return 1
}

# =============================================================================
# Locate the source tree and the boot payload
# =============================================================================

SRC_ROOT=""          # directory whose contents become the installed system
SRC_KIND=""          # "squashfs" or "live-root"
SRC_KERNEL=""
SRC_INITRD=""
SRC_EFI=""

# The live media, wherever the initramfs left it. /run/raven-media is the
# loop-mounted-ISO case (Ventoy and "just copy the .iso onto a stick");
# /mnt/cdrom is the ordinary bind mount of the boot device.
media_dirs() {
    local d
    for d in /run/raven-media /mnt/cdrom /run/archiso/bootmnt; do
        [[ -d "$d" ]] && echo "$d"
    done
}

find_first() {
    local f
    for f in "$@"; do
        [[ -f "$f" ]] && { echo "$f"; return 0; }
    done
    return 1
}

locate_source() {
    phase locate "Locating the system to install"

    # The squashfs is the better source: it is the pristine sysroot, with none
    # of the tmpfs scribbling the live overlay has accumulated since boot, and
    # it is a single filesystem so the copy needs no exclusion list.
    local media squash=""
    for media in $(media_dirs); do
        squash=$(find_first \
            "${media}/raven/filesystem.squashfs" \
            "${media}/live/filesystem.squashfs" \
            "${media}/squashfs.img") && break
        squash=""
    done

    if [[ -n "$squash" ]]; then
        if mount -t squashfs -o ro,loop "$squash" "${SRCMNT}" 2>/dev/null; then
            SRC_ROOT="${SRCMNT}"
            SRC_KIND="squashfs"
            ok "Source: ${squash}"
        else
            warn "Found ${squash} but could not mount it; falling back to the running root"
        fi
    fi

    if [[ -z "$SRC_ROOT" ]]; then
        # Installing from the running system. Works on the live image and on an
        # already-installed one (cloning this machine onto another disk).
        SRC_ROOT="/"
        SRC_KIND="live-root"
        ok "Source: the running system (/)"
    fi

    # The boot payload. On the live image it is on the media; on an installed
    # system it is in /boot; stage4 also stages a copy inside the squashfs so
    # neither of those has to exist.
    local search_dirs=()
    for media in $(media_dirs); do
        search_dirs+=("${media}/boot" "${media}/EFI/raven")
    done
    search_dirs+=("${SRC_ROOT%/}/boot" "${SRC_ROOT%/}/usr/share/raven/boot" "/boot" "/usr/share/raven/boot")

    local d
    for d in "${search_dirs[@]}"; do
        [[ -d "$d" ]] || continue
        [[ -z "$SRC_KERNEL" ]] && SRC_KERNEL=$(find_first "$d/vmlinuz" "$d/vmlinuz-raven" "$d"/vmlinuz-*) || true
        [[ -z "$SRC_INITRD" ]] && SRC_INITRD=$(find_first "$d/initramfs.img" "$d/initrd.img" "$d/initramfs-raven.img") || true
        [[ -z "$SRC_EFI" ]] && SRC_EFI=$(find_first "$d/raven-boot.efi" "$d/BOOTX64.EFI") || true
    done

    # Last resort for the bootloader: the fallback path on the live media's ESP.
    if [[ -z "$SRC_EFI" ]]; then
        for media in $(media_dirs); do
            SRC_EFI=$(find_first "${media}/EFI/BOOT/BOOTX64.EFI") && break
        done
    fi

    [[ -n "$SRC_KERNEL" ]] || soft_die "No kernel found. Looked in: ${search_dirs[*]}" || return 1
    [[ -n "$SRC_INITRD" ]] || soft_die "No initramfs found. Looked in: ${search_dirs[*]}" || return 1
    ok "Kernel:    ${SRC_KERNEL}"
    ok "Initramfs: ${SRC_INITRD}"

    if [[ -n "$SRC_EFI" ]]; then
        ok "Bootloader: ${SRC_EFI}"
    else
        soft_die "No RavenBoot EFI binary found. stage3 builds it to
       build/packages/boot/raven-boot.efi -- if that file is missing on the
       build host, the ISO shipped without it and there is nothing to install." \
            || return 1
    fi

    # An initramfs that predates root= support will mount the squashfs and
    # ignore the disk entirely, which looks like the installer failed when it
    # did not. Cheap to detect: the string only exists in the newer script.
    if have zcat && ! zcat -f "$SRC_INITRD" 2>/dev/null | grep -aq 'raven_root_from_cmdline'; then
        warn "This initramfs may not support booting from a disk"
        echo "        It was built before root= handling was added, and will look for"
        echo "        the live squashfs instead of your new root partition."
        echo "        Rebuild with 'imlazy initramfs && imlazy iso' if the install does"
        echo "        not boot."
    fi
}

# =============================================================================
# Disk selection
# =============================================================================

list_disks() {
    lsblk -dn -o NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3 == "disk" { print }'
}

# nvme0n1 -> nvme0n1p1, sda -> sda1, mmcblk0 -> mmcblk0p1
partdev() {
    local disk="$1" n="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then
        echo "${disk}p${n}"
    else
        echo "${disk}${n}"
    fi
}

# Is $1 the disk we booted from? Shared with --probe, which greys the same
# device out in a front-end's list -- so the disk the installer would refuse is
# the disk the front-end never offers, rather than two guesses at the same rule.
is_live_media() {
    local disk="$1" media src_dev
    for media in $(media_dirs); do
        src_dev=$(findmnt -no SOURCE --target "$media" 2>/dev/null | sed 's/\[.*//')
        [[ -n "$src_dev" && "$src_dev" == "$disk"* ]] && return 0
    done
    return 1
}

choose_disk() {
    phase disk "Choosing the target disk"

    if [[ -n "${OPT_DISK}" ]]; then
        DISK="${OPT_DISK}"
    elif (( OPT_NONINTERACTIVE )); then
        die "No target disk. --non-interactive needs 'disk=' in the answers file."
    else
        echo
        echo "  Disks on this machine:"
        echo
        local n=0 names=() line
        while read -r line; do
            [[ -z "$line" ]] && continue
            n=$((n + 1))
            names+=("/dev/$(echo "$line" | awk '{print $1}')")
            printf '    %d) /dev/%s\n' "$n" "$line"
        done < <(list_disks)
        echo

        [[ $n -gt 0 ]] || die "No disks found. If this machine uses RAID or Intel RST,
       switch the SATA/NVMe controller to AHCI mode in the firmware."

        local choice
        while true; do
            read -r -p "  Install to which disk? [1-${n}] " choice
            if [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 && $choice -le $n ]]; then
                DISK="${names[$((choice - 1))]}"
                break
            fi
            warn "Enter a number between 1 and ${n}."
        done
    fi

    [[ -b "$DISK" ]] || die "${DISK} is not a block device."

    # Refuse to install onto the stick we booted from. It is mounted, the copy
    # would read from a device it is simultaneously erasing, and the failure is
    # ugly and halfway through.
    if is_live_media "$DISK"; then
        die "${DISK} is the live boot media. Pick the machine's internal disk."
    fi

    DISK_SIZE=$(lsblk -dn -o SIZE "$DISK" 2>/dev/null | tr -d ' ')
    DISK_MODEL=$(lsblk -dn -o MODEL "$DISK" 2>/dev/null | sed 's/ *$//')
    ok "Target: ${DISK} (${DISK_SIZE}${DISK_MODEL:+, ${DISK_MODEL}})"

    # Show what is about to be destroyed. Vague warnings get clicked through;
    # a list of the user's actual partitions does not.
    local existing
    existing=$(lsblk -n -o NAME,SIZE,FSTYPE,LABEL "$DISK" 2>/dev/null | tail -n +2)
    if [[ -n "$existing" ]]; then
        echo
        echo "  ${YELLOW}This disk currently holds:${NC}"
        echo "$existing" | sed 's/^/      /'
        if echo "$existing" | grep -qiE 'ntfs|Microsoft|Windows|Basic data'; then
            echo
            echo "  ${RED}This looks like a Windows installation.${NC} raven-install erases the"
            echo "  whole disk -- it cannot install alongside another OS yet."
        fi
    fi
}

# =============================================================================
# The answers file
# =============================================================================
# What a front-end sends instead of standing at the keyboard. One key=value per
# line; the value is everything after the first '=' including spaces, quotes
# and '#', because a password is a value like any other and stripping anything
# from it would silently install a machine nobody can log into.
#
# Parsed by hand rather than sourced. Sourcing it would be four lines shorter
# and would also execute whatever is in the file as shell, as root, before the
# disk is touched -- and this file is written by another process, in /run,
# during an install. There is no eval anywhere below for the same reason.

declare -A ANS=()

# Keys, and which of them are required. Printed by --probe as answers.key so a
# front-end reads the list rather than hardcoding it.
ANSWER_KEYS=(
    disk fs esp_size swap hostname username fullname user_password user_sudo
    root_password timezone locale keymap profile efi_nvram
)
ANSWER_REQUIRED=(disk hostname username)

load_answers() {
    local file="$1"

    [[ -f "$file" ]] || die "No such answers file: ${file}"
    [[ -r "$file" ]] || die "Cannot read ${file}"

    # It holds passwords. A file anyone on the machine can read is a mistake
    # worth stopping for rather than warning about, because by the time the
    # warning scrolls past, the install has already used it.
    local mode
    mode=$(stat -c '%a' "$file" 2>/dev/null || echo "")
    if [[ -n "$mode" && "${mode: -2}" != "00" ]]; then
        die "${file} is mode ${mode}; it holds passwords. Use 0600."
    fi

    local line key value lineno=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        [[ -z "${line//[[:space:]]/}" ]] && continue
        [[ "${line#"${line%%[![:space:]]*}"}" == \#* ]] && continue
        [[ "$line" == *=* ]] || die "${file}:${lineno}: not key=value: ${line}"

        key="${line%%=*}"
        value="${line#*=}"
        # Only the key is trimmed. A trailing space in a password is a
        # character somebody typed.
        key="${key//[[:space:]]/}"

        local known=0 k
        for k in "${ANSWER_KEYS[@]}"; do
            [[ "$k" == "$key" ]] && { known=1; break; }
        done
        (( known )) || die "${file}:${lineno}: unknown key '${key}'"

        ANS["$key"]="$value"
    done < "$file"

    local req
    for req in "${ANSWER_REQUIRED[@]}"; do
        [[ -n "${ANS[$req]:-}" ]] || die "${file}: missing required key '${req}'"
    done

    # The keys that have a command-line equivalent feed the same variables the
    # flag would, so there is one code path from here on. An explicit flag wins:
    # it is the more specific instruction, and it is how a front-end overrides
    # one field of a saved answers file without rewriting it.
    [[ -z "$OPT_DISK"    ]] && OPT_DISK="${ANS[disk]:-}"
    [[ -z "$OPT_PROFILE" ]] && OPT_PROFILE="${ANS[profile]:-}"
    [[ -z "$OPT_SWAP"    ]] && OPT_SWAP="${ANS[swap]:-}"
    [[ "$OPT_FS" == "ext4" && -n "${ANS[fs]:-}" ]] && OPT_FS="${ANS[fs]}"
    [[ "$OPT_ESP_SIZE" == "${ESP_SIZE_DEFAULT}" && -n "${ANS[esp_size]:-}" ]] \
        && OPT_ESP_SIZE="${ANS[esp_size]}"
    [[ "${ANS[efi_nvram]:-0}" == "1" ]] && OPT_NVRAM=1

    ok "Answers loaded from ${file}"
}

# =============================================================================
# Wizard
# =============================================================================

ask() {
    # ask VAR "prompt" "default"
    local __var="$1" __prompt="$2" __default="${3:-}" __reply=""
    if [[ -n "$__default" ]]; then
        read -r -p "  ${__prompt} [${__default}]: " __reply
        [[ -z "$__reply" ]] && __reply="$__default"
    else
        while [[ -z "$__reply" ]]; do
            read -r -p "  ${__prompt}: " __reply
        done
    fi
    printf -v "$__var" '%s' "$__reply"
}

ask_yn() {
    # ask_yn "prompt" "Y|N"  -> returns 0 for yes
    local prompt="$1" default="${2:-Y}" reply=""
    local hint="[Y/n]"
    [[ "$default" == "N" ]] && hint="[y/N]"
    while true; do
        read -r -p "  ${prompt} ${hint} " reply
        [[ -z "$reply" ]] && reply="$default"
        case "$reply" in
            [Yy]*) return 0 ;;
            [Nn]*) return 1 ;;
        esac
    done
}

ask_password() {
    # ask_password VAR "label"  -- reads twice, no echo, allows empty to skip
    local __var="$1" __label="$2" p1 p2
    while true; do
        read -r -s -p "  ${__label} password (leave empty to skip): " p1; echo
        if [[ -z "$p1" ]]; then
            warn "No ${__label} password set."
            printf -v "$__var" '%s' ""
            return 0
        fi
        read -r -s -p "  Repeat ${__label} password: " p2; echo
        if [[ "$p1" == "$p2" ]]; then
            printf -v "$__var" '%s' "$p1"
            return 0
        fi
        warn "Passwords do not match, try again."
    done
}

valid_username() {
    [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]
}

# Swap the size of RAM, rounded up, so hibernate has somewhere to go. Shared by
# the prompt, the answers file and --probe, so all three offer the same number.
suggested_swap() {
    local memkb memgb
    memkb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    memgb=$(( (memkb + 1048575) / 1048576 ))
    [[ $memgb -lt 1 ]] && memgb=2
    echo "${memgb}G"
}

valid_hostname() {
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]
}

# Where the zoneinfo database lives in the source tree, not on the live system:
# they are the same on the ISO but not when cloning an installed machine.
zoneinfo_dir() {
    local d="${SRC_ROOT%/}/usr/share/zoneinfo"
    [[ -d "$d" ]] && { echo "$d"; return 0; }
    [[ -d /usr/share/zoneinfo ]] && { echo /usr/share/zoneinfo; return 0; }
    return 1
}

run_wizard() {
    phase wizard "System configuration"
    if (( OPT_NONINTERACTIVE )); then
        apply_answers
        return 0
    fi
    echo

    while true; do
        ask HOSTNAME "Hostname" "raven"
        valid_hostname "$HOSTNAME" && break
        warn "Hostnames are letters, digits and hyphens, and cannot start or end with a hyphen."
    done

    echo
    while true; do
        ask USERNAME "Username for the primary account" "raven"
        if ! valid_username "$USERNAME"; then
            warn "Usernames are lowercase letters, digits, underscore and hyphen, starting with a letter or underscore."
            continue
        fi
        if [[ "$USERNAME" == "root" ]]; then
            warn "Pick a name other than root; the root account is configured separately."
            continue
        fi
        break
    done

    ask FULLNAME "Full name for ${USERNAME} (optional)" "${USERNAME}"
    ask_password USER_PASSWORD "${USERNAME}'s"

    if ask_yn "Allow ${USERNAME} to run administrative commands with sudo?" "Y"; then
        USER_SUDO=1
    else
        USER_SUDO=0
    fi

    echo
    ask_password ROOT_PASSWORD "root"
    if [[ -z "$ROOT_PASSWORD" && -z "$USER_PASSWORD" ]]; then
        warn "Neither account has a password. Anyone with the machine can log in."
    fi

    echo
    local tzdir
    if tzdir=$(zoneinfo_dir); then
        while true; do
            ask TIMEZONE "Timezone (Region/City, or ? to list regions)" "UTC"
            if [[ "$TIMEZONE" == "?" ]]; then
                find "$tzdir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
                    | sort | column -c 70 2>/dev/null || \
                find "$tzdir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
                echo "  Then: <Region>/<City>, e.g. America/New_York. Type ?<Region> to list a region."
                continue
            fi
            if [[ "$TIMEZONE" == \?* ]]; then
                local region="${TIMEZONE#\?}"
                if [[ -d "${tzdir}/${region}" ]]; then
                    find "${tzdir}/${region}" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sort | column -c 70 2>/dev/null || true
                else
                    warn "No such region: ${region}"
                fi
                continue
            fi
            if [[ -f "${tzdir}/${TIMEZONE}" ]]; then
                break
            fi
            warn "No timezone '${TIMEZONE}' in the database."
        done
    else
        warn "No timezone database in the source tree; the clock will run on UTC."
        TIMEZONE="UTC"
    fi

    ask LOCALE "Locale" "en_US.UTF-8"
    ask KEYMAP "Console keymap" "us"

    echo
    if [[ -n "$OPT_PROFILE" ]]; then
        INSTALL_PROFILE="$OPT_PROFILE"
    else
        ask INSTALL_PROFILE "Post-install profile (minimal/desktop/developer)" "minimal"
    fi
    case "$INSTALL_PROFILE" in
        minimal|desktop|developer) ;;
        *) die "Unknown install profile: ${INSTALL_PROFILE}" ;;
    esac

    echo
    if [[ -z "${OPT_SWAP}" ]]; then
        local suggested
        suggested="$(suggested_swap)"
        if ask_yn "Create a ${suggested} swap partition? (enables hibernate)" "Y"; then
            SWAP_SIZE="${suggested}"
        else
            SWAP_SIZE=""
        fi
    elif [[ "${OPT_SWAP}" == "none" ]]; then
        SWAP_SIZE=""
    else
        SWAP_SIZE="${OPT_SWAP}"
    fi
}

# The answers file's half of run_wizard. Every value goes through the validator
# the prompt above it uses -- valid_hostname, valid_username, the zoneinfo
# lookup, the profile case -- because a front-end that lets someone type a
# hostname is one text entry away from sending "my laptop" and an installed
# machine whose /etc/hostname is not a hostname.
#
# It refuses rather than corrects. A front-end can show the message; an
# installer that quietly rewrote the answer would install a machine that does
# not match what the person confirmed on the summary page.
apply_answers() {
    HOSTNAME="${ANS[hostname]:-raven}"
    valid_hostname "$HOSTNAME" || die "answers: invalid hostname '${HOSTNAME}'"

    USERNAME="${ANS[username]:-raven}"
    valid_username "$USERNAME" || die "answers: invalid username '${USERNAME}'"
    [[ "$USERNAME" == "root" ]] && die "answers: username cannot be root"

    FULLNAME="${ANS[fullname]:-$USERNAME}"
    # It lands in a colon-separated field of /etc/passwd, so a colon in it
    # would shift every field after it by one.
    [[ "$FULLNAME" == *:* ]] && die "answers: fullname cannot contain ':'"

    USER_PASSWORD="${ANS[user_password]:-}"
    ROOT_PASSWORD="${ANS[root_password]:-}"

    case "${ANS[user_sudo]:-1}" in
        1|yes|true) USER_SUDO=1 ;;
        0|no|false) USER_SUDO=0 ;;
        *) die "answers: user_sudo must be 0 or 1" ;;
    esac

    if [[ -z "$ROOT_PASSWORD" && -z "$USER_PASSWORD" ]]; then
        warn "Neither account has a password. Anyone with the machine can log in."
    fi

    TIMEZONE="${ANS[timezone]:-UTC}"
    local tzdir
    if tzdir=$(zoneinfo_dir); then
        [[ -f "${tzdir}/${TIMEZONE}" ]] || die "answers: no timezone '${TIMEZONE}' in the database."
    else
        warn "No timezone database in the source tree; the clock will run on UTC."
        TIMEZONE="UTC"
    fi

    LOCALE="${ANS[locale]:-en_US.UTF-8}"
    KEYMAP="${ANS[keymap]:-us}"

    INSTALL_PROFILE="${OPT_PROFILE:-minimal}"
    case "$INSTALL_PROFILE" in
        minimal|desktop|developer) ;;
        *) die "answers: unknown install profile '${INSTALL_PROFILE}'" ;;
    esac

    # Same three cases as the prompt: unset means "decide for me", which here
    # is the same memory-sized default the wizard offers.
    if [[ -z "${OPT_SWAP}" ]]; then
        SWAP_SIZE="$(suggested_swap)"
    elif [[ "${OPT_SWAP}" == "none" ]]; then
        SWAP_SIZE=""
    else
        SWAP_SIZE="${OPT_SWAP}"
    fi

    ok "Hostname: ${HOSTNAME}"
    ok "User: ${USERNAME}${FULLNAME:+ (${FULLNAME})}"
    ok "Timezone: ${TIMEZONE}, locale ${LOCALE}, keymap ${KEYMAP}"
    ok "Profile: ${INSTALL_PROFILE}, swap: ${SWAP_SIZE:-none}"
}

# =============================================================================
# Confirmation
# =============================================================================

ESP_DEV=""
SWAP_DEV=""
ROOT_DEV=""

plan_partitions() {
    local n=1
    ESP_DEV="$(partdev "$DISK" $n)"; n=$((n + 1))
    if [[ -n "$SWAP_SIZE" ]]; then
        SWAP_DEV="$(partdev "$DISK" $n)"; n=$((n + 1))
    fi
    ROOT_DEV="$(partdev "$DISK" $n)"
}

confirm() {
    plan_partitions

    phase confirm "Installation plan"
    cat <<PLAN

    Disk           ${DISK} (${DISK_SIZE}${DISK_MODEL:+, ${DISK_MODEL}})
    Partitioning   GPT, erasing everything on the disk

      ${ESP_DEV}   ${OPT_ESP_SIZE}  EFI System Partition (FAT32) -> /boot/efi
PLAN
    # %-4s keeps the size column lined up with the 512M and "rest" above.
    [[ -n "$SWAP_DEV" ]] && printf '      %s   %-4s  swap\n' "$SWAP_DEV" "$SWAP_SIZE"
    cat <<PLAN
      ${ROOT_DEV}   rest  ${OPT_FS} -> /

    Hostname       ${HOSTNAME}
    User           ${USERNAME}${FULLNAME:+ (${FULLNAME})}$([[ $USER_SUDO -eq 1 ]] && echo ", may use sudo via wheel")
    root password  $([[ -n "$ROOT_PASSWORD" ]] && echo "set" || echo "${YELLOW}not set${NC}")
    Timezone       ${TIMEZONE}
    Locale         ${LOCALE}
    Keymap         ${KEYMAP}
    Package profile ${INSTALL_PROFILE} (applied later with raven-postinstall)
    Bootloader     RavenBoot at \\EFI\\raven and \\EFI\\BOOT\\BOOTX64.EFI$([[ $OPT_NVRAM -eq 1 ]] && echo ", plus an NVRAM entry")

PLAN

    if [[ $OPT_DRY_RUN -eq 1 ]]; then
        echo "  ${CYAN}--dry-run: stopping here. Nothing has been written.${NC}"
        echo
        cleanup
        trap - EXIT
        exit 0
    fi

    if (( OPT_NONINTERACTIVE )); then
        # The front-end owns the confirmation. It has the same plan on screen --
        # it built every line of it -- and a typed YES on a terminal nobody is
        # looking at would just be an install that never starts.
        info "Non-interactive: the plan above was confirmed by the front-end."
        return 0
    fi

    if [[ $OPT_YES -eq 1 ]]; then
        warn "--yes given; proceeding without confirmation."
        return 0
    fi

    echo "  ${RED}Everything on ${DISK} will be destroyed.${NC}"
    echo
    local reply=""
    read -r -p "  Type YES to install, anything else to abort: " reply
    [[ "$reply" == "YES" ]] || die "Aborted at confirmation. Nothing was written."
}

# =============================================================================
# Partition and format
# =============================================================================

partition_disk() {
    phase partition "Partitioning ${DISK}"

    DISK_DIRTY=1

    # Anything still holding the old partitions open makes the kernel keep the
    # stale table, and the mkfs below then writes to the wrong offsets.
    local p
    for p in "${DISK}"*; do
        [[ -b "$p" ]] || continue
        swapoff "$p" 2>/dev/null
        umount "$p" 2>/dev/null
    done

    wipefs -a "$DISK" >/dev/null 2>&1 || warn "wipefs reported an error; continuing"

    {
        echo 'label: gpt'
        echo "size=${OPT_ESP_SIZE}, type=uefi, name=\"${ESP_LABEL}\""
        [[ -n "$SWAP_SIZE" ]] && echo "size=${SWAP_SIZE}, type=swap, name=\"${SWAP_LABEL}\""
        echo "type=linux, name=\"${ROOT_LABEL}\""
    } | sfdisk --wipe always --wipe-partitions always "$DISK" >/dev/null \
        || die "sfdisk failed to partition ${DISK}"

    ok "GPT written"

    sync
    partx -u "$DISK" >/dev/null 2>&1 || blockdev --rereadpt "$DISK" >/dev/null 2>&1 || true
    have udevadm && udevadm settle --timeout=10 >/dev/null 2>&1

    # The kernel can take a moment to publish the new nodes, and on NVMe it
    # regularly outlasts a single settle.
    local waited=0
    while [[ ! -b "$ROOT_DEV" || ! -b "$ESP_DEV" ]]; do
        sleep 1
        waited=$((waited + 1))
        [[ $waited -ge 15 ]] && die "Partition nodes did not appear (${ESP_DEV}, ${ROOT_DEV})"
    done
    ok "Partition devices ready"
}

format_partitions() {
    phase format "Creating filesystems"

    mkfs.vfat -F 32 -n "${ESP_LABEL}" "$ESP_DEV" >/dev/null 2>&1 \
        || die "mkfs.vfat failed on ${ESP_DEV}"
    ok "${ESP_DEV}: FAT32 (${ESP_LABEL})"

    case "${OPT_FS}" in
        ext4)  mkfs.ext4 -F -L "${ROOT_LABEL}" "$ROOT_DEV" >/dev/null 2>&1 ;;
        xfs)   mkfs.xfs -f -L "${ROOT_LABEL}" "$ROOT_DEV" >/dev/null 2>&1 ;;
        btrfs) mkfs.btrfs -f -L "${ROOT_LABEL}" "$ROOT_DEV" >/dev/null 2>&1 ;;
    esac || die "mkfs.${OPT_FS} failed on ${ROOT_DEV}"
    ok "${ROOT_DEV}: ${OPT_FS} (${ROOT_LABEL})"

    if [[ -n "$SWAP_DEV" ]]; then
        mkswap -L "${SWAP_LABEL}" "$SWAP_DEV" >/dev/null 2>&1 \
            || die "mkswap failed on ${SWAP_DEV}"
        ok "${SWAP_DEV}: swap (${SWAP_LABEL})"
    fi

    mount "$ROOT_DEV" "$TARGET" || die "Cannot mount ${ROOT_DEV} on ${TARGET}"
    mkdir -p "${TARGET}/boot/efi"
    mount "$ESP_DEV" "${TARGET}/boot/efi" || die "Cannot mount ${ESP_DEV}"
    ok "Target mounted"
}

# =============================================================================
# Copy
# =============================================================================

# Poll the target filesystem's used space rather than walking the tree: du on a
# 1.4G tree every couple of seconds costs more than the copy it is reporting on.
# Without df, or without a size to measure against, fall back to a spinner --
# a copy this long with no output at all reads as a hang.
copy_progress() {
    local pid="$1" total_mb="$2" used_mb pct last=-1
    local spin='-\|/' i=0

    if ! have df || [[ $total_mb -le 0 ]]; then
        while kill -0 "$pid" 2>/dev/null; do
            printf '\r  [ %s**%s  ] Copying system files... %s' \
                "$BLUE" "$NC" "${spin:i++%4:1}"
            sleep 1
        done
        # Nothing measurable to report, so the stream says so once rather than
        # leaving a front-end to decide whether a silent phase is a hang.
        emit info "Copying system files (size unknown)"
        printf '\r%*s\r' 70 ''
        return 0
    fi

    while kill -0 "$pid" 2>/dev/null; do
        # -m is not universal across df implementations; -k is.
        used_mb=$(df -k "$TARGET" 2>/dev/null | awk 'NR==2 {print int($3/1024)}')
        [[ -z "$used_mb" ]] && used_mb=0
        pct=$((used_mb * 100 / total_mb))
        [[ $pct -gt 99 ]] && pct=99
        if [[ $pct -ne $last ]]; then
            printf '\r  [ %s**%s  ] Copying system files... %d%% (%d/%d MB)' \
                "$BLUE" "$NC" "$pct" "$used_mb" "$total_mb"
            pct "$pct"
            last=$pct
        fi
        sleep 2
    done
    printf '\r%*s\r' 70 ''
}

copy_system() {
    phase copy "Copying the system to ${ROOT_DEV}"

    local total_mb=0
    if have du; then
        total_mb=$(du -sm --one-file-system "$SRC_ROOT" 2>/dev/null | awk '{print $1}')
    fi
    [[ "$total_mb" =~ ^[0-9]+$ ]] || total_mb=0
    [[ $total_mb -gt 0 ]] && info "About ${total_mb} MB to copy"

    local rc=0
    if [[ "$SRC_KIND" == "squashfs" ]]; then
        # A read-only single-filesystem source: a plain recursive copy is exact.
        cp -a "${SRC_ROOT}/." "${TARGET}/" &
    else
        # The running root. --one-file-system is what keeps /proc, /sys, /dev,
        # /run and /tmp out: every one of them is a separate mount, so tar stops
        # at the boundary without needing a list of paths to skip.
        ( tar -C / --one-file-system -cf - . 2>/dev/null \
          | tar -C "$TARGET" -xpf - 2>/dev/null ) &
    fi
    local copy_pid=$!
    copy_progress "$copy_pid" "$total_mb"
    wait "$copy_pid" || rc=$?

    [[ $rc -eq 0 ]] || die "Copying the system failed (exit ${rc}). The disk is not usable."

    # Directories the copy cannot carry: they are mount points on the source,
    # so they arrive empty or not at all.
    local d
    for d in proc sys dev run tmp mnt media var/log var/tmp home boot/efi; do
        mkdir -p "${TARGET}/${d}"
    done
    chmod 1777 "${TARGET}/tmp" "${TARGET}/var/tmp" 2>/dev/null

    sync
    ok "System copied"
}

# =============================================================================
# Configure the installed system
# =============================================================================

uuid_of() { blkid -o value -s UUID "$1" 2>/dev/null; }

write_fstab() {
    local root_uuid esp_uuid swap_uuid
    root_uuid=$(uuid_of "$ROOT_DEV")
    esp_uuid=$(uuid_of "$ESP_DEV")

    [[ -n "$root_uuid" ]] || die "Could not read the UUID of ${ROOT_DEV}"

    # printf rather than echo: a FAT volume id is 9 characters and an ext4 UUID
    # is 36, so hand-spaced columns line up for one of them and not the other.
    local fmt='%-41s %-10s %-6s %-33s %s %s\n'

    {
        echo "# /etc/fstab -- written by raven-install"
        echo "#"
        # The header's first column is two narrower to pay for the "# " prefix.
        printf '# %-39s %-10s %-6s %-33s %s %s\n' \
            "<device>" "<mount>" "<type>" "<options>" "<dump>" "<pass>"
        printf "$fmt" "UUID=${root_uuid}" "/" "${OPT_FS}" "rw,relatime" 0 1
        if [[ -n "$esp_uuid" ]]; then
            printf "$fmt" "UUID=${esp_uuid}" "/boot/efi" "vfat" \
                "rw,noatime,fmask=0077,dmask=0077" 0 2
        fi
        if [[ -n "$SWAP_DEV" ]]; then
            swap_uuid=$(uuid_of "$SWAP_DEV")
            [[ -n "$swap_uuid" ]] && printf "$fmt" "UUID=${swap_uuid}" "none" "swap" "sw" 0 0
        fi
        # Redundant while raven-init mounts /tmp itself, and kept as the template
        # for anyone adding a mount by hand.
        printf "$fmt" "tmpfs" "/tmp" "tmpfs" "rw,nosuid,nodev,mode=1777" 0 0
    } > "${TARGET}/etc/fstab"

    ROOT_UUID="$root_uuid"
    ok "/etc/fstab written"
}

set_hostname() {
    echo "${HOSTNAME}" > "${TARGET}/etc/hostname"

    {
        echo "127.0.0.1   localhost"
        echo "::1         localhost ip6-localhost ip6-loopback"
        echo "127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}"
    } > "${TARGET}/etc/hosts"

    # raven-init reads /etc/hostname first, but init.toml carries a hostname of
    # its own and leaving it saying "raven-linux" is confusing later.
    if [[ -f "${TARGET}/etc/raven/init.toml" ]]; then
        sed -i "s|^hostname *= *\".*\"|hostname = \"${HOSTNAME}\"|" \
            "${TARGET}/etc/raven/init.toml" 2>/dev/null || true
    fi

    ok "Hostname: ${HOSTNAME}"
}

# Add $2 to group $1's member list in the target's /etc/group, if not already
# there. Editing the file directly rather than calling gpasswd keeps this
# working on an image whose shadow tools cannot chroot.
# Create a system group if the image does not already ship one.
#
# add_group_member fails on a group that does not exist, and every caller of it
# swallowed that with `|| true` -- so a missing group was indistinguishable
# from a successful add. `render` is the one where that had teeth: udev's
# 50-udev-default.rules gives /dev/dri/renderD* to group `render` at mode 0660,
# and with no such group in /etc/group the rule cannot apply and the node stays
# root-only 0600. The compositor survives that (it reaches the card node
# through seatd) but every GPU-accelerated Wayland client that opens the render
# node does not.
ensure_group() {
    local grp="$1" group="${TARGET}/etc/group"

    [[ -f "$group" ]] || return 1
    grep -q "^${grp}:" "$group" 2>/dev/null && return 0

    # First free GID in the system range, high end first so this never collides
    # with a distro's statically-assigned low GIDs. Brace expansion rather than
    # seq: the live image does not ship seq, and under `set -u` a loop over an
    # empty list left $gid unbound and aborted the whole install right after
    # the user account had been created.
    local gid found=""
    for gid in {999..900}; do
        if ! grep -q "^[^:]*:[^:]*:${gid}:" "$group" 2>/dev/null; then
            found="$gid"
            break
        fi
    done
    [[ -n "$found" ]] || return 1

    printf '%s:x:%s:\n' "$grp" "$found" >> "$group"
}

add_group_member() {
    local grp="$1" user="$2" group="${TARGET}/etc/group"
    grep -q "^${grp}:" "$group" 2>/dev/null || return 1

    awk -F: -v g="$grp" -v u="$user" 'BEGIN{OFS=":"}
        $1==g {
            n = split($4, m, ",")
            for (i = 1; i <= n; i++) if (m[i] == u) { print; next }
            $4 = ($4 == "" ? u : $4 "," u)
        }
        {print}' "$group" > "${group}.new" && mv "${group}.new" "$group"
}

# Drop $1 from every group's member list. Called when the placeholder account
# the image ships is removed -- otherwise it stays named in wheel, audio and
# the rest, referring to a user that no longer exists.
remove_group_member() {
    local user="$1" group="${TARGET}/etc/group"
    [[ -f "$group" ]] || return 0

    awk -F: -v u="$user" 'BEGIN{OFS=":"}
        {
            n = split($4, m, ",")
            out = ""
            for (i = 1; i <= n; i++) {
                if (m[i] == u || m[i] == "") continue
                out = (out == "" ? m[i] : out "," m[i])
            }
            $4 = out
            print
        }' "$group" > "${group}.new" && mv "${group}.new" "$group"
}

next_free_uid() {
    local uid=1000
    while grep -q ":x:${uid}:" "${TARGET}/etc/passwd" 2>/dev/null; do
        uid=$((uid + 1))
    done
    echo "$uid"
}

create_user() {
    local passwd="${TARGET}/etc/passwd"
    local group="${TARGET}/etc/group"
    local shadow="${TARGET}/etc/shadow"

    touch "$passwd" "$group" "$shadow"

    # The sysroot ships a placeholder "raven" account so the live image has a
    # non-root user. If the installer is creating an account under a different
    # name, that placeholder is dead weight and a login nobody set a password
    # on -- so it goes.
    if [[ "$USERNAME" != "raven" ]]; then
        sed -i '/^raven:/d' "$passwd" "$shadow" 2>/dev/null || true
        sed -i '/^raven:x:1000:/d' "$group" 2>/dev/null || true
        remove_group_member raven
        rm -rf "${TARGET}/home/raven" 2>/dev/null || true
    fi

    local shell="/bin/bash"
    for s in /usr/bin/ravenshell /bin/ravenshell /bin/bash /bin/sh; do
        [[ -x "${TARGET}${s}" ]] && { shell="$s"; break; }
    done

    if grep -q "^${USERNAME}:" "$passwd"; then
        info "Account ${USERNAME} already exists in the image; updating it"
        sed -i "s|^${USERNAME}:.*|${USERNAME}:x:$(awk -F: -v u="$USERNAME" '$1==u{print $3":"$4}' "$passwd"):${FULLNAME}:/home/${USERNAME}:${shell}|" "$passwd"
        USER_UID=$(awk -F: -v u="$USERNAME" '$1==u{print $3}' "$passwd")
        USER_GID=$(awk -F: -v u="$USERNAME" '$1==u{print $4}' "$passwd")
    else
        USER_UID=$(next_free_uid)
        USER_GID="$USER_UID"
        echo "${USERNAME}:x:${USER_UID}:${USER_GID}:${FULLNAME}:/home/${USERNAME}:${shell}" >> "$passwd"
        grep -q "^${USERNAME}:x:${USER_GID}:" "$group" || \
            echo "${USERNAME}:x:${USER_GID}:" >> "$group"
        echo "${USERNAME}:!:0:0:99999:7:::" >> "$shadow"
    fi

    mkdir -p "${TARGET}/home/${USERNAME}"
    # Seed the home directory from /etc/skel when the image has one.
    if [[ -d "${TARGET}/etc/skel" ]]; then
        cp -a "${TARGET}/etc/skel/." "${TARGET}/home/${USERNAME}/" 2>/dev/null || true
    fi
    chown -R "${USER_UID}:${USER_GID}" "${TARGET}/home/${USERNAME}" 2>/dev/null || true
    chmod 0755 "${TARGET}/home/${USERNAME}"

    ok "Created ${USERNAME} (uid ${USER_UID}, shell ${shell})"

    if [[ $USER_SUDO -eq 1 ]]; then
        grant_sudo
    fi
}

# Membership in wheel, plus a sudoers rule that actually honours wheel. Several
# builds ship a sudoers with that line commented out, which turns "you have
# sudo" into "sudo: user is not in the sudoers file" on first use.
grant_sudo() {
    local group="${TARGET}/etc/group"

    add_group_member wheel "$USERNAME" || echo "wheel:x:10:${USERNAME}" >> "$group"

    local sudoers="${TARGET}/etc/sudoers"
    if [[ -f "$sudoers" ]] && grep -qE '^[[:space:]]*%wheel[[:space:]]+ALL=' "$sudoers"; then
        : # already enabled
    elif [[ -d "${TARGET}/etc/sudoers.d" ]] || mkdir -p "${TARGET}/etc/sudoers.d" 2>/dev/null; then
        echo '%wheel ALL=(ALL:ALL) ALL' > "${TARGET}/etc/sudoers.d/10-wheel"
        chmod 0440 "${TARGET}/etc/sudoers.d/10-wheel"
        # sudoers.d is only read if sudoers includes it.
        if [[ -f "$sudoers" ]] && ! grep -qE '^[[:space:]]*@?include(dir)?[[:space:]]+/etc/sudoers\.d' "$sudoers"; then
            echo '@includedir /etc/sudoers.d' >> "$sudoers"
        fi
    fi

    # Groups a desktop session needs to reach hardware directly.
    #
    # Created first if the image lacks them. seatd runs with -g video, which
    # the base image does ship, so a seat works either way; `render` is the one
    # that was quietly absent and left /dev/dri/renderD* unopenable by anyone
    # but root. `seat` is created for symmetry and is unused today.
    #
    # `caw` is not hardware but belongs in the same loop: cawd checks the
    # peer's credentials on its socket, and `caw connect`, `disconnect` and
    # `shutdown` are refused to anyone outside the group. stage2 ships it
    # with the placeholder as its only member, and remove_group_member has
    # just stripped that -- so without this the installed user can scan but
    # never join a network except through sudo.
    local g
    for g in audio video input render seat caw; do
        ensure_group "$g" || true
        add_group_member "$g" "$USERNAME" || true
    done

    ok "${USERNAME} added to wheel (sudo) and the hardware groups"
}

set_passwords() {
    if ! have chpasswd; then
        warn "chpasswd is missing; no passwords were set"
        NEEDS_PASSWORD_ON_FIRST_BOOT=1
        return 0
    fi

    local failed=0
    if [[ -n "$ROOT_PASSWORD" ]]; then
        if printf 'root:%s\n' "$ROOT_PASSWORD" | chpasswd -R "$TARGET" 2>/dev/null; then
            ok "root password set"
        else
            failed=1
        fi
    else
        # An empty password field means "no password required", which is worse
        # than a locked account on a machine that now has a real user on it.
        sed -i 's|^root::|root:!:|' "${TARGET}/etc/shadow" 2>/dev/null || true
        warn "root has no password and is locked; use sudo from ${USERNAME}"
    fi

    if [[ -n "$USER_PASSWORD" ]]; then
        if printf '%s:%s\n' "$USERNAME" "$USER_PASSWORD" | chpasswd -R "$TARGET" 2>/dev/null; then
            ok "${USERNAME} password set"
        else
            failed=1
        fi
    fi

    if [[ $failed -eq 1 ]]; then
        warn "chpasswd could not set one or more passwords"
        echo "        Boot the rescue entry and run 'passwd' to set them."
        NEEDS_PASSWORD_ON_FIRST_BOOT=1
    fi

    chmod 0600 "${TARGET}/etc/shadow" 2>/dev/null || true
    chown 0:0 "${TARGET}/etc/shadow" 2>/dev/null || true
}

set_locale_and_time() {
    local tzdir="${TARGET}/usr/share/zoneinfo"
    if [[ -f "${tzdir}/${TIMEZONE}" ]]; then
        ln -sf "/usr/share/zoneinfo/${TIMEZONE}" "${TARGET}/etc/localtime"
        echo "${TIMEZONE}" > "${TARGET}/etc/timezone"
        ok "Timezone: ${TIMEZONE}"
    else
        warn "No zoneinfo for ${TIMEZONE} in the installed tree; leaving the clock on UTC"
    fi

    {
        echo "LANG=${LOCALE}"
        echo "LC_COLLATE=C"
    } > "${TARGET}/etc/locale.conf"
    ok "Locale: ${LOCALE}"

    # Recorded for the console setup to pick up. Nothing applies it today --
    # the sysroot ships no loadkeys -- so say that rather than let a setting
    # that does nothing look like one that works.
    echo "KEYMAP=${KEYMAP}" > "${TARGET}/etc/vconsole.conf"
    if [[ "$KEYMAP" != "us" ]]; then
        warn "Keymap '${KEYMAP}' recorded in /etc/vconsole.conf but not applied"
        echo "        RavenLinux does not ship loadkeys yet, so the console stays on us."
    fi

    # A stable machine-id, generated per install rather than baked into the ISO.
    local mid=""
    if have od; then
        mid=$(od -An -tx1 -N16 /dev/urandom 2>/dev/null | tr -d ' \n')
    fi
    if [[ ${#mid} -ne 32 ]]; then
        # No od in this image. bash's own RNG is not cryptographic, but a
        # machine-id only has to be unique, not unguessable.
        mid=""
        local i
        for ((i = 0; i < 8; i++)); do
            mid+=$(printf '%04x' $((RANDOM % 65536)))
        done
    fi
    printf '%s\n' "$mid" > "${TARGET}/etc/machine-id"
}

# The live image enters raven-init through a small /init hand-off. An installed
# root enters it through /sbin/init, so remove the live-only hand-off and make
# that relationship explicit on disk.
switch_to_raven_init() {
    if [[ -x "${TARGET}/sbin/raven-init" ]]; then
        rm -f "${TARGET}/sbin/init"
        ln -sf raven-init "${TARGET}/sbin/init"
        rm -f "${TARGET}/init"
        ok "PID 1 on the installed system: raven-init"
    else
        die "raven-init not found in the image; this build cannot be installed safely"
    fi

    # The live image autologins root on tty1 with no password, which is correct
    # for a live shell and unacceptable once the machine has real accounts.
    local toml="${TARGET}/etc/raven/init.toml"
    if [[ -f "$toml" ]] && [[ -x "${TARGET}/bin/login" || -x "${TARGET}/sbin/login" ]]; then
        # Replace the getty-tty1 argument list with a real login prompt. Only
        # the first match: later services have their own args.
        awk '
            /^name = "getty-tty1"/ { intty = 1 }
            intty && /^args = / {
                print "args = [\"--noclear\", \"tty1\", \"linux\"]"
                intty = 0
                next
            }
            { print }
        ' "$toml" > "${toml}.new" && mv "${toml}.new" "$toml"
        ok "tty1 asks for a login"
    else
        warn "Leaving the tty1 autologin in place: no /bin/login in the image"
    fi

    # The first-boot script exists to catch systems that were never through an
    # installer. This one has been.
    touch "${TARGET}/etc/.raven-first-boot-done"
}

# Strip the live image's credentials from the installed system.
#
# The twin of the tty1 change above, and it exists for the same reason: what is
# correct on a live ISO is unacceptable once the machine has real accounts on
# it.
#
# stage4 writes /etc/sudoers.d/10-raven-live-installer so the graphical
# installer can reach root on an image whose session user is the `raven`
# placeholder and whose tty1 is already an unauthenticated root shell. Neither
# of those is true of the machine being installed here -- switch_to_raven_init
# has just given tty1 a real login prompt -- so a passwordless route to
# raven-install would be a genuine hole rather than a convenience, and it would
# be one nobody would ever notice, because nothing on the installed system
# prompts for it.
remove_live_credentials() {
    local rule="${TARGET}/etc/sudoers.d/10-raven-live-installer"

    if [[ -f "$rule" ]]; then
        rm -f "$rule"
        ok "Live installer's passwordless sudo rule removed"
    fi
}

# Put the seatd service definition where raven-rc can see it.
#
# The other templates under /usr/share/raven/services are inert until `rvn
# install <pkg>` brings their daemon in. seatd is different: it is already in
# the base image next to huginn, so there is no install step to hook and the
# template would sit in /usr/share forever.
#
# It matters on a console boot. raven-init only creates a seatd service on
# raven.graphics=wayland, so booting the plain entry and trying to run the
# compositor from a TTY -- the workflow RavenGUI's scripts/tty-session.sh
# documents -- hit "no such service" from raven-rc and "Failed to open session:
# Function not implemented" from huginn, with nothing to start in between.
#
# Copied disabled. init's ensure_service overwrites enabled/exec/args from its
# own copy on a graphical boot, so this never holds seatd off when the session
# needs it.
install_seat_service() {
    local src="${TARGET}/usr/share/raven/services/seatd.toml"
    local dest_dir="${TARGET}/etc/raven/init.d"

    [[ -f "${src}" ]] || return 0
    [[ -x "${TARGET}/sbin/seatd" || -x "${TARGET}/usr/bin/seatd" ]] || return 0

    mkdir -p "${dest_dir}"
    if cp "${src}" "${dest_dir}/seatd.toml" 2>/dev/null; then
        ok "seatd service available to raven-rc (disabled; enable for TTY sessions)"
    fi
}

configure_system() {
    phase configure "Configuring the installed system"

    NEEDS_PASSWORD_ON_FIRST_BOOT=0

    write_fstab
    set_hostname
    create_user
    set_passwords
    set_locale_and_time
    switch_to_raven_init
    remove_live_credentials
    install_seat_service
    {
        echo "profile=${INSTALL_PROFILE}"
        echo "configured_by=raven-install"
    } > "${TARGET}/etc/raven/install-profile"

    sync
}

# =============================================================================
# Bootloader
# =============================================================================

install_bootloader() {
    phase boot "Installing RavenBoot to the ESP"

    local esp="${TARGET}/boot/efi"
    mkdir -p "${esp}/EFI/BOOT" "${esp}/EFI/raven"

    cp "$SRC_EFI" "${esp}/EFI/raven/raven-boot.efi" || die "Cannot write RavenBoot to the ESP"
    # The fallback path. Firmware booting a disk with no matching NVRAM entry
    # looks here, which is what makes this work without touching NVRAM at all.
    cp "$SRC_EFI" "${esp}/EFI/BOOT/BOOTX64.EFI" || die "Cannot write the fallback bootloader"
    ok "RavenBoot at \\EFI\\raven and \\EFI\\BOOT\\BOOTX64.EFI"

    cp "$SRC_KERNEL" "${esp}/EFI/raven/vmlinuz" || die "Cannot copy the kernel to the ESP"
    # 8.3-safe name: some firmware is unhappy with long names in the boot path.
    cp "$SRC_INITRD" "${esp}/EFI/raven/initrd.img" || die "Cannot copy the initramfs to the ESP"
    ok "Kernel and initramfs on the ESP"

    # Keep a copy in /boot on the root filesystem too, so a later
    # 'raven-install --help'-free reinstall of the bootloader has a source and
    # the installed system is not dependent on the ESP for its own kernel.
    mkdir -p "${TARGET}/boot"
    cp "$SRC_KERNEL" "${TARGET}/boot/vmlinuz" 2>/dev/null || true
    cp "$SRC_INITRD" "${TARGET}/boot/initramfs.img" 2>/dev/null || true

    local base_cmdline="root=UUID=${ROOT_UUID} rw"

    # Does this root actually carry a compositor? The Desktop entry is written
    # only if it does, so everything below keys off the same answer.
    local has_desktop=0
    if [[ -x "${TARGET}/usr/bin/huginn" || -x "${TARGET}/bin/huginn" ]]; then
        has_desktop=1
    fi

    # Which entry the menu preselects.
    #
    # This was a hardcoded `default = 0` -- the console entry -- so
    # `raven-install --profile desktop` installed a compositor, wrote a Desktop
    # entry for it, and then booted past it to a text console every time.
    # raven-init starts seatd and the session only on raven.graphics=wayland,
    # so the machine came up with no seat, no /run/user/0 and no huginn: a
    # desktop install with no desktop, unless you caught the five-second menu
    # and arrowed down one.
    #
    # Console profiles still default to console. Only a profile that asked for
    # a graphical system gets one without being asked twice.
    local default_entry=0
    if (( has_desktop )); then
        case "${INSTALL_PROFILE}" in
            desktop|developer) default_entry=1 ;;
        esac
    fi

    {
        echo "# RavenBoot configuration -- written by raven-install"
        echo "# Paths are relative to the EFI System Partition."
        echo
        echo "timeout = 5"
        echo "default = ${default_entry}"
        echo
        echo "[entry]"
        echo "name = \"RavenLinux\""
        echo "kernel = \"\\EFI\\raven\\vmlinuz\""
        echo "initrd = \"\\EFI\\raven\\initrd.img\""
        echo "cmdline = \"${base_cmdline} quiet loglevel=3 console=tty0\""
        echo "type = linux-efi"
        echo

        if (( has_desktop )); then
            echo "[entry]"
            echo "name = \"RavenLinux (Desktop)\""
            echo "kernel = \"\\EFI\\raven\\vmlinuz\""
            echo "initrd = \"\\EFI\\raven\\initrd.img\""
            echo "cmdline = \"${base_cmdline} quiet loglevel=3 raven.graphics=wayland raven.wayland=huginn console=tty0\""
            echo "type = linux-efi"
            echo
        fi

        echo "[entry]"
        echo "name = \"RavenLinux (verbose)\""
        echo "kernel = \"\\EFI\\raven\\vmlinuz\""
        echo "initrd = \"\\EFI\\raven\\initrd.img\""
        echo "cmdline = \"${base_cmdline} loglevel=7 console=tty0 console=ttyS0,115200\""
        echo "type = linux-efi"
        echo

        # The escape hatch. If login, init or a service is broken, this still
        # gets a root shell on the installed root with nothing else running.
        echo "[entry]"
        echo "name = \"RavenLinux (rescue shell)\""
        echo "kernel = \"\\EFI\\raven\\vmlinuz\""
        echo "initrd = \"\\EFI\\raven\\initrd.img\""
        echo "cmdline = \"${base_cmdline} init=/bin/bash console=tty0\""
        echo "type = linux-efi"
        echo

        # RavenBoot's parser drops any entry whose kernel is empty, so these
        # three carry a placeholder path. It is never read: handle_entry_selection
        # dispatches on the type and returns before anything is loaded.
        echo "# The kernel lines below are placeholders that RavenBoot's parser"
        echo "# requires. The type field is what decides what these entries do."
        echo "[entry]"
        echo "name = \"System UEFI Settings\""
        echo "kernel = \"firmware-setup\""
        echo "type = firmware-setup"
        echo

        echo "[entry]"
        echo "name = \"Reboot\""
        echo "kernel = \"reboot\""
        echo "type = reboot"
        echo

        echo "[entry]"
        echo "name = \"Shutdown\""
        echo "kernel = \"shutdown\""
        echo "type = shutdown"
    } > "${esp}/EFI/raven/boot.cfg"

    ok "boot.cfg written (root=UUID=${ROOT_UUID})"

    if [[ $OPT_NVRAM -eq 1 ]]; then
        register_nvram_entry
    else
        info "No NVRAM entry written; booting via the fallback path"
    fi

    sync
}

register_nvram_entry() {
    if ! have efibootmgr; then
        warn "efibootmgr is not installed; skipping the NVRAM entry"
        echo "        The fallback path still boots, so this is not fatal."
        return 0
    fi

    # efibootmgr wants the disk and the ESP's partition number separately.
    local partnum="${ESP_DEV##*[!0-9]}"

    # Drop any entry we wrote on a previous run, so reinstalling does not leave
    # a row of identical "RavenLinux" entries behind.
    local old
    for old in $(efibootmgr 2>/dev/null | awk '/[[:space:]]RavenLinux$/ {print substr($1,5,4)}'); do
        efibootmgr -B -b "$old" >/dev/null 2>&1 || true
    done

    if efibootmgr -c -d "$DISK" -p "$partnum" \
        -L "RavenLinux" -l '\EFI\raven\raven-boot.efi' >/dev/null 2>&1; then
        ok "UEFI NVRAM entry 'RavenLinux' registered"
    else
        warn "efibootmgr could not write the NVRAM entry"
        echo "        The fallback path still boots, so this is not fatal."
    fi
}

# =============================================================================
# Finish
# =============================================================================

finish() {
    phase finish "Finishing up"

    sync
    umount "${TARGET}/boot/efi" 2>/dev/null
    umount -R "$TARGET" 2>/dev/null
    # mount(8) attached the loop device for the squashfs; umount detaches it.
    mountpoint -q "$SRCMNT" && umount "$SRCMNT" 2>/dev/null
    ok "Filesystems unmounted"

    echo
    echo "${GREEN}==========================================${NC}"
    echo "${GREEN}  RavenLinux is installed on ${DISK}${NC}"
    echo "${GREEN}==========================================${NC}"
    echo
    echo "  Log in as ${WHITE}${USERNAME}${NC} on tty1."
    if [[ ${NEEDS_PASSWORD_ON_FIRST_BOOT:-0} -eq 1 ]]; then
        echo "  ${YELLOW}No password was set. Boot 'RavenLinux (rescue shell)' and run passwd.${NC}"
    fi
    echo
    echo "  Before rebooting:"
    echo "    - Remove the installation media."
    if [[ "$SECUREBOOT_STATE" == "1" ]]; then
        echo "    - ${YELLOW}Disable Secure Boot${NC} -- RavenBoot is unsigned and will not load."
    fi
    if [[ $OPT_NVRAM -eq 0 ]]; then
        echo "    - The firmware boots this disk through the removable-media path."
        echo "      If it does not appear, choose the disk directly from the boot menu"
        echo "      (F8 on ASUS), or reinstall with --efi-nvram."
    fi
    echo
    echo "  If it does not boot, pick ${WHITE}RavenLinux (rescue shell)${NC} from the"
    echo "  RavenBoot menu -- it drops straight to a root shell on the installed root."
    echo
}

# =============================================================================
# Probe
# =============================================================================
# Everything a front-end needs to draw the wizard, as key=value lines on
# stdout. Keys repeat where the value is a list; a `disk.begin`/`disk.end` pair
# brackets one device's records.
#
# It runs the *real* preflight and the *real* source lookup -- soft_die is the
# whole of the difference -- so what it reports is what the install would find,
# and it cannot drift from it by being a second opinion. The human log those
# two produce goes to stderr, leaving stdout carrying only the report.
#
# Nothing here writes. The one side effect is the squashfs loop-mount that
# locate_source makes, and cleanup() in main() unmounts it.

pk() { printf '%s=%s\n' "$1" "${2-}"; }

probe_disks() {
    local line name dev size model bytes rm existing
    while read -r line; do
        [[ -z "$line" ]] && continue
        name=$(echo "$line" | awk '{print $1}')
        dev="/dev/${name}"

        pk disk.begin "$dev"
        size=$(lsblk -dn -o SIZE  "$dev" 2>/dev/null | tr -d ' ')
        bytes=$(lsblk -dnb -o SIZE "$dev" 2>/dev/null | tr -d ' ')
        model=$(lsblk -dn -o MODEL "$dev" 2>/dev/null | sed 's/ *$//')
        rm=$(lsblk -dn -o RM "$dev" 2>/dev/null | tr -d ' ')
        pk disk.size  "$size"
        pk disk.bytes "${bytes:-0}"
        pk disk.model "$model"
        pk disk.removable "${rm:-0}"
        pk disk.live_media "$(is_live_media "$dev" && echo 1 || echo 0)"

        # The same listing choose_disk prints before it asks. A front-end that
        # shows "this disk currently holds..." is showing these rows.
        existing=$(lsblk -n -o NAME,SIZE,FSTYPE,LABEL "$dev" 2>/dev/null | tail -n +2)
        if [[ -n "$existing" ]]; then
            while read -r part; do
                [[ -z "${part//[[:space:]]/}" ]] && continue
                # Pipe-separated so a label containing a space survives; the
                # tree-drawing characters lsblk prefixes the name with go.
                pk disk.part "$(echo "$part" | sed 's/^[^[:alnum:]]*//' | awk '{
                    name=$1; size=$2; fstype=$3; label="";
                    for (i = 4; i <= NF; i++) label = label (i > 4 ? " " : "") $i;
                    print name "|" size "|" fstype "|" label
                }')"
            done <<< "$existing"
            pk disk.windows "$(echo "$existing" | grep -qiE 'ntfs|Microsoft|Windows|Basic data' && echo 1 || echo 0)"
        else
            pk disk.windows 0
        fi
        pk disk.end "$dev"
    done < <(list_disks)
}

probe_timezones() {
    local tzdir
    tzdir=$(zoneinfo_dir) || return 0
    # Zone files only: the database also carries tables (zone.tab), the
    # compiled source (tzdata.zi), the leap-second list, and the posix/ and
    # right/ trees, none of which is a timezone anyone should be offered.
    find "$tzdir" -type f \
        -not -path "*/posix/*" -not -path "*/right/*" \
        -not -name "*.tab" -not -name "*.zi" -not -name "*.list" \
        -not -name "leapseconds" -not -name "leap-seconds*" \
        -not -name "localtime" -not -name "Factory" \
        -printf '%P\n' 2>/dev/null | LC_ALL=C sort
}

probe_report() {
    # Discovery talks to stderr; the report owns stdout. fd 9 parks the real
    # stdout for the duration.
    exec 9>&1
    exec 1>&2
    preflight     || true
    locate_source || true
    exec 1>&9 9>&-

    pk probe.protocol "${RAVEN_INSTALL_PROTOCOL}"
    pk probe.installer_version "${RAVEN_INSTALL_VERSION}"
    pk probe.euid "$(id -u)"
    pk probe.ok "$(( ${#PROBE_ERRORS[@]} == 0 ))"
    local e
    for e in "${PROBE_ERRORS[@]:-}"; do
        [[ -z "$e" ]] && continue
        # Errors are multi-line in two places. One record per line, or a
        # front-end reading line by line loses the second half of the reason.
        while IFS= read -r line; do pk probe.error "$line"; done <<< "$e"
    done

    pk preflight.firmware   "$([[ -d /sys/firmware/efi ]] && echo uefi || echo bios)"
    case "${SECUREBOOT_STATE}" in
        1)  pk preflight.secureboot on ;;
        "") pk preflight.secureboot unknown ;;
        *)  pk preflight.secureboot off ;;
    esac

    local t missing=()
    for t in sfdisk blkid lsblk findmnt mount umount mountpoint mkfs.vfat wipefs; do
        have "$t" || missing+=("$t")
    done
    pk preflight.tools_missing "${missing[*]:-}"

    # Only the filesystems this machine can actually make. A front-end offering
    # btrfs on an image with no mkfs.btrfs offers an install that dies at the
    # mkfs, three steps after the disk was erased.
    local fs
    for fs in ext4 xfs btrfs; do
        have "mkfs.${fs}" && pk preflight.fs "$fs"
    done
    pk preflight.chpasswd   "$(have chpasswd   && echo 1 || echo 0)"
    pk preflight.mkswap     "$(have mkswap     && echo 1 || echo 0)"
    pk preflight.efibootmgr "$(have efibootmgr && echo 1 || echo 0)"

    pk source.kind   "${SRC_KIND}"
    pk source.root   "${SRC_ROOT}"
    pk source.kernel "${SRC_KERNEL}"
    pk source.initrd "${SRC_INITRD}"
    pk source.efi    "${SRC_EFI}"

    # Measured the way copy_system measures it, so the number a front-end shows
    # is the number the progress percentage is computed against.
    local total_mb=0
    if [[ -n "${SRC_ROOT}" ]] && have du; then
        total_mb=$(du -sm --one-file-system "$SRC_ROOT" 2>/dev/null | awk '{print $1}')
    fi
    [[ "$total_mb" =~ ^[0-9]+$ ]] || total_mb=0
    pk source.size_mb "$total_mb"

    local rootsupport=unknown
    if [[ -n "${SRC_INITRD}" ]] && have zcat; then
        if zcat -f "$SRC_INITRD" 2>/dev/null | grep -aq 'raven_root_from_cmdline'; then
            rootsupport=yes
        else
            rootsupport=no
        fi
    fi
    pk source.initrd_root_support "$rootsupport"

    # Whether the tree being installed carries a compositor. install_bootloader
    # asks the same question of the copied root to decide whether to write the
    # Desktop entry; asking it here is what lets a front-end grey out the
    # desktop profile on an image that has no desktop in it.
    local has_desktop=0
    if [[ -n "${SRC_ROOT}" ]]; then
        [[ -x "${SRC_ROOT%/}/usr/bin/huginn" || -x "${SRC_ROOT%/}/bin/huginn" ]] && has_desktop=1
    fi
    pk source.has_desktop "$has_desktop"

    pk mem.total_mb "$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
    pk swap.suggested   "$(suggested_swap)"
    pk esp.size_default "${ESP_SIZE_DEFAULT}"

    probe_disks

    local z
    while IFS= read -r z; do
        [[ -z "$z" ]] && continue
        pk tz "$z"
    done < <(probe_timezones)

    # What raven-postinstall will be able to apply, read from the directory
    # rather than listed here, so adding a .packages file adds a profile.
    local p found=0 dir
    for dir in "${SRC_ROOT%/}/etc/raven/install-profiles" /etc/raven/install-profiles; do
        [[ -d "$dir" ]] || continue
        for p in "$dir"/*.packages; do
            [[ -e "$p" ]] || continue
            p="$(basename "$p")"
            pk profile "${p%.packages}"
            found=1
        done
        (( found )) && break
    done
    if (( ! found )); then
        # The three run_wizard accepts. Named here only when the image ships no
        # profile directory to read them from.
        for p in minimal desktop developer; do pk profile "$p"; done
    fi

    local k
    for k in "${ANSWER_KEYS[@]}";     do pk answers.key "$k"; done
    for k in "${ANSWER_REQUIRED[@]}"; do pk answers.required "$k"; done

    pk probe.end 1
}

# =============================================================================
# Main
# =============================================================================

main() {
    [[ -n "$OPT_ANSWERS" ]] && load_answers "$OPT_ANSWERS"

    if (( OPT_PROBE )); then
        probe_report
        cleanup
        trap - EXIT
        exit 0
    fi

    banner
    preflight
    locate_source
    choose_disk
    run_wizard
    confirm
    partition_disk
    format_partitions
    copy_system
    configure_system
    install_bootloader
    finish

    trap - EXIT
    emit done 0

    # The front-end asks this one itself: it is the only question left, it is
    # the only one whose answer is "close this window", and reading stdin here
    # would block an install nobody is sitting in front of.
    (( OPT_NONINTERACTIVE )) && return 0

    echo
    if ask_yn "Reboot now?" "N"; then
        echo "  Rebooting..."
        sync
        reboot
    fi
}

main "$@"
