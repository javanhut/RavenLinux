#!/bin/sh
# A stand-in for raven-install, for working on the installer window without a
# live image or a disk to lose. --probe describes a laptop with Windows on it;
# anything else refuses, so pressing Install here writes nothing anywhere.
#
#   RAVEN_INSTALL=installer-ui/dev/fake-raven-install \
#   RAVEN_INSTALLER_UI_NO_PRIVESC=1 installer-ui/target/debug/raven-installer-ui
if [ "$1" != "--probe" ]; then
    echo "fake-raven-install: not installing anything (args: $*)" >&2
    exit 1
